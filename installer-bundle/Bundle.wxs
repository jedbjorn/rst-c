<?xml version="1.0" encoding="utf-8"?>
<!--
  RST-Setup.exe: the setup bundle (feature #13 Phase 2, spec #15; install
  scope: feature #17, spec #20 §7).

  Chain: RST for the chosen scope, then each shippable companion in
  companions/companions.json (generated into obj\gen\Companions.g.wxs by
  gen-companions.ps1: one opt-in Install<Id> variable, one theme checkbox
  and one MsiPackage per companion). After setup every product is a stock
  install: RST sits behind this bundle's Add/Remove Programs entry, and
  each companion keeps its own entry, its own upgrades, and stays
  installed when the bundle is uninstalled.

  Install scope (decision #15): the Install page's two radio buttons set
  the variable InstallScope; silent use passes it on the command line:
      RST-Setup.exe /quiet /norestart InstallScope=machine InstallGanttIt=1
    user     "Just for me (recommended)", the default. RST.msi, per user.
             Every package on this path is per user, so Burn never
             launches an elevated engine (the bundle smoke asserts it).
    machine  "Everyone on this PC". In chain order:
               1. RemoveUserRst (helper\RemoveUserRst.cs): first checks,
                  before anything is removed, that Revit is closed in this
                  session and that every per-user RST product of this user
                  (RST.msi of any version, and the retired RST-R27.msi
                  preview) can be removed; stops the setup otherwise. Then
                  removes them;
               2. RST (RST.msi): its InstallCondition is false, so Burn
                  plans to remove the bundled version; the helper already
                  did, and Burn treats an absent product as removed. If a
                  later package fails, Burn's rollback reinstalls it;
               3. RSTMachine (RST-Machine.msi), per machine: the one step
                  Burn elevates for (one UAC prompt, at the start of the
                  install). RSTFROMSETUP=1 lets it install over a leftover
                  per-user RST.addin the helper could not remove (a hand
                  copy): that is reported as "installed twice", not a failure;
               4. the ticked companions, per user, for the installing user
                  (contract C1: companions stay per user; every other user
                  adds them from the RST tray).
             1, 2 and 4 run in the bundle's unelevated process, as the
             installing user, so they see and change only that user's
             products.
  The scope is not remembered by Burn. It is found again on every run:
  when RST-Machine.msi is installed it is "machine" (the "Just for me"
  button is then disabled: going back to per user is uninstall, then
  install, never a silent switch that would also need an administrator);
  otherwise the command line's value, and "user" for anything but
  "machine".

  Scope: the bundle stays registered per user (one per-user package is
  enough, WiX's ResolveBundleInstallScope), so its own Add/Remove Programs
  entry is the installing user's. RST-Machine.msi is Visible: it keeps its
  own "RST (all users)" entry, which every administrator of the PC sees.
  Burn does not ref-count a per-machine package from a per-user bundle
  (warning WIX1140, suppressed in RST.Setup.wixproj): uninstalling this
  bundle removes RST-Machine.msi too.

  UpgradeCode is this bundle's stable identity. NEVER change it once
  shipped: it is how a newer RST-Setup.exe recognizes and replaces an
  installed older one. It must stay a literal GUID (the companion registry
  test reads it to keep companions from reusing it). Recorded in
  installer-bundle/README.md.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="RST"
          Manufacturer="Designs/OS"
          Version="$(var.RstBundleVersion)"
          UpgradeCode="2BE2BE5D-9203-4344-A70D-E735D3B041A3"
          IconSourceFile="..\installer\branding\rst.ico"
          AboutUrl="https://github.com/jedbjorn/rst-c"
          HelpUrl="https://github.com/jedbjorn/rst-c/tree/main/docs"
          UpdateUrl="https://github.com/jedbjorn/rst-c/releases/latest"
          Compressed="yes"
          bal:CommandLineVariables="caseInsensitive">

    <!-- The standard BA with the RTF license page (the same License.rtf as
         RST.msi). ThemeFile is generated from theme\RstTheme.xml: it adds
         the scope radio buttons and the companion checkboxes to the Install
         page and the "companions stay installed" note to the finish page.
         The logo is the RST mark (the same 48x48 image embedded in
         installer\branding\rst.ico). SuppressOptionsUI: there is no install
         folder to choose; every package decides its own paths. -->
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="rtfLicense"
          LicenseFile="..\installer\branding\License.rtf"
          ThemeFile="$(var.RstThemeXml)"
          LocalizationFile="theme\RstTheme.wxl"
          LogoFile="..\src\RST.Engine\Assets\branding.png"
          SuppressOptionsUI="yes"
          ShowVersion="yes" />
    </BootstrapperApplication>

    <!-- InstallScope: "user" or "machine" once the searches below have run.
         No Value, so a command-line InstallScope=... is the only input
         besides the radio buttons. -->
    <Variable Name="InstallScope" bal:Overridable="yes" />
    <!-- RST-Machine.msi's UpgradeCode (installer/Product.wxs). 5 =
         INSTALLSTATE_DEFAULT: installed; 2 (absent) otherwise. -->
    <util:ProductSearch Id="RstMachineSearch" UpgradeCode="79C25959-C28A-4ED8-8984-85ED525476C3"
                        Result="state" Variable="RstMachineState" />
    <SetVariable Id="ScopeMachine" Variable="InstallScope" Value="machine" After="RstMachineSearch"
                 Condition="RstMachineState = 5 OR InstallScope ~= &quot;machine&quot;" />
    <SetVariable Id="ScopeUser" Variable="InstallScope" Value="user" After="ScopeMachine"
                 Condition="NOT (InstallScope = &quot;machine&quot;)" />

    <Chain>
      <!-- Machine path only, and first: checks Revit is closed and that the
           user's own RST (RST.msi of any version, the retired RST-R27.msi
           preview) can be removed, then removes it (helper\RemoveUserRst.cs).
           Unelevated, as that user. Every check comes before any removal:
           a stop leaves the user's RST as it was (review B2). Permanent with
           no detection: it runs on every machine-path install and is never
           uninstalled; with nothing to remove it exits 0. Vital: RST-Machine
           is not installed after a stop. Arguments: its log, and the UI
           level (4 = full UI: it may ask "Close Revit, then Retry").
           Exit 32 = Revit is running; 1612 = a product cannot be removed;
           1602 = cancelled at the Revit prompt. -->
      <ExePackage Id="RemoveUserRst" Name="RST.RemoveUserRst.exe" SourceFile="$(var.RemoveUserRstExe)"
                  PerMachine="no" Permanent="yes" Vital="yes" Cache="remove" DetectCondition=""
                  InstallArguments="&quot;[WixBundleLog_RemoveUserRst]&quot; [WixBundleUILevel]"
                  InstallCondition="InstallScope = &quot;machine&quot;">
        <ExitCode Value="0" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <!-- rst-c for one user (the default scope). Vital (the default): if it
           fails, the bundle fails and rolls back. Not Visible (the default):
           Burn hides its own Add/Remove Programs entry behind the bundle's,
           so Settings > Apps shows one "RST". RST.msi's launch condition
           still applies: a first install fails when no Revit 2025/2026/2027
           is found. On the machine path its condition is false: Burn plans
           to remove it if it is installed at this version (the helper above
           already has; Burn logs the absent product and goes on), and a
           later failure rolls it back in. -->
      <MsiPackage Id="RST" SourceFile="$(var.RstMsi)"
                  InstallCondition="NOT (InstallScope = &quot;machine&quot;)" />

      <!-- rst-c for everyone on this PC (RST-Machine.msi). Visible: it keeps
           its own "RST (all users)" entry in Settings > Apps. RSTFROMSETUP=1
           (review B2): its "already installed just for you" launch condition
           is for a bare RST-Machine.msi only. Through setup the user's
           installed copies are gone by now, and a leftover per-user
           RST.addin (a hand copy, which no installer can remove) is the
           shadow the engine logs and the tray reports, not a failure after
           the user's copy was removed. -->
      <MsiPackage Id="RSTMachine" SourceFile="$(var.RstMachineMsi)" Visible="yes"
                  InstallCondition="InstallScope = &quot;machine&quot;">
        <MsiProperty Name="RSTFROMSETUP" Value="1" />
      </MsiPackage>

      <!-- Companions: Permanent, Visible, Vital="no", InstallCondition
           bound to the checkbox. Generated from the registry. -->
      <PackageGroupRef Id="RstCompanions" />
    </Chain>

  </Bundle>

</Wix>
