<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RST.RuntimeTests — production-path contract tests that must run on a
    real Windows runtime: they drive the WPF windows (RST.UI) and
    IconAssets (RST.Engine, WPF) directly, which a Linux test host cannot
    load. Spec #9's icon-pack/resolver verification gates live here;
    everything that can run platform-agnostic stays in RST.Tests (Core).

    TFM tracks the same $(RevitTargetFramework) grid as UI/Engine — always
    build/test with an R-suffixed configuration (e.g. -c "Release R25");
    plain Debug/Release leaves RevitTargetFramework empty and fails, the
    same rule the UI/Engine projects already follow.
  -->

  <PropertyGroup>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
    <RootNamespace>RST.RuntimeTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Configurations>Debug R25;Debug R26;Debug R27;Release R25;Release R26;Release R27</Configurations>
    <!-- Allow Linux CI stage jobs to build (not run) the windows TFM. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Spec #16 screenshot pipeline: the tests build and render WPF windows off-screen
         (Support/Screenshots, Support/WindowCapture) to TestResults/screenshots/*.png,
         or $RST_SCREENSHOTS; CI uploads them as the RST-screenshots artifact. -->
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loader (spec #16, WU3): the Core tests' Loader fakes and the v2.2.0 bridge reference (AC6),
         shared as source so the view-model tests drive the same seams and compare the same writes. -->
    <Compile Include="..\RST.Tests\Loader\LoaderFakes.cs" Link="Loader\Shared\LoaderFakes.cs" />
    <Compile Include="..\RST.Tests\Loader\V220BridgeReference.cs" Link="Loader\Shared\V220BridgeReference.cs" />
    <!-- Builder (spec #16, WU4): the v2.2.0 save reference (AC6), shared the same way. -->
    <Compile Include="..\RST.Tests\Builder\V220BuilderReference.cs" Link="Builder\Shared\V220BuilderReference.cs" />
  </ItemGroup>

  <!--
    Spec #17, T-A7: the ribbon mapping tests (Ribbon/RibbonItemFactoryTests) build real AdWindows
    items outside Revit. The Nice3point package ships the original AdWindows.dll under ref/ only, so
    NuGet compiles against it but copies nothing; the copy below puts it next to the tests. Versions
    match RST.Engine's per Revit major. RST.Engine itself is unchanged (PrivateAssets=all, not shipped).
  -->
  <ItemGroup Condition="'$(RevitVersion)' == '2025'">
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="2025.0.2" VersionOverride="2025.0.2" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2026'">
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="2026.0.4" VersionOverride="2026.0.4" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' == '2027'">
    <PackageReference Include="Nice3point.Revit.Api.AdWindows" Version="2027.0.0" VersionOverride="2027.0.0" PrivateAssets="all" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup Condition="'$(PkgNice3point_Revit_Api_AdWindows)' != ''">
    <None Include="$(PkgNice3point_Revit_Api_AdWindows)\ref\*\AdWindows.dll" Link="AdWindows.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RST.Core\RST.Core.csproj" />
    <ProjectReference Include="..\RST.UI\RST.UI.csproj" />
    <ProjectReference Include="..\RST.Engine\RST.Engine.csproj" />
    <!-- Bootstrap: the assembly resolver's branches (decision #27). The tests touch only
         EngineDependencyResolver, never the Revit-typed RstBootstrap. -->
    <ProjectReference Include="..\RST.Bootstrap\RST.Bootstrap.csproj" />
  </ItemGroup>

  <!-- The RST tray (feature #17, spec #20 §1; F17 WU1): RST.Tray is built once, on net8.0-windows with the
       R25 configuration (src/RST.Tray/RST.Tray.csproj), so its tests (Tray/) build and run on the R25 leg
       only, the leg that uploads the RST-screenshots artifact. -->
  <ItemGroup Condition="'$(RevitVersion)' == '2025'">
    <ProjectReference Include="..\RST.Tray\RST.Tray.csproj" />
    <!-- F17 WU3: the Core tests' clock, counting handler and fake Windows Installer, shared as source. -->
    <Compile Include="..\RST.Tests\Updates\UpdateTestDoubles.cs" Link="Tray\Shared\UpdateTestDoubles.cs" />
    <!-- F17 WU4: the fake GitHub (feed, SHA256SUMS.txt, API digest, redirects) and the scripted installers. -->
    <Compile Include="..\RST.Tests\Updates\InstallTestDoubles.cs" Link="Tray\Shared\InstallTestDoubles.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(RevitVersion)' != '2025'">
    <Compile Remove="Tray\**" />
  </ItemGroup>

</Project>
