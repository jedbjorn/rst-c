<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RST.Bootstrap — tiny IExternalApplication thunk.

    Sole purpose: live in the Revit Add-Ins directory next to the
    .addin manifest, install an AssemblyDependencyResolver pointed at
    %AppData%\RST\app\RST.Engine.dll, then forward IExternalApplication
    calls to the engine. Keeps the addins dir lean (one .addin + one
    DLL) so user-data and install bundle can be pruned/upgraded
    independently — see RST-033.

    Dependencies are deliberately minimal: only the Revit API package
    pair (RevitAPI + RevitAPIUI), no Serilog/WebView2/AdWindows. Boot
    logging is plain-text File.AppendAllText so the bootstrap can
    diagnose itself before Serilog is even on disk.

    TFM tracks $(RevitTargetFramework) so each Revit major builds its
    matching CLR. Same conditional pattern as RST.Engine.
  -->

  <PropertyGroup>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
    <RootNamespace>RST.Bootstrap</RootNamespace>
    <AssemblyName>RST.Bootstrap</AssemblyName>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <OutputType>Library</OutputType>
    <!-- DO NOT copy transitives — bootstrap must stay tiny. The engine
         carries its own dep tree, resolved via AssemblyDependencyResolver
         at runtime. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Revit 2025 -->
  <ItemGroup Condition="'$(RevitVersion)' == '2025'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI"   Version="2025.4.41" PrivateAssets="all" VersionOverride="2025.4.41" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.4.41" PrivateAssets="all" VersionOverride="2025.4.41" />
  </ItemGroup>

  <!-- Revit 2026 -->
  <ItemGroup Condition="'$(RevitVersion)' == '2026'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI"   Version="2026.4.0" PrivateAssets="all" VersionOverride="2026.4.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.4.0" PrivateAssets="all" VersionOverride="2026.4.0" />
  </ItemGroup>

  <!-- Revit 2027 -->
  <ItemGroup Condition="'$(RevitVersion)' == '2027'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI"   Version="2027.0.10" PrivateAssets="all" VersionOverride="2027.0.10" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.0.10" PrivateAssets="all" VersionOverride="2027.0.10" />
  </ItemGroup>

  <Import Project="..\..\build\sign.targets" />

</Project>
