<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RST.Engine — Revit-bound logic.

    TargetFramework selected from $(RevitVersion) (set by Configuration in
    Directory.Build.props): 2025/2026 → net8.0-windows, 2027 → net10.0-windows.

    Revit API package versions are pinned per Revit major below, OUTSIDE
    central package management — CPM (NU1011) refuses floating versions.
  -->

  <PropertyGroup>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RST.Engine</RootNamespace>
    <AssemblyName>RST.Engine</AssemblyName>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- RST-004: Engine ships the RST.Core + RST.UI assemblies into the
         app folder. Revit doesn't resolve transitive packages from a
         shared cache, so they must travel with the install. Decision #33:
         no third-party DLL travels with them (build/check-shipped-dlls.sh). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <OutputType>Library</OutputType>
    <!-- Allow Linux + macOS to build the Windows-targeted TFM (net8.0-windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Revit 2025 -->
  <ItemGroup Condition="'$(RevitVersion)' == '2025'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI"   Version="2025.0.2" PrivateAssets="all" VersionOverride="2025.0.2" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.0.2" PrivateAssets="all" VersionOverride="2025.0.2" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows"  Version="2025.0.2" PrivateAssets="all" VersionOverride="2025.0.2" />
  </ItemGroup>

  <!-- Revit 2026 -->
  <ItemGroup Condition="'$(RevitVersion)' == '2026'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI"   Version="2026.0.4" PrivateAssets="all" VersionOverride="2026.0.4" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.0.4" PrivateAssets="all" VersionOverride="2026.0.4" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows"  Version="2026.0.4" PrivateAssets="all" VersionOverride="2026.0.4" />
  </ItemGroup>

  <!-- Revit 2027 -->
  <ItemGroup Condition="'$(RevitVersion)' == '2027'">
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI"   Version="2027.0.0" PrivateAssets="all" VersionOverride="2027.0.0" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.0.0" PrivateAssets="all" VersionOverride="2027.0.0" />
    <PackageReference Include="Nice3point.Revit.Api.AdWindows"  Version="2027.0.0" PrivateAssets="all" VersionOverride="2027.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RST.Core\RST.Core.csproj" />
    <ProjectReference Include="..\RST.UI\RST.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RuntimeTests invokes the internal IconAssets resolver directly
         (spec #9 production-path resolver gate). -->
    <InternalsVisibleTo Include="RST.RuntimeTests" />
  </ItemGroup>

  <!--
    Bundled default branding — vendored from the pyRevit-era RST tab.
    BrandingDefaults.EnsureSeeded copies this to %AppData%\RST\branding.png
    on first launch when no per-machine logo exists yet.
  -->
  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Import Project="..\..\build\sign.targets" />

</Project>
