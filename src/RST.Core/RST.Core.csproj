<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RST.Core — pure-managed library, no Revit dependencies.
    Hosts the JSON profile model, validators, schema migrations, the
    in-memory command/addin catalog, and the profile↔ribbon mapping
    that does NOT touch Autodesk.* types.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RST.Core</RootNamespace>
    <AssemblyName>RST.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- No package references (decision #33): System.Text.Json comes with the shared framework
       (net8.0 and up), and logging is RST.Core.Logging, so RST ships no third-party DLL into
       Revit's load context. build/check-shipped-dlls.sh enforces it on the staged folders. -->

  <ItemGroup>
    <!-- The RST tray's product catalog (feature #17, spec #20 §6; Updates/ProductCatalog.cs): the companion
         registry is embedded at build time, and only its identity fields are read at runtime. -->
    <EmbeddedResource Include="..\..\companions\companions.json" LogicalName="RST.Core.Updates.companions.json"
                      Link="Updates\companions.json" />
  </ItemGroup>

  <!-- The Ribbon Tool Census exceptions (feature #22, spec #34; Census/CensusIndex.cs): each Revit year's
       census/<year>/exceptions.tsv is gzipped at build time from the repo file itself (no second copy is committed,
       decision #97) and embedded as RST.Core.Census.<year>.exceptions.tsv.gz. A new year directory is picked up by
       the wildcard. -->
  <UsingTask TaskName="RstGzipFiles" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <OutputDir ParameterType="System.String" Required="true" />
      <Outputs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        Directory.CreateDirectory(OutputDir);
        var list = new System.Collections.Generic.List<Microsoft.Build.Framework.ITaskItem>();
        foreach (var src in Sources)
        {
          var full = src.GetMetadata("FullPath");
          var year = Path.GetFileName(Path.GetDirectoryName(full));
          var dst = Path.Combine(OutputDir, year + ".exceptions.tsv.gz");
          using (var input = File.OpenRead(full))
          using (var output = File.Create(dst))
          using (var gz = new GZipStream(output, CompressionLevel.Optimal))
            input.CopyTo(gz);
          var item = new Microsoft.Build.Utilities.TaskItem(dst);
          item.SetMetadata("LogicalName", "RST.Core.Census." + year + ".exceptions.tsv.gz");
          list.Add(item);
        }
        Outputs = list.ToArray();
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="RstEmbedCensusExceptions" BeforeTargets="PrepareResources;AssignTargetPaths">
    <ItemGroup>
      <_RstCensusTsv Include="..\..\census\*\exceptions.tsv" />
    </ItemGroup>
    <RstGzipFiles Sources="@(_RstCensusTsv)" OutputDir="$(IntermediateOutputPath)census" Condition="'@(_RstCensusTsv)' != ''">
      <Output TaskParameter="Outputs" ItemName="_RstCensusGz" />
    </RstGzipFiles>
    <ItemGroup>
      <EmbeddedResource Include="@(_RstCensusGz)" />
      <FileWrites Include="@(_RstCensusGz)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- Tests use internal seams (for example PackageContents.Series). -->
    <InternalsVisibleTo Include="RST.Tests" />
    <!-- The Windows-only handle delete of the activity cleanup (Telemetry/Rollups/OutboxFileTaker). -->
    <InternalsVisibleTo Include="RST.RuntimeTests" />
  </ItemGroup>

</Project>
