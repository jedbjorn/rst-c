<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RST.Core — pure-managed library, no Revit dependencies.
    Hosts the JSON profile model, validators, schema migrations, the
    in-memory command/addin catalog, and the profile↔ribbon mapping
    that does NOT touch Autodesk.* types.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>RST.Core</RootNamespace>
    <AssemblyName>RST.Core</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The RST tray's product catalog (feature #17, spec #20 §6; Updates/ProductCatalog.cs): the companion
         registry is embedded at build time, and only its identity fields are read at runtime. -->
    <EmbeddedResource Include="..\..\companions\companions.json" LogicalName="RST.Core.Updates.companions.json"
                      Link="Updates\companions.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests use internal seams (for example PackageContents.Series). -->
    <InternalsVisibleTo Include="RST.Tests" />
  </ItemGroup>

</Project>
