<!--
    rst-c's own (not vendored). The tray's Health → Models sub-tab (spec #25 Models). A placeholder until spec #25
    WU3 builds the list here (search, chips, groups, aggregate cards, model cards): WU3 replaces this view's content,
    keeping the class and its place in HealthPageView. The view-model is ModelsViewModel.
-->
<UserControl x:Class="RST.Tray.Windows.ModelsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RST.Tray.Resources"
             AutomationProperties.AutomationId="Tray.Health.Models">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,16,22,12" Focusable="False">
        <StackPanel MaxWidth="640">
            <TextBlock Text="{x:Static res:TrayStrings.Health_ModelsHeading}" Style="{StaticResource HeadingText}" />
            <Border Style="{StaticResource Panel}" Padding="16,14" Margin="0,10,0,0"
                    AutomationProperties.AutomationId="Tray.Health.ModelsPlaceholder">
                <TextBlock Text="{x:Static res:TrayStrings.Health_ModelsPlaceholder}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
