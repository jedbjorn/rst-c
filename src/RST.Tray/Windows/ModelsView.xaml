<!--
    rst-c's own (not vendored). The tray's Health → Models sub-tab (spec #25 Models, Look and Feel; F19 #25 WU3), in the
    house styles: the search box (the Builder's placeholder pattern), the time chips and Group by as RangePills, the Revit
    version filter as a menu toggle (the Builder's MenuToggle look; a ContextMenu with a tick per version), the aggregate
    cards as the Activity tab's stat cards (Health/HealthResources.xaml), groups in SectionExpander's look (its header
    style, the bordered surface box), the health dot as Health's SeverityDot with its colour name beside it, and the
    model cards in the card look (CardListBoxItem's border, hover and focus ring).

    The list is ONE virtualizing column (recycling, pixel scrolling) of rows: the aggregate cards; per group a header
    row and one model card per row, so 500 models realize only the rows on screen. Cards are at most 700 DIPs wide
    and shrink to the available width when the window is resized. A group's box is drawn by
    its rows: the header the top (the whole box when closed), each card row the sides, the last the bottom.
    The view-model is ModelsViewModel.
-->
<UserControl x:Class="RST.Tray.Windows.ModelsView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RST.Tray.Resources"
             xmlns:local="clr-namespace:RST.Tray.Windows"
             AutomationProperties.AutomationId="Tray.Health.Models">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
                <ResourceDictionary Source="/RST.UI;component/Health/HealthResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A text box's placeholder: shown while the box (its Tag binding) is empty (the Builder's Hint). -->
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Margin" Value="7,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FilterLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,8,0" />
            </Style>

            <!--
                The Revit version filter's button: the Builder's MenuToggle (the kit's Button look, checked while its
                menu is open and not hit-testable then, so the click that dismisses the menu cannot reopen it).
            -->
            <Style x:Key="MenuToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="ContextMenuService.IsEnabled" Value="False" />
                <Setter Property="IsHitTestVisible"
                        Value="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}, Converter={StaticResource InverseBool}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome" CornerRadius="3" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A model card: CardListBoxItem's look on a Button (click, Enter or Space opens the detail). -->
            <Style x:Key="ModelCard" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MaxWidth" Value="700" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" CornerRadius="4" BorderThickness="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- One card: the thumbnail (or the placeholder), the title and file name, the health dot and its colour's
                 name, the marker, the version and last active day, the active time in the window. -->
            <DataTemplate x:Key="ModelCardTemplate" DataType="{x:Type local:ModelCardItem}">
                <Button Style="{StaticResource ModelCard}" Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=local:ModelsView}}"
                        CommandParameter="{Binding}" ToolTip="{Binding Tip}"
                        Loaded="OnCardLoaded" Unloaded="OnCardUnloaded" DataContextChanged="OnCardDataContextChanged"
                        AutomationProperties.AutomationId="Tray.Health.Models.Card"
                        AutomationProperties.Name="{Binding AutomationName}"
                        AutomationProperties.HelpText="{x:Static res:TrayStrings.Models_CardHelp}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="72" Height="72" CornerRadius="3" Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" VerticalAlignment="Top"
                                ClipToBounds="True" AutomationProperties.AutomationId="Tray.Health.Models.Thumbnail">
                            <Grid>
                                <TextBlock x:Name="Placeholder" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                           Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           AutomationProperties.Name="{x:Static res:TrayStrings.Models_NoPreview}"
                                           AutomationProperties.AutomationId="Tray.Health.Models.ThumbnailPlaceholder" />
                                <Image x:Name="Picture" Source="{Binding Thumbnail}" Stretch="Uniform" Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.AutomationId="Tray.Health.Models.ThumbnailImage" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="Tray.Health.Models.CardTitle" />
                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                       Visibility="{Binding ShowFileName, Converter={StaticResource BoolToVisible}}"
                                       AutomationProperties.AutomationId="Tray.Health.Models.CardFileName" />
                            <DockPanel Margin="0,5,0,0">
                                <ContentControl DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="{Binding Marker}" Margin="8,0,0,0"
                                                VerticalAlignment="Center" Focusable="False"
                                                Visibility="{Binding HasMarker, Converter={StaticResource BoolToVisible}}"
                                                AutomationProperties.AutomationId="Tray.Health.Models.CardMarker" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{x:Static res:TrayStrings.Models_HealthTip}">
                                    <Ellipse Style="{StaticResource SeverityDot}" Margin="0,0,6,0" AutomationProperties.AutomationId="Tray.Health.Models.CardHealthDot" />
                                    <TextBlock Text="{Binding HealthName}" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="Tray.Health.Models.CardHealth" />
                                </StackPanel>
                            </DockPanel>
                            <TextBlock Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"
                                       AutomationProperties.AutomationId="Tray.Health.Models.CardVersion">
                                <Run Text="{Binding Version, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding LastActive, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Active}" FontSize="11" Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="Tray.Health.Models.CardActive" />
                        </StackPanel>
                    </Grid>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasThumbnail}" Value="True">
                        <Setter TargetName="Picture" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- The aggregate cards over the visible cards (the Activity tab's stat card). -->
            <DataTemplate DataType="{x:Type local:ModelsAggregatesRow}">
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource StatCardTemplate}" Margin="-4,0,-4,12"
                              Focusable="False" AutomationProperties.AutomationId="Tray.Health.Models.Aggregates">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DataTemplate>

            <!-- A group's header: SectionExpander's header (the chevron turns down when open) on the top of the group's box. -->
            <DataTemplate DataType="{x:Type local:ModelsGroupHeaderRow}">
                <Border x:Name="Box" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,1,1,0" CornerRadius="4,4,0,0" SnapsToDevicePixels="True">
                    <DockPanel>
                        <Border x:Name="Divider" DockPanel.Dock="Bottom" Height="1" Background="{StaticResource DividerBrush}" />
                        <ToggleButton Style="{StaticResource SectionExpanderHeader}" IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                      AutomationProperties.AutomationId="Tray.Health.Models.Group"
                                      AutomationProperties.Name="{Binding AutomationName}">
                            <WrapPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0"
                                           AutomationProperties.AutomationId="Tray.Health.Models.GroupTitle" />
                                <TextBlock Text="{Binding Count}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"
                                           AutomationProperties.AutomationId="Tray.Health.Models.GroupCount" />
                                <TextBlock Text="{Binding Active}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="Tray.Health.Models.GroupActive" />
                            </WrapPanel>
                        </ToggleButton>
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsClosedBox}" Value="True">
                        <Setter TargetName="Box" Property="BorderThickness" Value="1" />
                        <Setter TargetName="Box" Property="CornerRadius" Value="4" />
                        <Setter TargetName="Box" Property="Margin" Value="0,0,0,8" />
                        <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A row of cards: in a group, the sides of its box (the last row its bottom); flat, the bare cards. -->
            <DataTemplate DataType="{x:Type local:ModelsCardRow}">
                <Border x:Name="Box" Margin="-4,0" SnapsToDevicePixels="True">
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource ModelCardTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding InGroup}" Value="True">
                        <Setter TargetName="Box" Property="Margin" Value="0" />
                        <Setter TargetName="Box" Property="Padding" Value="10,4,10,0" />
                        <Setter TargetName="Box" Property="Background" Value="{StaticResource SurfaceBrush}" />
                        <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter TargetName="Box" Property="BorderThickness" Value="1,0,1,0" />
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding InGroup}" Value="True" />
                            <Condition Binding="{Binding IsLastInGroup}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="Box" Property="BorderThickness" Value="1,0,1,1" />
                        <Setter TargetName="Box" Property="CornerRadius" Value="0,0,4,4" />
                        <Setter TargetName="Box" Property="Padding" Value="10,4,10,10" />
                        <Setter TargetName="Box" Property="Margin" Value="0,0,0,8" />
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The search box, then the filter row: time chips, Revit version, Group by, and "Searching all time". -->
        <StackPanel Margin="22,14,22,10">
            <Grid>
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4,26,4"
                         AutomationProperties.AutomationId="Tray.Health.Models.Search"
                         AutomationProperties.Name="{x:Static res:TrayStrings.Models_SearchPlaceholder}" />
                <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:TrayStrings.Models_SearchPlaceholder}" Margin="9,0,0,0"
                           Tag="{Binding Text, ElementName=SearchBox}" />
                <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,3,0" Padding="4,2"
                        Command="{Binding ClearSearchCommand}" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisible}}"
                        ToolTip="{x:Static res:TrayStrings.Models_ClearSearch}" IsTabStop="False"
                        AutomationProperties.AutomationId="Tray.Health.Models.ClearSearch"
                        AutomationProperties.Name="{x:Static res:TrayStrings.Models_ClearSearch}">
                    <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="10" />
                </Button>
            </Grid>
            <WrapPanel Margin="0,10,0,0">
                <Border Style="{StaticResource RangePillGroup}" Margin="0,0,14,6" IsEnabled="{Binding FiltersEnabled}">
                    <ItemsControl ItemsSource="{Binding Chips}" Focusable="False" AutomationProperties.AutomationId="Tray.Health.Models.Chips"
                                  AutomationProperties.Name="{x:Static res:TrayStrings.Models_TimeFrame}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource RangePill}" GroupName="ModelsChip" Content="{Binding Label}" Padding="12,3"
                                             IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{Binding Tip}"
                                             AutomationProperties.AutomationId="{Binding AutomationId}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <ToggleButton x:Name="VersionButton" Style="{StaticResource MenuToggle}" Margin="0,0,14,6" IsEnabled="{Binding FiltersEnabled}"
                              Checked="OnVersionButtonChecked" ToolTip="{x:Static res:TrayStrings.Models_VersionTip}"
                              AutomationProperties.AutomationId="Tray.Health.Models.Versions"
                              AutomationProperties.Name="{x:Static res:TrayStrings.Models_VersionLabel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding VersionSummary}" VerticalAlignment="Center" />
                        <Path Data="M 0,0 L 4,4 L 8,0" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5" Margin="8,1,0,0"
                              VerticalAlignment="Center" />
                    </StackPanel>
                    <ToggleButton.ContextMenu>
                        <ContextMenu x:Name="VersionMenu" Closed="OnVersionMenuClosed" ItemsSource="{Binding Versions}"
                                     AutomationProperties.AutomationId="Tray.Health.Models.VersionMenu">
                            <ContextMenu.ItemContainerStyle>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="IsCheckable" Value="True" />
                                    <Setter Property="StaysOpenOnClick" Value="True" />
                                    <Setter Property="IsChecked" Value="{Binding IsChecked, Mode=TwoWay}" />
                                    <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    <Setter Property="Header" Value="{Binding}" />
                                    <!-- The kit's MenuItem draws no tick: the header carries it. -->
                                    <Setter Property="HeaderTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Width="18">
                                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="11"
                                                                   Foreground="{StaticResource AccentForegroundBrush}" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsChecked, Converter={StaticResource BoolToVisible}}" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ContextMenu.ItemContainerStyle>
                        </ContextMenu>
                    </ToggleButton.ContextMenu>
                </ToggleButton>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                    <TextBlock Text="{x:Static res:TrayStrings.Models_GroupByLabel}" Style="{StaticResource FilterLabel}" />
                    <Border Style="{StaticResource RangePillGroup}">
                        <ItemsControl ItemsSource="{Binding GroupByOptions}" Focusable="False" AutomationProperties.AutomationId="Tray.Health.Models.GroupBy"
                                      AutomationProperties.Name="{x:Static res:TrayStrings.Models_GroupByLabel}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton Style="{StaticResource RangePill}" GroupName="ModelsGroupBy" Content="{Binding Label}" Padding="12,3"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="{Binding AutomationId}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
                <TextBlock Text="{x:Static res:TrayStrings.Models_SearchingAllTime}" Foreground="{StaticResource AccentForegroundBrush}"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,6"
                           Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisible}}"
                           AutomationProperties.AutomationId="Tray.Health.Models.SearchingAllTime" />
            </WrapPanel>
        </StackPanel>

        <!-- The first read of the index. -->
        <StackPanel Grid.Row="1" Margin="22,0,22,8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}"
                    AutomationProperties.AutomationId="Tray.Health.Models.Loading">
            <ProgressBar Style="{StaticResource BusyIndicator}" />
            <TextBlock Text="{x:Static res:TrayStrings.Models_Loading}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
        </StackPanel>

        <!-- The rows, virtualized. -->
        <ItemsControl x:Name="List" Grid.Row="2" ItemsSource="{Binding Rows}" Focusable="False"
                      Visibility="{Binding HasCards, Converter={StaticResource BoolToVisible}}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLength="1" VirtualizingPanel.CacheLengthUnit="Page"
                      ScrollViewer.CanContentScroll="True" KeyboardNavigation.TabNavigation="Continue"
                      AutomationProperties.AutomationId="Tray.Health.Models.List">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer x:Name="Scroller" Padding="22,0,22,12" Focusable="False" CanContentScroll="True"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <!-- The empty states, in place of the list. -->
        <StackPanel x:Name="Empty" Grid.Row="2" Margin="22,36,22,12" MaxWidth="440" HorizontalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}"
                    AutomationProperties.AutomationId="Tray.Health.Models.Empty">
            <TextBlock Text="{Binding EmptyText}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center"
                       TextWrapping="Wrap" AutomationProperties.AutomationId="Tray.Health.Models.EmptyText" />
            <TextBlock HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="{Binding ShowOneYearLink, Converter={StaticResource BoolToVisible}}">
                <Hyperlink Style="{StaticResource LoaderLink}" Command="{Binding SwitchToOneYearCommand}"
                           AutomationProperties.AutomationId="Tray.Health.Models.SwitchToOneYear">
                    <Run Text="{x:Static res:TrayStrings.Models_SwitchToOneYear}" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
