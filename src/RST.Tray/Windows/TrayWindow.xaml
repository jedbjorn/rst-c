<!--
    rst-c's own (not vendored). The RST tray's one window (spec #20 §1; F17 WU1), on RST.UI's family kit
    (Theme.xaml, the Health window's header-tabs layout): Updates, Apps, Add-ins, Health and Settings / About. Updates and
    Apps are F17 WU3's (UpdatesViewModel), with WU4's installs; Add-ins is F17 WU2's (AddInsView, AddInsViewModel);
    Health is spec #25's (HealthPageView, TrayHealthViewModel).
    The view-model is TrayViewModel.
-->
<Window x:Class="RST.Tray.Windows.TrayWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.Tray.Resources"
        xmlns:local="clr-namespace:RST.Tray.Windows"
        Title="{x:Static res:TrayStrings.Window_Title}"
        Width="720" Height="540" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" ShowInTaskbar="True"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="Tray.Window">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PageDescription" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,6,0,14" />
            </Style>
            <Style x:Key="Hint" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,6,0,0" />
            </Style>
            <Style x:Key="Page" TargetType="ScrollViewer">
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Padding" Value="22,18,22,12" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <!-- A product's state as a pill (F17 WU3): Up to date (success), Update available (warning), Installed
                 manually (info), Not installed / Installed (neutral). The data is a ProductRowViewModel. -->
            <DataTemplate x:Key="StatePill">
                <Grid>
                    <ContentControl Style="{StaticResource SuccessPill}" Content="{Binding StateText}"
                                    Visibility="{Binding IsUpToDate, Converter={StaticResource BoolToVisible}}" />
                    <ContentControl Style="{StaticResource WarningPill}" Content="{Binding StateText}"
                                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisible}}" />
                    <ContentControl Style="{StaticResource InfoPill}" Content="{Binding StateText}"
                                    Visibility="{Binding IsManual, Converter={StaticResource BoolToVisible}}" />
                    <ContentControl Style="{StaticResource Pill}" Content="{Binding StateText}"
                                    Visibility="{Binding IsNeutral, Converter={StaticResource BoolToVisible}}" />
                </Grid>
            </DataTemplate>

            <!-- Installed and Latest, one per line (the Updates page's RST panel). -->
            <DataTemplate x:Key="InstalledAndLatest">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static res:TrayStrings.App_InstalledLabel}" Style="{StaticResource MutedText}" Margin="0,0,12,2" />
                    <TextBlock Grid.Column="1" Text="{Binding InstalledText}" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="1" Text="{x:Static res:TrayStrings.App_LatestLabel}" Style="{StaticResource MutedText}" Margin="0,0,12,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LatestText}" />
                </Grid>
            </DataTemplate>

            <!-- Installed and Latest on one line (Apps rows, the Updates page's companion lines). The Installed part
                 shows only for a Windows Installer install: Not installed and Installed manually are the pill's. -->
            <DataTemplate x:Key="InstalledAndLatestInline">
                <WrapPanel>
                    <TextBlock Margin="0,0,14,0" Visibility="{Binding ShowInstalledVersion, Converter={StaticResource BoolToVisible}}">
                        <Run Text="{x:Static res:TrayStrings.App_InstalledLabel}" Foreground="{StaticResource MutedTextBrush}" />
                        <Run Text="{Binding InstalledText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock>
                        <Run Text="{x:Static res:TrayStrings.App_LatestLabel}" Foreground="{StaticResource MutedTextBrush}" />
                        <Run Text="{Binding LatestText, Mode=OneWay}" />
                    </TextBlock>
                </WrapPanel>
            </DataTemplate>

            <!-- A row's install note (F17 WU4): what the install is doing (info), how it ended (success or error), or
                 who can update an install for everyone on this PC (warning). Open log after msiexec ran; the
                 Release page with the per-machine note. The data is a ProductRowViewModel. -->
            <DataTemplate x:Key="RowNoteText">
                <StackPanel>
                    <TextBlock Text="{Binding NoteText}" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,3,0,0" Visibility="{Binding HasNoteLinks, Converter={StaticResource BoolToVisible}}">
                        <TextBlock Margin="0,0,14,0" Visibility="{Binding HasLog, Converter={StaticResource BoolToVisible}}">
                            <Hyperlink Style="{StaticResource LoaderLink}" Command="{Binding OpenLogCommand}" CommandParameter="{Binding}"
                                       AutomationProperties.AutomationId="{Binding Id, StringFormat=Tray.App.{0}.OpenLog}">
                                <Run Text="{x:Static res:TrayStrings.App_OpenLog}" />
                            </Hyperlink>
                        </TextBlock>
                        <TextBlock Visibility="{Binding ShowNoteReleasePage, Converter={StaticResource BoolToVisible}}">
                            <Hyperlink Style="{StaticResource LoaderLink}" Command="{Binding ReleasePageCommand}" CommandParameter="{Binding}">
                                <Run Text="{x:Static res:TrayStrings.App_ReleasePage}" />
                            </Hyperlink>
                        </TextBlock>
                    </WrapPanel>
                </StackPanel>
            </DataTemplate>
            <DataTemplate x:Key="RowNote">
                <Grid Margin="0,8,0,0" Visibility="{Binding HasNote, Converter={StaticResource BoolToVisible}}"
                      AutomationProperties.AutomationId="{Binding Id, StringFormat=Tray.App.{0}.Note}">
                    <Border Style="{StaticResource InfoBanner}" Visibility="{Binding IsNoteProgress, Converter={StaticResource BoolToVisible}}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowNoteText}" Focusable="False" IsTabStop="False" />
                    </Border>
                    <Border Style="{StaticResource SuccessBanner}" Visibility="{Binding IsNoteSuccess, Converter={StaticResource BoolToVisible}}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowNoteText}" Focusable="False" IsTabStop="False" />
                    </Border>
                    <Border Style="{StaticResource WarningBanner}" Visibility="{Binding IsNoteWarning, Converter={StaticResource BoolToVisible}}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowNoteText}" Focusable="False" IsTabStop="False" />
                    </Border>
                    <Border Style="{StaticResource ErrorBanner}" Visibility="{Binding IsNoteError, Converter={StaticResource BoolToVisible}}">
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowNoteText}" Focusable="False" IsTabStop="False" />
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The root carries the window color itself: the screenshot tests render it unclipped by the window. -->
    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: the title and the page tabs. -->
        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="18,10,18,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static res:TrayStrings.Window_Heading}" Style="{StaticResource HeadingText}"
                           VerticalAlignment="Center" Margin="0,0,24,10" />
                <TabControl x:Name="Tabs" SelectedIndex="{Binding PageIndex, Mode=TwoWay}" Padding="0" BorderThickness="0"
                            VerticalAlignment="Bottom" AutomationProperties.AutomationId="Tray.Tabs">
                    <TabItem Header="{x:Static res:TrayStrings.Tab_Updates}" AutomationProperties.AutomationId="Tray.TabUpdates" />
                    <TabItem Header="{x:Static res:TrayStrings.Tab_Apps}" AutomationProperties.AutomationId="Tray.TabApps" />
                    <TabItem Header="{x:Static res:TrayStrings.Tab_AddIns}" AutomationProperties.AutomationId="Tray.TabAddIns" />
                    <TabItem Header="{x:Static res:TrayStrings.Tab_Health}" AutomationProperties.AutomationId="Tray.TabHealth" />
                    <TabItem Header="{x:Static res:TrayStrings.Tab_Settings}" AutomationProperties.AutomationId="Tray.TabSettings" />
                </TabControl>
            </StackPanel>
        </Border>

        <!-- Updates (F17 WU3): RST first, with Check now and the last-checked time; then Gantt-It and Splash-It. -->
        <ScrollViewer x:Name="UpdatesPage" Grid.Row="1" Style="{StaticResource Page}"
                      Visibility="{Binding IsUpdatesPage, Converter={StaticResource BoolToVisible}}">
            <StackPanel MaxWidth="640" DataContext="{Binding Updates}">
                <TextBlock Text="{x:Static res:TrayStrings.Updates_Heading}" Style="{StaticResource HeadingText}" />
                <TextBlock Text="{x:Static res:TrayStrings.Updates_Description}" Style="{StaticResource PageDescription}" />
                <TextBlock Text="{x:Static res:TrayStrings.Install_CloseRevitAdvice}" Style="{StaticResource Hint}"
                           TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.AutomationId="Tray.Updates.CloseRevitAdvice" />

                <Border Style="{StaticResource Panel}" Padding="16,14" Margin="0,0,0,10" AutomationProperties.AutomationId="Tray.RstPanel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="RstHeadline" Text="{Binding RstHeadline}" FontSize="15" FontWeight="SemiBold"
                                           VerticalAlignment="Center" AutomationProperties.AutomationId="Tray.RstHeadline" />
                                <ContentControl Content="{Binding Rst}" ContentTemplate="{StaticResource StatePill}" Margin="10,0,0,0"
                                                Focusable="False" IsTabStop="False" />
                            </StackPanel>
                            <ContentControl Content="{Binding Rst}" ContentTemplate="{StaticResource InstalledAndLatest}" Margin="0,8,0,0"
                                            Focusable="False" IsTabStop="False" />
                            <TextBlock x:Name="LastChecked" Text="{Binding LastCheckedText}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                       AutomationProperties.AutomationId="Tray.LastChecked" />
                            <ContentControl Content="{Binding Rst}" ContentTemplate="{StaticResource RowNote}" Focusable="False" IsTabStop="False"
                                            AutomationProperties.AutomationId="Tray.RstNote" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0">
                            <Button x:Name="CheckNowButton" Content="{Binding CheckNowText}" Command="{Binding CheckNowCommand}"
                                    Style="{StaticResource PrimaryButton}" MinWidth="110"
                                    AutomationProperties.AutomationId="Tray.CheckNow" />
                            <Button x:Name="RstUpdateButton" Content="{Binding Rst.ActionText}" Command="{Binding Rst.ActCommand}"
                                    CommandParameter="{Binding Rst}" IsEnabled="{Binding Rst.CanAct}" MinWidth="110" Margin="0,8,0,0"
                                    Visibility="{Binding Rst.HasAction, Converter={StaticResource BoolToVisible}}"
                                    AutomationProperties.AutomationId="Tray.RstUpdate" />
                            <Button Content="{x:Static res:TrayStrings.App_Cancel}" Command="{Binding Rst.CancelCommand}"
                                    CommandParameter="{Binding Rst}" MinWidth="110" Margin="0,8,0,0"
                                    Visibility="{Binding Rst.CanCancel, Converter={StaticResource BoolToVisible}}"
                                    AutomationProperties.AutomationId="Tray.RstCancel" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                        Visibility="{Binding ShowCheckFailed, Converter={StaticResource BoolToVisible}}"
                        AutomationProperties.AutomationId="Tray.CheckFailed">
                    <TextBlock Text="{Binding CheckFailedText}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                        Visibility="{Binding ShowChecksOff, Converter={StaticResource BoolToVisible}}"
                        AutomationProperties.AutomationId="Tray.ChecksOff">
                    <TextBlock Text="{Binding ChecksOffText}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                        Visibility="{Binding ShowRstInstallNote, Converter={StaticResource BoolToVisible}}"
                        AutomationProperties.AutomationId="Tray.RstInstallNote">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{x:Static res:TrayStrings.Updates_RstUpdateNote}" />
                        <Hyperlink Style="{StaticResource LoaderLink}" Command="{Binding Rst.ReleasePageCommand}" CommandParameter="{Binding Rst}"
                                   AutomationProperties.AutomationId="Tray.RstReleasePage">
                            <Run Text="{x:Static res:TrayStrings.App_ReleasePage}" />
                        </Hyperlink>
                    </TextBlock>
                </Border>

                <Border Style="{StaticResource Panel}" Padding="16,12" AutomationProperties.AutomationId="Tray.CompanionsPanel">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:TrayStrings.Updates_OtherApps}" Style="{StaticResource SectionText}" FontSize="13" />
                        <ItemsControl x:Name="CompanionLines" ItemsSource="{Binding Companions}" Margin="0,4,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,0" AutomationProperties.AutomationId="{Binding Id, StringFormat=Tray.Update.{0}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="96" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplate="{StaticResource InstalledAndLatestInline}"
                                                        VerticalAlignment="Center" Focusable="False" IsTabStop="False" />
                                        <ContentControl Grid.Column="2" Content="{Binding}" ContentTemplate="{StaticResource StatePill}"
                                                        Margin="12,0,0,0" Focusable="False" IsTabStop="False" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{x:Static res:TrayStrings.Updates_OtherAppsHint}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Apps (F17 WU3): RST, Gantt-It and Splash-It, one row each, with Install / Update / Reinstall and the
             install's note (F17 WU4). -->

        <ScrollViewer x:Name="AppsPage" Grid.Row="1" Style="{StaticResource Page}"
                      Visibility="{Binding IsAppsPage, Converter={StaticResource BoolToVisible}}">
            <StackPanel MaxWidth="640" DataContext="{Binding Updates}">
                <TextBlock Text="{x:Static res:TrayStrings.Apps_Heading}" Style="{StaticResource HeadingText}" />
                <TextBlock Text="{x:Static res:TrayStrings.Apps_Description}" Style="{StaticResource PageDescription}" />
                <TextBlock Text="{x:Static res:TrayStrings.Install_CloseRevitAdvice}" Style="{StaticResource Hint}"
                           TextWrapping="Wrap" Margin="0,0,0,12" AutomationProperties.AutomationId="Tray.Apps.CloseRevitAdvice" />
                <TextBlock Text="{x:Static res:TrayStrings.Apps_Detecting}" Style="{StaticResource MutedText}" Margin="0,0,0,10"
                           Visibility="{Binding IsDetecting, Converter={StaticResource BoolToVisible}}"
                           AutomationProperties.AutomationId="Tray.AppsDetecting" />
                <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,10" HorizontalAlignment="Stretch"
                        Visibility="{Binding ShowDetectionFailed, Converter={StaticResource BoolToVisible}}"
                        AutomationProperties.AutomationId="Tray.DetectionFailed">
                    <TextBlock Text="{x:Static res:TrayStrings.Apps_DetectionFailed}" TextWrapping="Wrap" />
                </Border>
                <ItemsControl x:Name="AppRows" ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.AutomationId="Tray.AppsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel}" Padding="14,10" Margin="0,0,0,8"
                                    AutomationProperties.AutomationId="{Binding Id, StringFormat=Tray.App.{0}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StatePill}" Margin="10,0,0,0"
                                                            Focusable="False" IsTabStop="False" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InstalledAndLatestInline}" Margin="0,6,0,0"
                                                        Focusable="False" IsTabStop="False" />
                                        <TextBlock Text="{x:Static res:TrayStrings.App_ManualNote}" Style="{StaticResource Hint}"
                                                   Visibility="{Binding ShowManualNote, Converter={StaticResource BoolToVisible}}" />
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RowNote}" Focusable="False" IsTabStop="False" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                                                Visibility="{Binding HasButtons, Converter={StaticResource BoolToVisible}}">
                                        <Button Content="{Binding ActionText}" Command="{Binding ActCommand}" CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanAct}" MinWidth="96"
                                                Visibility="{Binding HasAction, Converter={StaticResource BoolToVisible}}"
                                                AutomationProperties.AutomationId="{Binding Id, StringFormat=Tray.App.{0}.Action}" />
                                        <Button Content="{x:Static res:TrayStrings.App_Cancel}" Command="{Binding CancelCommand}" CommandParameter="{Binding}"
                                                MinWidth="96" Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisible}}"
                                                AutomationProperties.AutomationId="{Binding Id, StringFormat=Tray.App.{0}.Cancel}" />
                                        <TextBlock HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11"
                                                   Visibility="{Binding ShowReleasePage, Converter={StaticResource BoolToVisible}}">
                                            <Hyperlink Style="{StaticResource LoaderLink}" Command="{Binding ReleasePageCommand}" CommandParameter="{Binding}">
                                                <Run Text="{x:Static res:TrayStrings.App_ReleasePage}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource InfoBanner}" HorizontalAlignment="Stretch" Margin="0,2,0,0"
                        AutomationProperties.AutomationId="Tray.InstallsNote">
                    <TextBlock Text="{x:Static res:TrayStrings.Apps_InstallsNote}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Add-ins (F17 WU2): the active profile, Apply profile, Restore All and each Revit year (AddInsView). -->
        <ScrollViewer x:Name="AddInsPage" Grid.Row="1" Style="{StaticResource Page}"
                      Visibility="{Binding IsAddInsPage, Converter={StaticResource BoolToVisible}}">
            <local:AddInsView x:Name="AddInsView" DataContext="{Binding AddIns}" />
        </ScrollViewer>

        <!-- Health (spec #25, F19 WU2): the Device and Models sub-tabs (HealthPageView). Not in a Page scroller: each
             sub-tab scrolls itself, under the Junk modal and the overlays that cover the page. -->
        <local:HealthPageView x:Name="HealthPage" Grid.Row="1" DataContext="{Binding Health}"
                              Visibility="{Binding DataContext.IsHealthPage, ElementName=Root, Converter={StaticResource BoolToVisible}}" />

        <!-- Settings / About. -->
        <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Style="{StaticResource Page}"
                      Visibility="{Binding IsSettingsPage, Converter={StaticResource BoolToVisible}}">
            <StackPanel MaxWidth="640">
                <Border Style="{StaticResource Panel}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:TrayStrings.Settings_Appearance}" Style="{StaticResource SectionText}" FontSize="13" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{x:Static res:TrayStrings.Settings_Theme}" Style="{StaticResource LabelText}" Margin="0,0,14,0" />
                            <Border Style="{StaticResource RangePillGroup}" AutomationProperties.AutomationId="Tray.Theme">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeSystem" Style="{StaticResource RangePill}" GroupName="TrayTheme"
                                                 Content="{x:Static res:TrayStrings.Settings_ThemeSystem}" IsChecked="{Binding ThemeSystem, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="Tray.ThemeSystem" />
                                    <RadioButton x:Name="ThemeLight" Style="{StaticResource RangePill}" GroupName="TrayTheme"
                                                 Content="{x:Static res:TrayStrings.Settings_ThemeLight}" IsChecked="{Binding ThemeLight, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="Tray.ThemeLight" />
                                    <RadioButton x:Name="ThemeDark" Style="{StaticResource RangePill}" GroupName="TrayTheme"
                                                 Content="{x:Static res:TrayStrings.Settings_ThemeDark}" IsChecked="{Binding ThemeDark, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="Tray.ThemeDark" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{x:Static res:TrayStrings.Settings_ThemeHint}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Padding="16,12" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:TrayStrings.Settings_UpdatesHeading}" Style="{StaticResource SectionText}" FontSize="13" />
                        <CheckBox x:Name="CheckForUpdatesToggle" Style="{StaticResource ToggleSwitch}" Margin="0,4,0,0"
                                  Content="{x:Static res:TrayStrings.Settings_CheckForUpdates}"
                                  IsChecked="{Binding CheckForUpdates, Mode=TwoWay}" IsEnabled="{Binding CanChangeCheckForUpdates}"
                                  AutomationProperties.AutomationId="Tray.CheckForUpdates" />
                        <TextBlock Text="{x:Static res:TrayStrings.Settings_CheckForUpdatesHint}" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource WarningBanner}" Margin="0,10,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding IsCheckForUpdatesLocked, Converter={StaticResource BoolToVisible}}"
                                AutomationProperties.AutomationId="Tray.CheckForUpdatesLocked">
                            <TextBlock Text="{x:Static res:TrayStrings.Settings_CheckForUpdatesLocked}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{Binding SaveError}" Style="{StaticResource ErrorText}" Margin="0,8,0,0"
                                   Visibility="{Binding HasSaveError, Converter={StaticResource BoolToVisible}}"
                                   AutomationProperties.AutomationId="Tray.SaveError" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:TrayStrings.Settings_About}" Style="{StaticResource SectionText}" FontSize="13" />
                        <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" Margin="0,2,0,0"
                                   AutomationProperties.AutomationId="Tray.Version" />
                        <TextBlock Text="{x:Static res:TrayStrings.Settings_StartupHint}" Style="{StaticResource Hint}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static res:TrayStrings.Settings_Logs}" Style="{StaticResource LabelText}" Margin="0,0,14,0" />
                            <TextBlock Grid.Column="1" Text="{Binding LogFolder}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       ToolTip="{Binding LogFolder}" AutomationProperties.AutomationId="Tray.LogFolder" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Hyperlink Style="{StaticResource LoaderLink}" Command="{Binding OpenLogFolderCommand}"
                                           AutomationProperties.AutomationId="Tray.OpenLogFolder">
                                    <Run Text="{x:Static res:TrayStrings.Settings_OpenLogFolder}" />
                                </Hyperlink>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer: a reminder that the tray keeps running; Close on the right. -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="18,10">
            <DockPanel LastChildFill="True">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="{x:Static res:TrayStrings.Footer_Close}"
                        Command="{Binding CloseCommand}" MinWidth="80" IsCancel="True"
                        AutomationProperties.AutomationId="Tray.Close" />
                <TextBlock Text="{x:Static res:TrayStrings.Footer_RunsInTray}" Style="{StaticResource MutedText}"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
