<!--
    rst-c's own (not vendored). The tray's model detail (spec #25 Model Detail, Look and Feel; F19 #25 WU4), in place of
    the Models list: Back on a bar at the top, then (scrolling) the header (the card's thumbnail or placeholder, title,
    file name, local and central path, the Revit versions it was opened in, the Workshared or Cloud pill, the health dot
    with its colour's name), and Revit's Activity tab as RST.UI draws it (Health/HealthResources.xaml): the stat cards
    (ModelActivityStats, five in the tray), the range pills (RangePill, 7D · 1M · 3M · 6M · 1Y, Health.Range.*) and the
    four charts (ModelActivityCharts). A loading line shows while the model is read. The view-model is
    ModelDetailViewModel.
-->
<UserControl x:Class="RST.Tray.Windows.ModelDetailView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RST.Tray.Resources"
             xmlns:health="clr-namespace:RST.UI.Health;assembly=RST.UI"
             AutomationProperties.AutomationId="Tray.Health.Detail">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
                <ResourceDictionary Source="/RST.UI;component/Health/HealthResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PathLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="VerticalAlignment" Value="Top" />
            </Style>
            <Style x:Key="PathText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Back, on the page's own bar (Escape does the same). -->
        <Border Padding="22,12,22,4">
            <Button x:Name="BackButton" HorizontalAlignment="Left" Command="{Binding BackCommand}" Padding="10,3"
                    ToolTip="{x:Static res:TrayStrings.Detail_BackHelp}"
                    AutomationProperties.AutomationId="Tray.Health.Detail.Back"
                    AutomationProperties.HelpText="{x:Static res:TrayStrings.Detail_BackHelp}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{x:Static res:TrayStrings.Detail_Back}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Border>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="22,8,22,12" Focusable="False" AutomationProperties.AutomationId="Tray.Health.Detail.Scroller">
            <StackPanel MaxWidth="820">
                <!-- The header. -->
                <Grid Margin="0,0,0,14" AutomationProperties.AutomationId="Tray.Health.Detail.Header"
                      AutomationProperties.Name="{Binding AutomationName}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="96" Height="96" CornerRadius="3" Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" VerticalAlignment="Top"
                            ClipToBounds="True" AutomationProperties.AutomationId="Tray.Health.Detail.Thumbnail">
                        <Grid>
                            <TextBlock x:Name="Placeholder" Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="34"
                                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       AutomationProperties.Name="{x:Static res:TrayStrings.Models_NoPreview}"
                                       AutomationProperties.AutomationId="Tray.Health.Detail.ThumbnailPlaceholder"
                                       Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToCollapsed}}" />
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.AutomationId="Tray.Health.Detail.ThumbnailImage"
                                   Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVisible}}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <DockPanel>
                            <ContentControl DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="{Binding Marker}" Margin="10,2,0,0"
                                            VerticalAlignment="Top" Focusable="False"
                                            Visibility="{Binding HasMarker, Converter={StaticResource BoolToVisible}}"
                                            AutomationProperties.AutomationId="Tray.Health.Detail.Marker" />
                            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadingText}" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="Tray.Health.Detail.Title" />
                        </DockPanel>
                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding ShowFileName, Converter={StaticResource BoolToVisible}}"
                                   AutomationProperties.AutomationId="Tray.Health.Detail.FileName" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" ToolTip="{x:Static res:TrayStrings.Models_HealthTip}">
                            <Ellipse Style="{StaticResource SeverityDot}" Margin="0,0,6,0" AutomationProperties.AutomationId="Tray.Health.Detail.HealthDot" />
                            <TextBlock Text="{Binding HealthName}" VerticalAlignment="Center" FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="Tray.Health.Detail.Health" />
                            <TextBlock Text=" · " Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Versions}" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="Tray.Health.Detail.Versions" />
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{x:Static res:TrayStrings.Detail_LocalPath}" Style="{StaticResource PathLabel}"
                                       Visibility="{Binding HasLocalPath, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Grid.Column="1" Text="{Binding LocalPath}" Style="{StaticResource PathText}"
                                       Visibility="{Binding HasLocalPath, Converter={StaticResource BoolToVisible}}"
                                       AutomationProperties.AutomationId="Tray.Health.Detail.LocalPath" />
                            <TextBlock Grid.Row="1" Text="{Binding CentralLabel}" Style="{StaticResource PathLabel}" Margin="0,2,8,0"
                                       Visibility="{Binding HasCentralPath, Converter={StaticResource BoolToVisible}}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CentralPath}" Style="{StaticResource PathText}" Margin="0,2,0,0"
                                       Visibility="{Binding HasCentralPath, Converter={StaticResource BoolToVisible}}"
                                       AutomationProperties.AutomationId="Tray.Health.Detail.CentralPath" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Reading the model. -->
                <StackPanel Margin="0,4,0,8" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}"
                            AutomationProperties.AutomationId="Tray.Health.Detail.Loading">
                    <ProgressBar Style="{StaticResource BusyIndicator}" />
                    <TextBlock Text="{x:Static res:TrayStrings.Detail_Loading}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Revit's Activity tab, as RST.UI draws it. -->
                <StackPanel Visibility="{Binding HasContent, Converter={StaticResource BoolToVisible}}">
                    <ContentControl Content="{Binding Panel}" ContentTemplate="{StaticResource ModelActivityStats}"
                                    Focusable="False" IsTabStop="False" />
                    <Border Style="{StaticResource RangePillGroup}" Margin="0,0,0,10" HorizontalAlignment="Left">
                        <ItemsControl ItemsSource="{Binding Ranges}" Focusable="False" AutomationProperties.AutomationId="Tray.Health.Detail.Ranges"
                                      AutomationProperties.Name="{x:Static res:TrayStrings.Detail_Ranges}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type health:RangeOption}">
                                    <RadioButton Style="{StaticResource RangePill}" GroupName="TrayDetailRange" Content="{Binding Label}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="{Binding AutomationKey}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ContentControl Content="{Binding Panel}" ContentTemplate="{StaticResource ModelActivityCharts}"
                                    Focusable="False" IsTabStop="False" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
