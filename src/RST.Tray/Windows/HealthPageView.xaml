<!--
    rst-c's own (not vendored). The tray's Health page (spec #25 Scope 1, Device, Look and Feel; F19 WU2): the Device
    and Models sub-tabs (it opens on Models). Device mirrors the add-in's Health tab (decisions #53, #59) with the same
    RST.UI parts (Health/HealthResources.xaml): the four SectionExpanders with their severity dots, Scan System with its
    spinner, the Captured time, Clean Junk Files and its Junk modal, the Cleaning overlay and the toast. The Junk modal,
    the overlay and the toast cover this page, not the tray's header and footer. Models is ModelsView (spec #25 WU3).
    The view-model is TrayHealthViewModel; TrayWindow hosts it in its HealthPage.
-->
<UserControl x:Class="RST.Tray.Windows.HealthPageView" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RST.Tray.Resources"
             xmlns:ui="clr-namespace:RST.UI.Resources;assembly=RST.UI"
             xmlns:local="clr-namespace:RST.Tray.Windows"
             AutomationProperties.AutomationId="Tray.Health">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
                <ResourceDictionary Source="/RST.UI;component/Health/HealthResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PageDescription" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,6,0,14" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The sub-tabs, in the tray's tab style, lined up with the pages' 640 px column. -->
        <Border Padding="22,12,22,0">
            <TabControl x:Name="SubTabs" MaxWidth="640" SelectedIndex="{Binding SubPageIndex, Mode=TwoWay}" Padding="0"
                        IsEnabled="{Binding Device.IsMainEnabled}" AutomationProperties.AutomationId="Tray.Health.Tabs">
                <TabItem Header="{x:Static res:TrayStrings.Health_TabDevice}" AutomationProperties.AutomationId="Tray.Health.TabDevice" />
                <TabItem Header="{x:Static res:TrayStrings.Health_TabModels}" AutomationProperties.AutomationId="Tray.Health.TabModels" />
            </TabControl>
        </Border>

        <!-- Device: the add-in's Health tab, outside Revit. -->
        <Grid Grid.Row="1" Visibility="{Binding IsDevicePage, Converter={StaticResource BoolToVisible}}">
            <ScrollViewer x:Name="DevicePage" DataContext="{Binding Device}" IsEnabled="{Binding IsMainEnabled}"
                          VerticalScrollBarVisibility="Auto" Padding="22,16,22,12" Focusable="False"
                          AutomationProperties.AutomationId="Tray.Health.Device">
                <StackPanel MaxWidth="640">
                    <TextBlock Text="{x:Static res:TrayStrings.Health_DeviceHeading}" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="{x:Static res:TrayStrings.Health_DeviceDescription}" Style="{StaticResource PageDescription}" />

                    <!-- Device and Captured on the left; Clean Junk Files, then the Primary Scan System, on the right. -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Margin="0,0,18,0" AutomationProperties.AutomationId="Tray.Health.DeviceName">
                                <Run Text="{x:Static ui:UiStrings.Health_Device}" Foreground="{StaticResource MutedTextBrush}" />
                                <Run Text="{Binding Device, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <TextBlock AutomationProperties.AutomationId="Tray.Health.Captured">
                                <Run Text="{x:Static ui:UiStrings.Health_Captured}" Foreground="{StaticResource MutedTextBrush}" />
                                <Run Text="{Binding Captured, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="CleanButton" Content="{x:Static ui:UiStrings.Health_CleanJunkFiles}" Command="{Binding CleanCommand}"
                                    AutomationProperties.AutomationId="Tray.Health.Clean" />
                            <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="8,0,0,0"
                                    MinWidth="120" Content="{Binding}" ContentTemplate="{StaticResource ScanButtonContent}"
                                    AutomationProperties.AutomationId="Tray.Health.Scan" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl x:Name="Sections" ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}"
                                  Focusable="False" AutomationProperties.AutomationId="Tray.Health.Sections" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Models (spec #25 WU3). -->
        <Grid Grid.Row="1" Visibility="{Binding IsModelsPage, Converter={StaticResource BoolToVisible}}">
            <local:ModelsView x:Name="ModelsPage" DataContext="{Binding Models}" />
        </Grid>

        <!-- The Junk modal (the add-in's, with its content shared), the Cleaning overlay and the toast, over the whole page. -->
        <Grid x:Name="JunkOverlay" Grid.RowSpan="2" DataContext="{Binding Device}" Background="{StaticResource ScrimBrush}"
              Panel.ZIndex="50" Visibility="{Binding IsJunkOpen, Converter={StaticResource BoolToVisible}}"
              AutomationProperties.AutomationId="Tray.Health.JunkOverlay">
            <Border x:Name="JunkCard" Style="{StaticResource Panel}" Width="480" Margin="16" Padding="24,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="Tray.Health.JunkModal">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JunkModalContent}" Focusable="False" IsTabStop="False" />
            </Border>
        </Grid>
        <ContentControl x:Name="BusyOverlay" Grid.RowSpan="2" DataContext="{Binding Device}" Style="{StaticResource BusyOverlay}"
                        Content="{Binding Busy}" Panel.ZIndex="60" />
        <ContentControl x:Name="Toast" Grid.RowSpan="2" DataContext="{Binding Device}" Style="{StaticResource TransientBanner}"
                        Content="{Binding Toast}" Panel.ZIndex="70" />
    </Grid>
</UserControl>
