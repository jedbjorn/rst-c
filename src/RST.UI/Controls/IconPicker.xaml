<!--
    rst-c's own (not vendored). The icon picker (spec #16, WU5, Shared controls), the Builder's
    "Pick an icon" overlay (profile_builder.html 1336-1344, CSS 519-583): a scrim over the window
    (a click on it cancels), and a 700 px card with the title, Cancel, and the grid of tiles: "∅ none"
    first, then one tile per design with its blue thumbnail. A design's variant row (its seven
    colors in palette order) is a full row right under the clicked tile's row (a row-based model,
    since a WrapPanel cannot insert a row under one tile). DataContext: IconPickerViewModel.
-->
<UserControl x:Class="RST.UI.Controls.IconPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:RST.UI.Resources"
             Focusable="False" KeyboardNavigation.TabNavigation="Cycle"
             AutomationProperties.AutomationId="IconPicker">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A tile or variant: flat, bordered, hover; selected = accent ring; open = accent wash. -->
            <Style x:Key="PickerButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentForegroundBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="TileTemplate">
                <Button x:Name="Tile" Style="{StaticResource PickerButton}" Width="86" Height="72" Margin="0,0,6,6"
                        Command="{Binding ClickCommand}" CommandParameter="{Binding Design}" ToolTip="{Binding ToolTip}"
                        Tag="{Binding Design}" AutomationProperties.Name="{Binding Label}">
                    <StackPanel>
                        <Grid Width="32" Height="32" HorizontalAlignment="Center">
                            <Image Source="{Binding Thumbnail}" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding IsNone, Converter={StaticResource BoolToCollapsed}}" />
                            <TextBlock Text="{x:Static res:UiStrings.Builder_IconNoneGlyph}" FontSize="22" Style="{StaticResource MutedText}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsNone, Converter={StaticResource BoolToVisible}}" />
                        </Grid>
                        <TextBlock Text="{Binding Label}" FontSize="10" Margin="4,4,4,0" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="78" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentForegroundBrush}" />
                        <Setter TargetName="Tile" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="VariantTemplate">
                <Button x:Name="Variant" Style="{StaticResource PickerButton}" Width="48" Height="48" Margin="0,0,6,0"
                        Command="{Binding ClickCommand}" CommandParameter="{Binding Color}" IsEnabled="{Binding IsEnabled}"
                        ToolTip="{Binding ToolTip}" Tag="{Binding Color}" AutomationProperties.Name="{Binding ToolTip}">
                    <Image Source="{Binding Image}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                </Button>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="Variant" Property="BorderBrush" Value="{StaticResource AccentForegroundBrush}" />
                        <Setter TargetName="Variant" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate x:Key="RowTemplate">
                <Grid>
                    <ItemsControl x:Name="TileRow" ItemsSource="{Binding Tiles}" ItemTemplate="{StaticResource TileTemplate}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border x:Name="VariantRow" Visibility="Collapsed" Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,6,6"
                            AutomationProperties.AutomationId="IconPicker.Variants">
                        <ItemsControl ItemsSource="{Binding Variants}" ItemTemplate="{StaticResource VariantTemplate}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsVariantRow}" Value="True">
                        <Setter TargetName="TileRow" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="VariantRow" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- The backdrop: a click outside the card cancels. -->
        <Border x:Name="Scrim" Background="{StaticResource ScrimBrush}" MouseLeftButtonDown="OnScrimDown"
                AutomationProperties.AutomationId="IconPicker.Scrim" />
        <Border x:Name="Card" Width="700" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="6"
                AutomationProperties.AutomationId="IconPicker.Card">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.3" />
            </Border.Effect>
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static res:UiStrings.Common_Cancel}" Command="{Binding CancelCommand}"
                                MinWidth="72" AutomationProperties.AutomationId="IconPicker.Cancel" />
                        <TextBlock Text="{x:Static res:UiStrings.Builder_IconPickerTitle}" Style="{StaticResource SectionText}" FontSize="14"
                                   Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <!-- Seven 92 px tiles (86 + 6 margin) = 644 px fit beside the scroll bar: the card is 700 px, not the page's
                     680 (its CSS grid shrank the tiles; these are fixed). WU5 review B2. -->
                <ScrollViewer x:Name="RowsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="16,14,10,8">
                    <ItemsControl x:Name="RowsHost" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False"
                                  AutomationProperties.AutomationId="IconPicker.Grid" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
