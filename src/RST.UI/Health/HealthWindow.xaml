<!--
    rst-c's own (not vendored). The Health window (spec #16, WU2), native WPF on the family theme,
    replacing v2.2.0's HTML page health_viewer.html one for one: the header (title, Health / Activity
    tabs, Device and Captured), the Health tab's four collapsible sections, the Activity tab's stat
    cards, range pills and charts (spec #24: a ModelActivityPanel drawn by HealthResources.xaml's
    templates), the per-tab footer, the Junk modal, the Cleaning overlay and the toast. The
    view-model is HealthViewModel. On the open in Revit the Health tab shows a spinner until the
    snapshot is read off the UI thread (SC-011).
-->
<Window x:Class="RST.UI.Health.HealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        xmlns:health="clr-namespace:RST.UI.Health"
        xmlns:controls="clr-namespace:RST.UI.Controls"
        xmlns:core="clr-namespace:RST.Core.Health;assembly=RST.Core"
        Title="{x:Static res:UiStrings.Health_WindowTitle}"
        Width="900" Height="800" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
                <!-- The snapshot's dot, rows, sections and the Junk modal's content, shared with the tray's Device page. -->
                <ResourceDictionary Source="/RST.UI;component/Health/HealthResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The root carries the window color itself: the screenshot tests render it unclipped by the window. -->
    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <Grid x:Name="Main" IsEnabled="{Binding IsMainEnabled}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: title, Health / Activity tabs, Device and Captured. -->
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                    Padding="18,10,18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:UiStrings.Health_Heading}" Style="{StaticResource HeadingText}"
                               VerticalAlignment="Center" Margin="0,0,24,10" />
                    <TabControl x:Name="Tabs" Grid.Column="1" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                                IsEnabled="{Binding IsIdle}" Padding="0" BorderThickness="0" VerticalAlignment="Bottom"
                                AutomationProperties.AutomationId="Health.Tabs">
                        <TabItem Header="{x:Static res:UiStrings.Health_TabHealth}" AutomationProperties.AutomationId="Health.TabHealth" />
                        <TabItem Header="{x:Static res:UiStrings.Health_TabActivity}" AutomationProperties.AutomationId="Health.TabActivity" />
                    </TabControl>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,10">
                        <TextBlock Margin="0,0,18,0" AutomationProperties.AutomationId="Health.Device">
                            <Run Text="{x:Static res:UiStrings.Health_Device}" Foreground="{StaticResource MutedTextBrush}" />
                            <Run Text="{Binding Device, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                        <TextBlock AutomationProperties.AutomationId="Health.Captured">
                            <Run Text="{x:Static res:UiStrings.Health_Captured}" Foreground="{StaticResource MutedTextBrush}" />
                            <Run Text="{Binding Captured, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Health tab: the four sections; while the open reads the snapshot (SC-011), the spinner and "Loading…". -->
            <ScrollViewer x:Name="HealthPane" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16,18,8"
                          Visibility="{Binding IsHealthTab, Converter={StaticResource BoolToVisible}}" Focusable="False">
                <Grid>
                    <ItemsControl x:Name="Sections" ItemsSource="{Binding Sections}" ItemTemplate="{StaticResource SectionTemplate}"
                                  MaxWidth="820" Focusable="False"
                                  Visibility="{Binding IsLoading, Converter={StaticResource BoolToCollapsed}}" />
                    <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top"
                                Margin="0,48,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisible}}"
                                AutomationProperties.AutomationId="Health.Loading">
                        <ProgressBar Style="{StaticResource BusySpinner}" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static res:UiStrings.Health_Loading}" Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Activity tab: six stat cards, the range pills and four charts (a ModelActivityPanel, shared with the tray). -->
            <ScrollViewer x:Name="ActivityPane" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16,18,8"
                          Visibility="{Binding IsActivityTab, Converter={StaticResource BoolToVisible}}" Focusable="False">
                <StackPanel MaxWidth="820">
                    <ContentControl Content="{Binding Activity}" ContentTemplate="{StaticResource ModelActivityStats}"
                                    Focusable="False" IsTabStop="False" />
                    <Border Style="{StaticResource RangePillGroup}" Margin="0,0,0,10">
                        <ItemsControl ItemsSource="{Binding Ranges}" IsEnabled="{Binding IsIdle}" Focusable="False"
                                      AutomationProperties.AutomationId="Health.Ranges">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type health:RangeOption}">
                                    <RadioButton Style="{StaticResource RangePill}" GroupName="HealthRange" Content="{Binding Label}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="{Binding AutomationKey}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <ContentControl Content="{Binding Activity}" ContentTemplate="{StaticResource ModelActivityCharts}"
                                    Focusable="False" IsTabStop="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- Footer: secondary actions on the left; Close, then the Primary, on the right. -->
            <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,1,0,0" Padding="18,10">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="CloseButton" Content="{x:Static res:UiStrings.Health_Close}" Command="{Binding CloseCommand}"
                                MinWidth="80" AutomationProperties.AutomationId="Health.Close" />
                        <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="8,0,0,0"
                                MinWidth="120" Visibility="{Binding IsHealthTab, Converter={StaticResource BoolToVisible}}"
                                Content="{Binding}" ContentTemplate="{StaticResource ScanButtonContent}"
                                AutomationProperties.AutomationId="Health.Scan" />
                    </StackPanel>
                    <Grid>
                        <Button x:Name="CleanButton" Content="{x:Static res:UiStrings.Health_CleanJunkFiles}" Command="{Binding CleanCommand}"
                                HorizontalAlignment="Left" Visibility="{Binding IsHealthTab, Converter={StaticResource BoolToVisible}}"
                                AutomationProperties.AutomationId="Health.Clean" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsActivityTab, Converter={StaticResource BoolToVisible}}">
                            <CheckBox x:Name="CollectionToggle" Style="{StaticResource ToggleSwitch}"
                                      Content="{x:Static res:UiStrings.Health_Collection}"
                                      IsChecked="{Binding TelemetryEnabled, Mode=TwoWay}" IsEnabled="{Binding IsIdle}"
                                      AutomationProperties.AutomationId="Health.Collection" />
                            <TextBlock Text="{Binding TelemetryStatusLine}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="Health.CollectionStatus" />
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- The Junk modal (the HTML's in-page overlay): every target on by default, or the empty state. -->
        <Grid x:Name="JunkOverlay" Background="{StaticResource ScrimBrush}" Panel.ZIndex="50"
              Visibility="{Binding IsJunkOpen, Converter={StaticResource BoolToVisible}}">
            <Border x:Name="JunkCard" Style="{StaticResource Panel}" Width="480" MaxWidth="820" Padding="24,20"
                    HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="Health.JunkModal">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource JunkModalContent}" Focusable="False" IsTabStop="False" />
            </Border>
        </Grid>

        <ContentControl x:Name="BusyOverlay" Style="{StaticResource BusyOverlay}" Content="{Binding Busy}" />
        <ContentControl x:Name="Toast" Style="{StaticResource TransientBanner}" Content="{Binding Toast}" />
    </Grid>
</Window>
