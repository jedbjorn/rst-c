<!--
    rst-c's own (not vendored); the window chrome follows splash-it
    src/SplashIt.UI/Settings/SettingsWindow.xaml (splash-it commit ba86a71, MIT, same owner).
    The Profile Builder (spec #16, WU4), first laid out one-for-one with profile_builder.html (1121-1328):
    three panes (the Commands tree with its count and filter, the Panels list with + Add Panel and the
    panel cards), the Live Preview strip at the bottom, and the toast on top. WU5 adds drag and drop
    (catalogue → panel or slot, slot reorder and move, panel reorder, with the drop-before / drop-after /
    drag-over markers) and the icon picker overlay.
    Feature #18 (spec #19, WU2; the approved layout of decision #25) reorganises it by scope: the header
    (HeaderStrip, the Tint) with ⚙ (machine settings: Branding…), the profile button and its menu (switch,
    + New profile, Rename…, Duplicate…), Export ZIP, "Profile Builder", the unsaved-changes indicator, Save
    and Exit; the Commands pane at 320 px; and the 330 px Profile pane with its General, Loader defaults and
    Junk cleanup tabs, where the Properties pane, the header's Name and Tab boxes, the Branding ▾ popover
    and the Presets and Cleanup modals were. WU3 makes the panel cards tiles and stacks ("Panels on tab",
    the inline colour and name, + New Stack, the stack rules of decisions #18 and #19 for drag and drop).
-->
<Window x:Class="RST.UI.Builder.ProfileBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        xmlns:controls="clr-namespace:RST.UI.Controls"
        xmlns:mvvm="clr-namespace:RST.UI.Mvvm"
        xmlns:builder="clr-namespace:RST.UI.Builder"
        xmlns:core="clr-namespace:RST.Core.Builder;assembly=RST.Core"
        Title="{x:Static res:UiStrings.Builder_WindowTitle}"
        Width="1450" Height="900" MinWidth="1100" MinHeight="600"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="ProfileBuilderWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A text box's placeholder: shown while the box (its Tag binding) is empty. -->
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Margin" Value="7,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                ⚙ and the profile button: the kit's Button look (flat, bordered, hover, pressed), checked
                while their menu is open. Each opens its ContextMenu (code-behind) and is not hit-testable
                while the menu is open, so the click that dismisses the menu cannot reopen it (the
                Branding popover's VM finding D2, spec #16 WU5).
            -->
            <Style x:Key="MenuToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="ContextMenuService.IsEnabled" Value="False" />
                <Setter Property="IsHitTestVisible"
                        Value="{Binding ContextMenu.IsOpen, RelativeSource={RelativeSource Self}, Converter={StaticResource InverseBool}}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome" CornerRadius="3" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A menu's heading ("This machine — not saved in profiles", "Switch profile"): muted, small, not an item. -->
            <Style x:Key="MenuHeading" TargetType="MenuItem">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <TextBlock Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                       Margin="10,6,10,3" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A profile in the profile menu: the tick for the one in the editor, then its name. -->
            <DataTemplate x:Key="ProfileMenuHeader" DataType="{x:Type builder:ProfileOptionViewModel}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="Tick" Text="✓" Width="16" Visibility="Hidden" />
                    <TextBlock x:Name="ProfileName" Text="{Binding Display}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        <Setter TargetName="ProfileName" Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A pane's header row: the label on the left, its count or button on the right. -->
            <Style x:Key="PaneHeader" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Height" Value="42" />
            </Style>

            <!-- The Profile pane's field labels and help lines. -->
            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
            <Style x:Key="FieldHelp" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>

            <!-- × on a Junk cleanup row. -->
            <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Padding" Value="5,1" />
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="Margin" Value="3,0,0,0" />
            </Style>
            <Style x:Key="RowDangerButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
                <Setter Property="Foreground" Value="{StaticResource DangerForegroundBrush}" />
            </Style>

            <!--
                A drop marker over a card or a slot row (the page's drop-before / drop-after / drag-over
                classes): a 2 px success-colored line above or below the target, or around it. It is an
                overlay, so the layout never shifts (gantt-it's row-border approach).
            -->
            <Style x:Key="DropMarkerBorder" TargetType="Border">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.Before}">
                        <Setter Property="BorderThickness" Value="0,2,0,0" />
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.After}">
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.Over}">
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.Refused}">
                        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                The marker over a tile or a stack group (feature #18, WU3). Tiles run left to right, so
                before and after are a 3 px line on the left or right edge; over (a stack forms, or the
                tool joins the stack) rings it; refused (a full stack) rings it in the error colour.
            -->
            <Style x:Key="TileDropMarker" TargetType="Border">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.Before}">
                        <Setter Property="BorderThickness" Value="3,0,0,0" />
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.After}">
                        <Setter Property="BorderThickness" Value="0,0,3,0" />
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.Over}">
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.Refused}">
                        <Setter Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- ✎ × ▲ ▼ on the cards, tiles and stacks (the spike's ghost buttons). -->
            <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="MinWidth" Value="20" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style x:Key="GhostDanger" TargetType="Button" BasedOn="{StaticResource Ghost}">
                <Setter Property="Foreground" Value="{StaticResource DangerForegroundBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- A tile's or a stack row's icon: a flat button around the image (a click opens the icon picker). -->
            <Style x:Key="IconSlot" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Padding" Value="2" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <!-- The card's colour swatch: the panel colour, a click opens the family colour picker. -->
            <Style x:Key="Swatch" TargetType="Button">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chip" CornerRadius="4" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" SnapsToDevicePixels="True" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- The pane header's tab name: a pill; a click takes you to the tab field on General. -->
            <Style x:Key="TabPill" TargetType="Button">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Pill" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentForegroundBrush}"
                                    BorderThickness="1" CornerRadius="3" Padding="10,2" SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A name edited in place (a panel's, a tile's, a stack row's): borderless until hovered or focused. -->
            <Style x:Key="InlineName" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="MinHeight" Value="20" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The card's drag handle. -->
            <Style x:Key="Handle" TargetType="TextBlock">
                <Setter Property="Text" Value="⠿" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Cursor" Value="SizeAll" />
            </Style>

            <!--
                A loose tool's tile (feature #18, WU3): the 32 px icon (the icon picker), the name box (this
                panel's label for the tool), the muted source line; ✎ (custom tools, WU4) and × on hover; the
                full command id or link as the tooltip. Tiles are drag sources and drop targets: the card's
                preview handlers work out where the pointer is (OnCardDragOver).
            -->
            <DataTemplate DataType="{x:Type builder:ToolTileViewModel}">
                <Border x:Name="TileCell" Background="Transparent" Padding="0,0,10,10" VerticalAlignment="Top">
                <Grid x:Name="Tile" Width="100" VerticalAlignment="Top" Background="Transparent"
                      ToolTip="{Binding ToolTip}" PreviewMouseLeftButtonDown="OnDragSourceDown" MouseMove="OnDragSourceMove"
                      AutomationProperties.AutomationId="Builder.Tile" AutomationProperties.Name="{Binding Name}">
                    <Border x:Name="TileFace" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="4,7,4,5" SnapsToDevicePixels="True">
                        <StackPanel>
                            <Button x:Name="IconHandle" Style="{StaticResource IconSlot}" Command="{Binding PickIconCommand}" HorizontalAlignment="Center"
                                    ToolTip="{x:Static res:UiStrings.Builder_PickIconTip}"
                                    AutomationProperties.AutomationId="Builder.PickIcon"
                                    AutomationProperties.Name="{x:Static res:UiStrings.Builder_PickIconTip}">
                                <Grid Width="32" Height="32">
                                    <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Rectangle x:Name="NoIcon" Stroke="{StaticResource StrongBorderBrush}" StrokeDashArray="3 2" RadiusX="3" RadiusY="3"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Button>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineName}" TextAlignment="Center" HorizontalAlignment="Center" MinWidth="40"
                                     FontSize="11" Padding="2,0" Margin="0,3,0,0"
                                     AutomationProperties.AutomationId="Builder.ToolName"
                                     AutomationProperties.Name="{x:Static res:UiStrings.Builder_ToolName}" />
                            <TextBlock Text="{Binding SourceLine}" Style="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center"
                                       MaxWidth="90" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="Builder.ToolSource" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="Corner" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,1,0" Opacity="0" IsHitTestVisible="False">
                        <!-- WU4's hook: ✎ on a placed custom tool (shown only when WU4 provides the command). -->
                        <Button Content="✎" Style="{StaticResource Ghost}" Command="{Binding EditCustomCommand}" CommandParameter="{Binding}"
                                Visibility="{Binding ShowsEditCustom, Converter={StaticResource BoolToVisible}}"
                                ToolTip="{x:Static res:UiStrings.Builder_EditCustomToolTip}"
                                AutomationProperties.AutomationId="Builder.EditCustomTool"
                                AutomationProperties.Name="{x:Static res:UiStrings.Builder_EditCustomToolTip}" />
                        <Button Content="×" Style="{StaticResource GhostDanger}" Command="{Binding RemoveCommand}"
                                ToolTip="{x:Static res:UiStrings.Builder_RemoveSlotTip}"
                                AutomationProperties.AutomationId="Builder.RemoveTool"
                                AutomationProperties.Name="{x:Static res:UiStrings.Builder_RemoveSlotTip}" />
                    </StackPanel>
                    <Border Style="{StaticResource TileDropMarker}" CornerRadius="4" AutomationProperties.AutomationId="Builder.TileDropMarker" />
                </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                        <Setter TargetName="NoIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Corner" Property="Opacity" Value="1" />
                        <Setter TargetName="Corner" Property="IsHitTestVisible" Value="True" />
                        <Setter TargetName="TileFace" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                    </Trigger>
                    <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="Corner" Property="Opacity" Value="1" />
                        <Setter TargetName="Corner" Property="IsHitTestVisible" Value="True" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                        <Setter TargetName="Tile" Property="Opacity" Value="0.4" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A stack's row: the 16 px icon (the icon picker), the name box; ✎ (custom tools, WU4) and × on hover. -->
            <DataTemplate x:Key="StackRowTemplate" DataType="{x:Type builder:ToolTileViewModel}">
                <Grid x:Name="StackRow" Margin="0,0,0,3" Background="Transparent" ToolTip="{Binding ToolTip}"
                      PreviewMouseLeftButtonDown="OnDragSourceDown" MouseMove="OnDragSourceMove"
                      AutomationProperties.AutomationId="Builder.StackRow" AutomationProperties.Name="{Binding Name}">
                    <Border x:Name="RowFace" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="2,1,2,1" SnapsToDevicePixels="True">
                        <DockPanel>
                            <StackPanel x:Name="Corner" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False">
                                <Button Content="✎" Style="{StaticResource Ghost}" Command="{Binding EditCustomCommand}" CommandParameter="{Binding}"
                                        Visibility="{Binding ShowsEditCustom, Converter={StaticResource BoolToVisible}}"
                                        ToolTip="{x:Static res:UiStrings.Builder_EditCustomToolTip}"
                                        AutomationProperties.AutomationId="Builder.EditCustomTool"
                                        AutomationProperties.Name="{x:Static res:UiStrings.Builder_EditCustomToolTip}" />
                                <Button Content="×" Style="{StaticResource GhostDanger}" Command="{Binding RemoveCommand}"
                                        ToolTip="{x:Static res:UiStrings.Builder_RemoveSlotTip}"
                                        AutomationProperties.AutomationId="Builder.RemoveTool"
                                        AutomationProperties.Name="{x:Static res:UiStrings.Builder_RemoveSlotTip}" />
                            </StackPanel>
                            <Button x:Name="IconHandle" DockPanel.Dock="Left" Style="{StaticResource IconSlot}" Padding="1" Margin="0,0,3,0" Command="{Binding PickIconCommand}" VerticalAlignment="Center"
                                    ToolTip="{x:Static res:UiStrings.Builder_PickIconTip}"
                                    AutomationProperties.AutomationId="Builder.PickIcon"
                                    AutomationProperties.Name="{x:Static res:UiStrings.Builder_PickIconTip}">
                                <Image Source="{Binding Icon}" Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Button>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineName}" FontSize="11"
                                     Padding="0" Margin="0" HorizontalAlignment="Left" MinWidth="40"
                                     AutomationProperties.AutomationId="Builder.ToolName"
                                     AutomationProperties.Name="{x:Static res:UiStrings.Builder_ToolName}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource DropMarkerBorder}" CornerRadius="3" AutomationProperties.AutomationId="Builder.StackRowDropMarker" />
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="StackRow" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Corner" Property="Opacity" Value="1" />
                        <Setter TargetName="Corner" Property="IsHitTestVisible" Value="True" />
                        <Setter TargetName="RowFace" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                    </Trigger>
                    <Trigger SourceName="StackRow" Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="Corner" Property="Opacity" Value="1" />
                        <Setter TargetName="Corner" Property="IsHitTestVisible" Value="True" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                        <Setter TargetName="StackRow" Property="Opacity" Value="0.4" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!--
                A stack (feature #18, WU3; decision #19): "STACK · n/3" with ✎ (the stack dialog) and ×
                (un-stack) on its right edge, then its 2-3 rows. Dragged by its header, the whole stack
                moves. A full stack refusing a fourth tool shows the refusal marker and its message.
            -->
            <DataTemplate DataType="{x:Type builder:StackGroupViewModel}">
                <Border x:Name="TileCell" Background="Transparent" Padding="0,0,10,10" VerticalAlignment="Top">
                <Grid x:Name="StackGroup" Width="200" VerticalAlignment="Top" Background="Transparent"
                      AutomationProperties.AutomationId="Builder.Stack" AutomationProperties.Name="{Binding Header}">
                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1,3,1,1"
                            CornerRadius="4" Padding="6,2,6,3" SnapsToDevicePixels="True">
                        <StackPanel>
                            <DockPanel x:Name="StackHeader" Margin="0,0,0,2" Background="Transparent" Cursor="SizeAll"
                                       PreviewMouseLeftButtonDown="OnDragSourceDown" MouseMove="OnDragSourceMove"
                                       AutomationProperties.AutomationId="Builder.StackHeader">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="✎" Style="{StaticResource Ghost}" Command="{Binding EditCommand}"
                                            ToolTip="{x:Static res:UiStrings.Builder_EditStackTip}"
                                            AutomationProperties.AutomationId="Builder.EditStack"
                                            AutomationProperties.Name="{x:Static res:UiStrings.Builder_EditStackTip}" />
                                    <Button Content="×" Style="{StaticResource GhostDanger}" Command="{Binding UnstackCommand}"
                                            ToolTip="{x:Static res:UiStrings.Builder_UnstackTip}"
                                            AutomationProperties.AutomationId="Builder.Unstack"
                                            AutomationProperties.Name="{x:Static res:UiStrings.Builder_UnstackTip}" />
                                </StackPanel>
                                <TextBlock Text="{Binding Header}" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="Builder.StackHeaderText" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource StackRowTemplate}" Focusable="False" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource TileDropMarker}" CornerRadius="4" AutomationProperties.AutomationId="Builder.StackDropMarker" />
                    <Border x:Name="FullNote" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource ErrorBrush}" BorderThickness="1"
                            CornerRadius="3" Padding="6,3" Margin="8,0,8,6" VerticalAlignment="Bottom" IsHitTestVisible="False" Visibility="Collapsed"
                            AutomationProperties.AutomationId="Builder.StackFull">
                        <TextBlock Text="{x:Static res:UiStrings.Builder_StackFull}" Foreground="{StaticResource ErrorBrush}" FontSize="11"
                                   TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>
                </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.Refused}">
                        <Setter TargetName="FullNote" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                        <Setter TargetName="StackGroup" Property="Opacity" Value="0.4" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A catalogue node: groups (native group, tab, panel) with a count pill; commands with their short id. -->
            <HierarchicalDataTemplate x:Key="CatalogNodeTemplate" DataType="{x:Type builder:CatalogNodeViewModel}"
                                      ItemsSource="{Binding Children}">
                <Grid Background="Transparent">
                    <DockPanel x:Name="GroupRow" Background="Transparent">
                        <DockPanel.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}" />
                        </DockPanel.InputBindings>
                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="{Binding Count}" Margin="6,0,0,0" />
                        <TextBlock x:Name="GroupLabel" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel x:Name="CommandRow" Background="Transparent" Visibility="Collapsed" ToolTip="{Binding ToolTip}"
                               PreviewMouseLeftButtonDown="OnDragSourceDown" MouseMove="OnDragSourceMove">
                        <DockPanel.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick"
                                          Command="{Binding DataContext.AddCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}" />
                        </DockPanel.InputBindings>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ShortId}" Style="{StaticResource MutedText}" FontSize="10"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCommand}" Value="True">
                        <Setter TargetName="GroupRow" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="CommandRow" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Panel">
                        <Setter TargetName="GroupLabel" Property="FontWeight" Value="Normal" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The root carries the window color itself: the screenshot tests render it unclipped by the window. -->
    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <!-- Disabled while a save's auto-reload runs: no command or input reaches the window. -->
        <Grid x:Name="Body" IsEnabled="{Binding IsIdle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Header (feature #18, decisions #22-#24): the shared HeaderStrip (Tint). Left to right: ⚙ (machine
                settings), the profile button and its menu, Export ZIP, a divider, "Profile Builder"; on the right,
                the unsaved-changes dot and text, Save (the Primary; only with changes) and Exit.
            -->
            <Border x:Name="Header" Style="{StaticResource HeaderStrip}" AutomationProperties.AutomationId="Builder.Header">
                <DockPanel VerticalAlignment="Center" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton x:Name="SettingsButton" Style="{StaticResource MenuToggle}" Width="30" MinWidth="30" Padding="0"
                                      Checked="OnMenuToggleChecked"
                                      ToolTip="{x:Static res:UiStrings.Builder_SettingsTip}" AutomationProperties.AutomationId="Builder.Settings"
                                      AutomationProperties.Name="{x:Static res:UiStrings.Builder_SettingsTip}">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <ToggleButton.ContextMenu>
                                <ContextMenu x:Name="SettingsMenu" Closed="OnMenuClosed" AutomationProperties.AutomationId="Builder.SettingsMenu">
                                    <MenuItem Style="{StaticResource MenuHeading}" Header="{x:Static res:UiStrings.Builder_SettingsHeading}" />
                                    <MenuItem x:Name="BrandingMenuItem" Header="{x:Static res:UiStrings.Builder_BrandingMenu}"
                                              InputGestureText="{x:Static res:UiStrings.Builder_BrandingMenuNote}" Command="{Binding BrandingCommand}"
                                              AutomationProperties.AutomationId="Builder.BrandingMenu" />
                                </ContextMenu>
                            </ToggleButton.ContextMenu>
                        </ToggleButton>

                        <ToggleButton x:Name="ProfileButton" Style="{StaticResource MenuToggle}" Width="250" Margin="10,0,0,0"
                                      HorizontalContentAlignment="Stretch" Checked="OnMenuToggleChecked"
                                      ToolTip="{x:Static res:UiStrings.Builder_ProfileSelectorTip}"
                                      AutomationProperties.AutomationId="Builder.ProfileButton"
                                      AutomationProperties.Name="{x:Static res:UiStrings.Builder_ProfileSelectorTip}">
                            <!-- The name, "(loaded)" right after it (as the spike), the chevron at the right edge. -->
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Right" Text="▾" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <TextBlock x:Name="ProfileButtonName" DockPanel.Dock="Left" Text="{Binding DisplayName}" FontWeight="SemiBold"
                                           VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="Builder.ProfileButtonName" />
                                <TextBlock DockPanel.Dock="Left" Text="{x:Static res:UiStrings.Builder_LoadedMark}" Style="{StaticResource MutedText}"
                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding IsLoadedProfile, Converter={StaticResource BoolToVisible}}"
                                           AutomationProperties.AutomationId="Builder.LoadedMark" />
                            </DockPanel>
                            <ToggleButton.ContextMenu>
                                <ContextMenu x:Name="ProfileMenu" Closed="OnMenuClosed" MinWidth="300"
                                             AutomationProperties.AutomationId="Builder.ProfileMenu">
                                    <MenuItem x:Name="ProfileMenuHeading" Style="{StaticResource MenuHeading}"
                                              Header="{x:Static res:UiStrings.Builder_SwitchProfileHeading}" />
                                    <!-- The profiles go here (code-behind, from ProfileOptions, each time the menu opens). -->
                                    <Separator x:Name="ProfileMenuDivider" />
                                    <MenuItem Header="{x:Static res:UiStrings.Builder_NewProfile}" Command="{Binding NewProfileCommand}"
                                              AutomationProperties.AutomationId="Builder.NewProfile" />
                                    <MenuItem Header="{x:Static res:UiStrings.Builder_RenameMenu}" InputGestureText="{x:Static res:UiStrings.Builder_RenameNote}"
                                              Command="{Binding RenameCommand}" AutomationProperties.AutomationId="Builder.RenameMenu" />
                                    <MenuItem Header="{x:Static res:UiStrings.Builder_DuplicateMenu}" InputGestureText="{x:Static res:UiStrings.Builder_DuplicateNote}"
                                              Command="{Binding DuplicateCommand}" AutomationProperties.AutomationId="Builder.DuplicateMenu" />
                                </ContextMenu>
                            </ToggleButton.ContextMenu>
                        </ToggleButton>

                        <Button Content="{x:Static res:UiStrings.Builder_ExportZip}" Command="{Binding ExportCommand}" Margin="10,0,0,0"
                                AutomationProperties.AutomationId="Builder.Export" />
                        <Rectangle Style="{StaticResource HeaderDivider}" />
                        <TextBlock Text="{x:Static res:UiStrings.Builder_Title}" Style="{StaticResource HeaderTitle}"
                                   AutomationProperties.AutomationId="Builder.Title" />
                    </StackPanel>

                    <!-- The unsaved-changes indicator, then the family button bar: Save (the Primary), Exit rightmost. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="UnsavedIndicator" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"
                                    Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisible}}"
                                    AutomationProperties.AutomationId="Builder.Unsaved">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource WarningTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{x:Static res:UiStrings.Builder_UnsavedIndicator}" Foreground="{StaticResource WarningTextBrush}"
                                       FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="SaveButton" Content="{x:Static res:UiStrings.Builder_Save}" Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}" MinWidth="72" AutomationProperties.AutomationId="Builder.Save" />
                        <Button Content="{x:Static res:UiStrings.Builder_Exit}" Command="{Binding ExitCommand}" Margin="8,0,0,0" MinWidth="72"
                                ToolTip="{x:Static res:UiStrings.Builder_ExitTip}" AutomationProperties.AutomationId="Builder.Exit" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Body: Commands | Panels | Profile -->
            <Grid x:Name="Panes" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <!-- Commands -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceAltBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <DockPanel VerticalAlignment="Center">
                                <ContentControl DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="{Binding CatalogCount}"
                                                AutomationProperties.AutomationId="Builder.CatalogCount" />
                                <TextBlock Text="{x:Static res:UiStrings.Builder_Commands}" Style="{StaticResource SectionText}" Margin="0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Grid DockPanel.Dock="Top" Margin="12,10,12,8">
                            <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="Builder.Filter"
                                     AutomationProperties.Name="{x:Static res:UiStrings.Builder_FilterPlaceholder}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UiStrings.Builder_FilterPlaceholder}"
                                       Tag="{Binding Text, ElementName=FilterBox}" />
                        </Grid>
                        <Grid>
                            <!-- Height-bounded by the pane, so the tree virtualizes (spec #16, AC7). -->
                            <TreeView x:Name="CatalogTreeView" ItemsSource="{Binding CatalogRoots}" ItemTemplate="{StaticResource CatalogNodeTemplate}"
                                      Padding="6,0,6,8" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.AutomationId="Builder.Catalog"
                                      AutomationProperties.Name="{x:Static res:UiStrings.Builder_Commands}">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                            <TextBlock Text="{x:Static res:UiStrings.Builder_CatalogEmpty}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="20,24" VerticalAlignment="Top"
                                       Visibility="{Binding CatalogIsEmpty, Converter={StaticResource BoolToVisible}}"
                                       AutomationProperties.AutomationId="Builder.CatalogEmpty" />
                            <TextBlock Text="{Binding NoMatchesText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="20,24" VerticalAlignment="Top"
                                       Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisible}}"
                                       AutomationProperties.AutomationId="Builder.NoMatches" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!--
                    Panels on tab [tab name] (feature #18, WU3; decision #25): the cards in ribbon order. Each card:
                    the colour stripe; a header with the drag handle, the colour swatch, the name edited in place,
                    the tool count, + New Stack and ▲ ▼ × (on hover, or when selected); then its tiles and stacks,
                    wrapping. The card's preview drag handlers see every drag over it first, the name boxes
                    included (a TextBox swallows drags: the TextBox lesson in docs/DEVELOPING.md).
                -->
                <DockPanel Grid.Column="1">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                        <DockPanel VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Content="{x:Static res:UiStrings.Builder_AddPanel}" Command="{Binding AddPanelCommand}"
                                    AutomationProperties.AutomationId="Builder.AddPanel" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:UiStrings.Builder_Panels}" Style="{StaticResource SectionText}" Margin="0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static res:UiStrings.Builder_PanelsOnTab}" Style="{StaticResource MutedText}" FontSize="11"
                                           Margin="8,0,8,0" VerticalAlignment="Center" />
                                <Button x:Name="TabNameButton" Style="{StaticResource TabPill}" Click="OnTabNameClick" VerticalAlignment="Center"
                                        ToolTip="{x:Static res:UiStrings.Builder_TabNameTip}"
                                        AutomationProperties.AutomationId="Builder.PanelsTab"
                                        AutomationProperties.Name="{x:Static res:UiStrings.Builder_TabNameTip}">
                                    <TextBlock Text="{Binding PanelsTabName}" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="CanvasScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid Margin="20,16,20,24">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="32"
                                    Visibility="{Binding HasPanels, Converter={StaticResource BoolToCollapsed}}"
                                    AutomationProperties.AutomationId="Builder.CanvasEmpty">
                                <TextBlock Text="{x:Static res:UiStrings.Builder_CanvasEmpty}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                            </Border>
                            <ItemsControl x:Name="PanelCards" ItemsSource="{Binding Panels}" Focusable="False"
                                          AutomationProperties.AutomationId="Builder.Panels"
                                          AutomationProperties.Name="{x:Static res:UiStrings.Builder_Panels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type builder:PanelCardViewModel}">
                                        <Grid x:Name="CardRoot" Margin="0,0,0,14" AutomationProperties.Name="{Binding Name}" AllowDrop="True"
                                              PreviewGotKeyboardFocus="OnCardFocus" PreviewDragEnter="OnCardDragOver" PreviewDragOver="OnCardDragOver" PreviewDrop="OnCardDrop"
                                              DragLeave="OnDragLeave">
                                            <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding SelectCommand}" />
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <Border Height="4" Background="{Binding ColorBrush}" CornerRadius="5,5,0,0"
                                                            AutomationProperties.AutomationId="Builder.PanelStripe" />
                                                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}"
                                                            BorderThickness="0,0,0,1" Padding="10,6"
                                                            PreviewMouseLeftButtonDown="OnDragSourceDown" MouseMove="OnDragSourceMove"
                                                            AutomationProperties.AutomationId="Builder.PanelHeader">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Button Content="{x:Static res:UiStrings.Builder_NewStack}" Command="{Binding NewStackCommand}"
                                                                        ToolTip="{x:Static res:UiStrings.Builder_NewStackTip}" ToolTipService.ShowOnDisabled="True"
                                                                        AutomationProperties.AutomationId="Builder.NewStack" />
                                                                <StackPanel x:Name="HoverActs" Orientation="Horizontal" Margin="8,0,0,0" Opacity="0"
                                                                            VerticalAlignment="Center">
                                                                    <Button Content="▲" Command="{Binding MoveUpCommand}" Style="{StaticResource Ghost}"
                                                                            ToolTip="{x:Static res:UiStrings.Builder_MoveUp}"
                                                                            AutomationProperties.AutomationId="Builder.MovePanelUp"
                                                                            AutomationProperties.Name="{x:Static res:UiStrings.Builder_MoveUp}" />
                                                                    <Button Content="▼" Command="{Binding MoveDownCommand}" Style="{StaticResource Ghost}"
                                                                            ToolTip="{x:Static res:UiStrings.Builder_MoveDown}"
                                                                            AutomationProperties.AutomationId="Builder.MovePanelDown"
                                                                            AutomationProperties.Name="{x:Static res:UiStrings.Builder_MoveDown}" />
                                                                    <Button Content="×" Command="{Binding DeleteCommand}" Style="{StaticResource GhostDanger}"
                                                                            ToolTip="{x:Static res:UiStrings.Builder_DeletePanelTip}"
                                                                            AutomationProperties.AutomationId="Builder.DeletePanel"
                                                                            AutomationProperties.Name="{x:Static res:UiStrings.Builder_DeletePanelTip}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <TextBlock Style="{StaticResource Handle}" Margin="0,0,8,0" ToolTip="{x:Static res:UiStrings.Builder_DragPanelTip}" />
                                                            <Button Style="{StaticResource Swatch}" Background="{Binding ColorBrush}" Command="{Binding PickColorCommand}"
                                                                    Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="{x:Static res:UiStrings.Builder_PanelColorTip}"
                                                                    AutomationProperties.AutomationId="Builder.PanelColor"
                                                                    AutomationProperties.Name="{x:Static res:UiStrings.Builder_PanelColorTip}" />
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InlineName}"
                                                                     Width="220" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                                                     AutomationProperties.AutomationId="Builder.PanelName"
                                                                     AutomationProperties.Name="{x:Static res:UiStrings.Builder_PanelName}" />
                                                            <TextBlock Text="{Binding ToolCount}" Style="{StaticResource MutedText}" FontSize="11"
                                                                       Margin="8,0,0,0" VerticalAlignment="Center"
                                                                       AutomationProperties.AutomationId="Builder.ToolCount" />
                                                        </DockPanel>
                                                    </Border>
                                                    <Grid Margin="12,10,2,0" MinHeight="56">
                                                        <TextBlock Text="{x:Static res:UiStrings.Builder_PanelEmpty}" Style="{StaticResource MutedText}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,10"
                                                                   Visibility="{Binding HasItems, Converter={StaticResource BoolToCollapsed}}"
                                                                   AutomationProperties.AutomationId="Builder.PanelEmpty" />
                                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False"
                                                                      AutomationProperties.AutomationId="Builder.Tiles">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                        </ItemsControl>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <!-- The selected card's ring, over the border (no layout shift). -->
                                            <Border x:Name="Ring" BorderBrush="{StaticResource AccentForegroundBrush}" BorderThickness="2" CornerRadius="6"
                                                    IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.AutomationId="Builder.PanelRing" />
                                            <Border Style="{StaticResource DropMarkerBorder}" CornerRadius="6"
                                                    AutomationProperties.AutomationId="Builder.PanelDropMarker" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="HoverActs" Property="Opacity" Value="1" />
                                            </DataTrigger>
                                            <Trigger SourceName="CardRoot" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HoverActs" Property="Opacity" Value="1" />
                                            </Trigger>
                                            <Trigger SourceName="CardRoot" Property="IsKeyboardFocusWithin" Value="True">
                                                <Setter TargetName="HoverActs" Property="Opacity" Value="1" />
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- Profile pane (feature #18): General | Loader defaults | Junk cleanup, every edit an unsaved change. -->
                <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceBrush}"
                        AutomationProperties.AutomationId="Builder.ProfilePane">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <DockPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:UiStrings.Builder_ProfileSection}" Style="{StaticResource SectionText}" Margin="0"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding EditingText}" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="Builder.EditingName" />
                            </DockPanel>
                        </Border>
                        <TabControl x:Name="ProfileTabs" Padding="0" Margin="0,4,0,0" AutomationProperties.AutomationId="Builder.ProfileTabs">
                            <TabItem x:Name="GeneralTab" Header="{x:Static res:UiStrings.Builder_TabGeneral}" Margin="10,0,0,0"
                                     AutomationProperties.AutomationId="Builder.GeneralTab">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel Margin="16,14,16,14">
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_ProfileName}" Style="{StaticResource FieldLabel}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{x:Static res:UiStrings.Builder_RenameMenu}" Command="{Binding RenameCommand}"
                                                    Margin="6,0,0,0" AutomationProperties.AutomationId="Builder.Rename" />
                                            <Grid>
                                                <TextBox x:Name="ProfileNameBox" Text="{Binding ProfileName, Mode=OneWay}" IsReadOnly="True"
                                                         AutomationProperties.AutomationId="Builder.ProfileName"
                                                         AutomationProperties.Name="{x:Static res:UiStrings.Builder_ProfileName}" />
                                                <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UiStrings.Builder_UnnamedHint}"
                                                           Tag="{Binding Text, ElementName=ProfileNameBox}" />
                                            </Grid>
                                        </DockPanel>

                                        <TextBlock Text="{x:Static res:UiStrings.Builder_RibbonTabName}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <TextBox x:Name="TabBox" Text="{Binding ProfileTab, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="Builder.Tab"
                                                 AutomationProperties.Name="{x:Static res:UiStrings.Builder_RibbonTabName}" />

                                        <TextBlock Text="{x:Static res:UiStrings.Builder_PanelOpacity}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PanelOpacityText}" MinWidth="36" TextAlignment="Right"
                                                       VerticalAlignment="Center" AutomationProperties.AutomationId="Builder.OpacityValue" />
                                            <Slider Minimum="10" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5"
                                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                    Value="{Binding PanelOpacity, Mode=TwoWay}"
                                                    AutomationProperties.AutomationId="Builder.Opacity"
                                                    AutomationProperties.Name="{x:Static res:UiStrings.Builder_PanelOpacity}" />
                                        </DockPanel>
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_PanelOpacityHelp}" Style="{StaticResource FieldHelp}" />

                                        <TextBlock Text="{x:Static res:UiStrings.Builder_MinRevitVersion}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <TextBox Text="{Binding MinVersion, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="Builder.MinVersion"
                                                 AutomationProperties.Name="{x:Static res:UiStrings.Builder_MinRevitVersion}" />
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_MinRevitHelp}" Style="{StaticResource FieldHelp}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem x:Name="LoaderDefaultsTab" Header="{x:Static res:UiStrings.Builder_TabLoaderDefaults}"
                                     AutomationProperties.AutomationId="Builder.LoaderDefaultsTab">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel Margin="16,12,16,14">
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsBody}" Style="{StaticResource FieldHelp}" Margin="0,0,0,10" />
                                        <DockPanel Margin="0,0,0,4">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DisableUnused}"
                                                      VerticalAlignment="Center" AutomationProperties.AutomationId="Builder.DisableUnused"
                                                      AutomationProperties.Name="{x:Static res:UiStrings.Builder_PresetsDisableUnused}" />
                                            <StackPanel>
                                                <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsDisableUnused}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsDisableUnusedHelp}" Style="{StaticResource FieldHelp}"
                                                           Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsHideTabs}" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                                        <ItemsControl ItemsSource="{Binding PresetTabs}" Focusable="False" AutomationProperties.AutomationId="Builder.PresetTabs">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type builder:PresetTabViewModel}">
                                                    <DockPanel Margin="0,4">
                                                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsHidden}"
                                                                  VerticalAlignment="Center" AutomationProperties.Name="{Binding Tab}" />
                                                        <TextBlock Text="{Binding Tab}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsNoTabs}" Style="{StaticResource FieldHelp}"
                                                   Visibility="{Binding HasPresetTabs, Converter={StaticResource BoolToCollapsed}}"
                                                   AutomationProperties.AutomationId="Builder.PresetsNoTabs" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem x:Name="JunkCleanupTab" Header="{x:Static res:UiStrings.Builder_TabJunkCleanup}"
                                     AutomationProperties.AutomationId="Builder.JunkCleanupTab">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel Margin="16,12,16,14">
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_CleanupHelp}" Style="{StaticResource FieldHelp}" Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding CleanupRows}" Focusable="False" AutomationProperties.AutomationId="Builder.CleanupRows">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type builder:CleanupRowViewModel}">
                                                    <DockPanel Margin="0,0,0,6" AutomationProperties.Name="{Binding Name}">
                                                        <CheckBox DockPanel.Dock="Left" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}"
                                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                                  ToolTip="{x:Static res:UiStrings.Builder_CleanupEnableTip}"
                                                                  AutomationProperties.Name="{x:Static res:UiStrings.Builder_CleanupEnableTip}" />
                                                        <Button DockPanel.Dock="Right" Content="×" Command="{Binding RemoveCommand}" Style="{StaticResource RowDangerButton}"
                                                                Margin="4,0,0,0" ToolTip="{x:Static res:UiStrings.Builder_CleanupRemoveTip}"
                                                                AutomationProperties.Name="{x:Static res:UiStrings.Builder_CleanupRemoveTip}" />
                                                        <Grid>
                                                            <TextBox x:Name="CleanupNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                     ToolTip="{Binding PathTip}"
                                                                     AutomationProperties.AutomationId="Builder.CleanupName"
                                                                     AutomationProperties.Name="{x:Static res:UiStrings.Builder_CleanupNamePlaceholder}" />
                                                            <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UiStrings.Builder_CleanupNamePlaceholder}"
                                                                       Tag="{Binding Text, ElementName=CleanupNameBox}" />
                                                        </Grid>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_CleanupEmpty}" Style="{StaticResource FieldHelp}" Margin="0,0,0,6"
                                                   Visibility="{Binding HasCleanupTargets, Converter={StaticResource BoolToCollapsed}}"
                                                   AutomationProperties.AutomationId="Builder.CleanupEmpty" />
                                        <Button Content="{x:Static res:UiStrings.Builder_RestoreDefaults}" Command="{Binding RestoreCleanupDefaultsCommand}"
                                                ToolTip="{x:Static res:UiStrings.Builder_RestoreDefaultsTip}" HorizontalAlignment="Left" Margin="0,4,0,0"
                                                AutomationProperties.AutomationId="Builder.RestoreDefaults" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Live Preview -->
            <Border Grid.Row="2" Style="{StaticResource LoaderStrip}" BorderThickness="0,1,0,0" Padding="16,8,16,12" MaxHeight="220">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{x:Static res:UiStrings.Builder_LivePreview}" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                    <controls:RibbonPreview x:Name="Preview" Mode="Builder" Profile="{Binding PreviewProfile}" Revision="{Binding PreviewRevision}"
                                            AutomationProperties.AutomationId="Builder.Preview">
                        <controls:RibbonPreview.TopBarContent>
                            <ContentControl Style="{StaticResource Pill}" Content="{x:Static res:UiStrings.Builder_ReadOnly}" />
                        </controls:RibbonPreview.TopBarContent>
                    </controls:RibbonPreview>
                </DockPanel>
            </Border>
        </Grid>

        <controls:IconPicker x:Name="IconPickerOverlay" DataContext="{Binding IconPicker}"
                             Visibility="{Binding DataContext.IsIconPickerOpen, ElementName=Root, Converter={StaticResource BoolToVisible}}" />
        <ContentControl Style="{StaticResource TransientBanner}" Content="{Binding Toast}" />
    </Grid>
</Window>
