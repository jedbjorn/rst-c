<!--
    rst-c's own (not vendored); the window chrome follows splash-it
    src/SplashIt.UI/Settings/SettingsWindow.xaml (splash-it commit ba86a71, MIT, same owner).
    The Profile Builder (spec #16, WU4), laid out one-for-one with profile_builder.html (1121-1328):
    the header (profile dropdown, "Profile Builder", Branding ▾ with its popover, Name, Tab, Export ZIP,
    Save, Exit), three panes (the 340 px Commands tree with its count and filter, the Panels list with
    + Add Panel and the panel cards, the 340 px Properties pane), the Live Preview strip at the bottom,
    and the toast on top. WU5 adds drag and drop (catalogue → panel or slot, slot reorder and move,
    panel reorder, with the drop-before / drop-after / drag-over markers), the icon picker overlay,
    and the RST Presets and Junk Cleanup modals behind the Configure buttons.
-->
<Window x:Class="RST.UI.Builder.ProfileBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        xmlns:controls="clr-namespace:RST.UI.Controls"
        xmlns:mvvm="clr-namespace:RST.UI.Mvvm"
        xmlns:builder="clr-namespace:RST.UI.Builder"
        xmlns:core="clr-namespace:RST.Core.Builder;assembly=RST.Core"
        Title="{x:Static res:UiStrings.Builder_WindowTitle}"
        Width="1450" Height="900" MinWidth="1100" MinHeight="600"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="ProfileBuilderWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A text box's placeholder: shown while the box (its Tag binding) is empty. -->
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Margin" Value="7,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- The Branding ▾ toggle: the kit's Button look (flat, bordered, hover, pressed); checked while the popover is open. -->
            <Style x:Key="BrandingToggle" TargetType="ToggleButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome" CornerRadius="3" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="Background" Value="{StaticResource PressedBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A pane's header row: the label on the left, its count or button on the right. -->
            <Style x:Key="PaneHeader" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Height" Value="42" />
            </Style>

            <!-- A Properties section: a divider under each. -->
            <Style x:Key="PropSection" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="16,14" />
            </Style>

            <Style x:Key="PropLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- ▲ ▼ × on the panel cards and slot rows. -->
            <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Padding" Value="5,1" />
                <Setter Property="MinWidth" Value="22" />
                <Setter Property="MinHeight" Value="22" />
                <Setter Property="Margin" Value="3,0,0,0" />
            </Style>
            <Style x:Key="RowDangerButton" TargetType="Button" BasedOn="{StaticResource RowButton}">
                <Setter Property="Foreground" Value="{StaticResource DangerForegroundBrush}" />
            </Style>

            <!-- The panel color swatch (opens the family color picker). -->
            <Style x:Key="SwatchButton" TargetType="Button">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chip" CornerRadius="3" Background="{TemplateBinding Background}"
                                    BorderBrush="{StaticResource ChipBorderBrush}" BorderThickness="1" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource ChipHoverBorderBrush}" />
                                    <Setter TargetName="Chip" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                A drop marker over a card or a slot row (the page's drop-before / drop-after / drag-over
                classes): a 2 px success-colored line above or below the target, or around it. It is an
                overlay, so the layout never shifts (gantt-it's row-border approach).
            -->
            <Style x:Key="DropMarkerBorder" TargetType="Border">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.Before}">
                        <Setter Property="BorderThickness" Value="0,2,0,0" />
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.After}">
                        <Setter Property="BorderThickness" Value="0,0,0,2" />
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding DropMarker}" Value="{x:Static core:DropMarker.Over}">
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                A slot row's name box. A stack slot's name is the link to its stack (spec #17): read-only,
                drawn without its box so it reads as a label (review N2; the styling of 39d92255).
            -->
            <Style x:Key="SlotNameBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsStack}" Value="True">
                        <Setter Property="IsReadOnly" Value="True" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Cursor" Value="Arrow" />
                        <Setter Property="Focusable" Value="False" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- A catalogue node: groups (native group, tab, panel) with a count pill; commands with their short id. -->
            <HierarchicalDataTemplate x:Key="CatalogNodeTemplate" DataType="{x:Type builder:CatalogNodeViewModel}"
                                      ItemsSource="{Binding Children}">
                <Grid Background="Transparent">
                    <DockPanel x:Name="GroupRow" Background="Transparent">
                        <DockPanel.InputBindings>
                            <MouseBinding Gesture="LeftClick" Command="{Binding ToggleCommand}" />
                        </DockPanel.InputBindings>
                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="{Binding Count}" Margin="6,0,0,0" />
                        <TextBlock x:Name="GroupLabel" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel x:Name="CommandRow" Background="Transparent" Visibility="Collapsed" ToolTip="{Binding ToolTip}"
                               PreviewMouseLeftButtonDown="OnDragSourceDown" MouseMove="OnDragSourceMove">
                        <DockPanel.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick"
                                          Command="{Binding DataContext.AddCatalogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}" />
                        </DockPanel.InputBindings>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ShortId}" Style="{StaticResource MutedText}" FontSize="10"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCommand}" Value="True">
                        <Setter TargetName="GroupRow" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="CommandRow" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Kind}" Value="Panel">
                        <Setter TargetName="GroupLabel" Property="FontWeight" Value="Normal" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The root carries the window color itself: the screenshot tests render it unclipped by the window. -->
    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <!-- Disabled while a save's auto-reload runs: no command or input reaches the window. -->
        <Grid x:Name="Body" IsEnabled="{Binding IsIdle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Style="{StaticResource LoaderStrip}" BorderThickness="0,0,0,1" Height="54" Padding="16,0">
                <DockPanel VerticalAlignment="Center" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox x:Name="ProfileSelector" Width="220" ItemsSource="{Binding ProfileOptions}"
                                  SelectedItem="{Binding SelectedProfileOption, Mode=TwoWay}" DisplayMemberPath="Display"
                                  ToolTip="{x:Static res:UiStrings.Builder_ProfileSelectorTip}"
                                  AutomationProperties.AutomationId="Builder.ProfileSelector"
                                  AutomationProperties.Name="{x:Static res:UiStrings.Builder_ProfileSelectorTip}" />
                        <Rectangle Width="1" Height="20" Fill="{StaticResource DividerBrush}" Margin="16,0" />
                        <TextBlock Text="{x:Static res:UiStrings.Builder_Title}" Style="{StaticResource SectionText}" FontSize="14"
                                   Margin="0" VerticalAlignment="Center" AutomationProperties.AutomationId="Builder.Title" />
                        <Rectangle Width="1" Height="20" Fill="{StaticResource DividerBrush}" Margin="16,0" />

                        <!-- Branding ▾ and its popover (machine-wide branding, not part of the profile). -->
                        <!--
                            The standard WPF pattern for a button that opens a StaysOpen=False popup: a ToggleButton
                            checked with the popup, and not hit-testable while it is open, so the click that
                            dismisses the popup cannot reach the button and reopen it (VM finding D2).
                        -->
                        <ToggleButton x:Name="BrandingButton" Style="{StaticResource BrandingToggle}"
                                      IsChecked="{Binding IsOpen, ElementName=BrandingPopup, Mode=TwoWay}"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=BrandingPopup, Converter={StaticResource InverseBool}}"
                                      ToolTip="{x:Static res:UiStrings.Builder_BrandingTip}" AutomationProperties.AutomationId="Builder.Branding"
                                      AutomationProperties.Name="{x:Static res:UiStrings.Builder_Branding}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="BrandingDot" Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center"
                                         StrokeThickness="1" AutomationProperties.AutomationId="Builder.BrandingDot">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="Transparent" />
                                            <Setter Property="Stroke" Value="{StaticResource StrongBorderBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasBranding}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                    <Setter Property="Stroke" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{x:Static res:UiStrings.Builder_Branding}" VerticalAlignment="Center" />
                                <TextBlock Text="▾" Margin="6,0,0,0" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="BrandingPopup" PlacementTarget="{Binding ElementName=BrandingButton}" Placement="Bottom"
                               VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" Opened="OnBrandingOpened" Closed="OnBrandingClosed"
                               PreviewKeyDown="OnBrandingPopoverKey"
                               IsOpen="{Binding IsBrandingOpen, Mode=TwoWay}">
                            <Border x:Name="BrandingPopover" Width="320" Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="16,14"
                                    Margin="0,0,8,8" TextElement.Foreground="{StaticResource TextBrush}" TextElement.FontFamily="Segoe UI"
                                    TextElement.FontSize="12" AutomationProperties.AutomationId="Builder.BrandingPopover">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                                </Border.Effect>
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:UiStrings.Builder_BrandingHeading}" Style="{StaticResource SectionText}" />
                                    <TextBlock Text="{x:Static res:UiStrings.Builder_Logo}" Style="{StaticResource PropLabel}" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="PickLogoButton" Content="{x:Static res:UiStrings.Builder_PickLogo}" Command="{Binding PickLogoCommand}"
                                                AutomationProperties.AutomationId="Builder.PickLogo" />
                                        <Button Content="{x:Static res:UiStrings.Builder_ClearLogo}" Command="{Binding ClearLogoCommand}"
                                                Style="{StaticResource IconButton}" Margin="4,0,0,0"
                                                ToolTip="{x:Static res:UiStrings.Builder_ClearLogoTip}"
                                                AutomationProperties.AutomationId="Builder.ClearLogo"
                                                AutomationProperties.Name="{x:Static res:UiStrings.Builder_ClearLogoTip}" />
                                        <TextBlock x:Name="LogoName" Text="{Binding LogoName}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="170" AutomationProperties.AutomationId="Builder.LogoName">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{x:Static res:UiStrings.Builder_Url}" Style="{StaticResource PropLabel}" Margin="0,12,0,4" />
                                    <Grid>
                                        <TextBox x:Name="BrandingUrlBox" mvvm:Behaviors.CommitOnEnter="True"
                                                 Text="{Binding BrandingUrl, UpdateSourceTrigger=LostFocus}"
                                                 AutomationProperties.AutomationId="Builder.BrandingUrl"
                                                 AutomationProperties.Name="{x:Static res:UiStrings.Builder_Url}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UiStrings.Builder_UrlPlaceholder}"
                                                   Tag="{Binding Text, ElementName=BrandingUrlBox}" />
                                    </Grid>
                                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                                        <Button Content="{x:Static res:UiStrings.Builder_Done}" Command="{Binding CloseBrandingCommand}"
                                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="72"
                                                AutomationProperties.AutomationId="Builder.BrandingDone" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>

                        <TextBlock Text="{x:Static res:UiStrings.Builder_Name}" Style="{StaticResource LabelText}" Margin="20,0,6,0" VerticalAlignment="Center" />
                        <Grid Width="200">
                            <TextBox x:Name="NameBox" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="Builder.Name" AutomationProperties.Name="{x:Static res:UiStrings.Builder_Name}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UiStrings.Builder_NamePlaceholder}"
                                       Tag="{Binding Text, ElementName=NameBox}" />
                        </Grid>
                        <TextBlock Text="{x:Static res:UiStrings.Builder_Tab}" Style="{StaticResource LabelText}" Margin="14,0,6,0" VerticalAlignment="Center" />
                        <Grid Width="170">
                            <TextBox x:Name="TabBox" Text="{Binding ProfileTab, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="Builder.Tab" AutomationProperties.Name="{x:Static res:UiStrings.Builder_Tab}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UiStrings.Builder_TabPlaceholder}"
                                       Tag="{Binding Text, ElementName=TabBox}" />
                        </Grid>
                    </StackPanel>

                    <!-- The family button bar: Export ZIP, then Save (the Primary), Exit rightmost. -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{x:Static res:UiStrings.Builder_ExportZip}" Command="{Binding ExportCommand}"
                                AutomationProperties.AutomationId="Builder.Export" />
                        <Button Content="{x:Static res:UiStrings.Builder_Save}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0" MinWidth="72" AutomationProperties.AutomationId="Builder.Save" />
                        <Button Content="{x:Static res:UiStrings.Builder_Exit}" Command="{Binding ExitCommand}" Margin="8,0,0,0" MinWidth="72"
                                ToolTip="{x:Static res:UiStrings.Builder_ExitTip}" AutomationProperties.AutomationId="Builder.Exit" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Body: Commands | Panels | Properties -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="340" />
                </Grid.ColumnDefinitions>

                <!-- Commands -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceAltBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <DockPanel VerticalAlignment="Center">
                                <ContentControl DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="{Binding CatalogCount}"
                                                AutomationProperties.AutomationId="Builder.CatalogCount" />
                                <TextBlock Text="{x:Static res:UiStrings.Builder_Commands}" Style="{StaticResource SectionText}" Margin="0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Grid DockPanel.Dock="Top" Margin="12,10,12,8">
                            <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="Builder.Filter"
                                     AutomationProperties.Name="{x:Static res:UiStrings.Builder_FilterPlaceholder}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UiStrings.Builder_FilterPlaceholder}"
                                       Tag="{Binding Text, ElementName=FilterBox}" />
                        </Grid>
                        <Grid>
                            <!-- Height-bounded by the pane, so the tree virtualizes (spec #16, AC7). -->
                            <TreeView x:Name="CatalogTreeView" ItemsSource="{Binding CatalogRoots}" ItemTemplate="{StaticResource CatalogNodeTemplate}"
                                      Padding="6,0,6,8" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.AutomationId="Builder.Catalog"
                                      AutomationProperties.Name="{x:Static res:UiStrings.Builder_Commands}">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                            </TreeView>
                            <TextBlock Text="{x:Static res:UiStrings.Builder_CatalogEmpty}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="20,24" VerticalAlignment="Top"
                                       Visibility="{Binding CatalogIsEmpty, Converter={StaticResource BoolToVisible}}"
                                       AutomationProperties.AutomationId="Builder.CatalogEmpty" />
                            <TextBlock Text="{Binding NoMatchesText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="20,24" VerticalAlignment="Top"
                                       Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVisible}}"
                                       AutomationProperties.AutomationId="Builder.NoMatches" />
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Panels -->
                <DockPanel Grid.Column="1">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                        <DockPanel VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Content="{x:Static res:UiStrings.Builder_AddPanel}" Command="{Binding AddPanelCommand}"
                                    AutomationProperties.AutomationId="Builder.AddPanel" />
                            <TextBlock Text="{x:Static res:UiStrings.Builder_Panels}" Style="{StaticResource SectionText}" Margin="0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="CanvasScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <Grid Margin="20,16,20,24">
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="32"
                                    Visibility="{Binding HasPanels, Converter={StaticResource BoolToCollapsed}}"
                                    AutomationProperties.AutomationId="Builder.CanvasEmpty">
                                <TextBlock Text="{x:Static res:UiStrings.Builder_CanvasEmpty}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" />
                            </Border>
                            <ItemsControl x:Name="PanelCards" ItemsSource="{Binding Panels}" Focusable="False"
                                          AutomationProperties.AutomationId="Builder.Panels"
                                          AutomationProperties.Name="{x:Static res:UiStrings.Builder_Panels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type builder:PanelCardViewModel}">
                                        <Grid x:Name="CardRoot" Margin="0,0,0,14" AutomationProperties.Name="{Binding Name}" AllowDrop="True"
                                              DragOver="OnPanelDragOver" DragLeave="OnDragLeave" Drop="OnPanelDrop">
                                            <Border x:Name="Card" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick" Command="{Binding SelectCommand}" />
                                                </Border.InputBindings>
                                                <StackPanel>
                                                    <Border Height="3" Background="{Binding ColorBrush}" CornerRadius="5,5,0,0"
                                                            AutomationProperties.AutomationId="Builder.PanelStripe" />
                                                    <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="0,0,0,1" Padding="12,8" Cursor="SizeAll"
                                                            PreviewMouseLeftButtonDown="OnDragSourceDown" MouseMove="OnDragSourceMove"
                                                            AutomationProperties.AutomationId="Builder.PanelHeader">
                                                        <DockPanel>
                                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding SlotCount}" Style="{StaticResource MutedText}" FontSize="11"
                                                                           Margin="8,0,6,0" VerticalAlignment="Center" />
                                                                <Button Content="▲" Command="{Binding MoveUpCommand}" Style="{StaticResource RowButton}"
                                                                        ToolTip="{x:Static res:UiStrings.Builder_MoveUp}"
                                                                        AutomationProperties.Name="{x:Static res:UiStrings.Builder_MoveUp}" />
                                                                <Button Content="▼" Command="{Binding MoveDownCommand}" Style="{StaticResource RowButton}"
                                                                        ToolTip="{x:Static res:UiStrings.Builder_MoveDown}"
                                                                        AutomationProperties.Name="{x:Static res:UiStrings.Builder_MoveDown}" />
                                                                <Button Content="×" Command="{Binding DeleteCommand}" Style="{StaticResource RowDangerButton}"
                                                                        ToolTip="{x:Static res:UiStrings.Builder_DeletePanelTip}"
                                                                        AutomationProperties.Name="{x:Static res:UiStrings.Builder_DeletePanelTip}" />
                                                            </StackPanel>
                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" FontSize="13"
                                                                     PreviewDragEnter="OnNameBoxDragOver" PreviewDragOver="OnNameBoxDragOver" PreviewDrop="OnNameBoxDrop"
                                                                     AutomationProperties.AutomationId="Builder.PanelName"
                                                                     AutomationProperties.Name="{x:Static res:UiStrings.Builder_Name}" />
                                                        </DockPanel>
                                                    </Border>
                                                    <Border Padding="12,10" MinHeight="56">
                                                        <Grid>
                                                            <TextBlock Text="{x:Static res:UiStrings.Builder_PanelEmpty}" Style="{StaticResource MutedText}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasSlots, Converter={StaticResource BoolToCollapsed}}" />
                                                            <ItemsControl ItemsSource="{Binding Slots}" Focusable="False">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type builder:SlotRowViewModel}">
                                                                        <Grid x:Name="SlotRow" Margin="0,0,0,6" AllowDrop="True" Background="Transparent"
                                                                              DragOver="OnSlotDragOver" DragLeave="OnDragLeave" Drop="OnSlotDrop"
                                                                              PreviewMouseLeftButtonDown="OnDragSourceDown" MouseMove="OnDragSourceMove">
                                                                        <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                                                BorderThickness="1" CornerRadius="4" Padding="8,4"
                                                                                AutomationProperties.Name="{Binding Name}">
                                                                            <DockPanel>
                                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                                                    <Button Content="▲" Command="{Binding MoveUpCommand}" Style="{StaticResource RowButton}"
                                                                                            ToolTip="{x:Static res:UiStrings.Builder_MoveUp}"
                                                                                            AutomationProperties.Name="{x:Static res:UiStrings.Builder_MoveUp}" />
                                                                                    <Button Content="▼" Command="{Binding MoveDownCommand}" Style="{StaticResource RowButton}"
                                                                                            ToolTip="{x:Static res:UiStrings.Builder_MoveDown}"
                                                                                            AutomationProperties.Name="{x:Static res:UiStrings.Builder_MoveDown}" />
                                                                                    <Button Content="×" Command="{Binding RemoveCommand}" Style="{StaticResource RowDangerButton}"
                                                                                            ToolTip="{x:Static res:UiStrings.Builder_RemoveSlotTip}"
                                                                                            AutomationProperties.Name="{x:Static res:UiStrings.Builder_RemoveSlotTip}" />
                                                                                </StackPanel>
                                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ShortCommandId}" ToolTip="{Binding CommandId}"
                                                                                           Style="{StaticResource MutedText}" FontSize="10" MaxWidth="200"
                                                                                           TextTrimming="CharacterEllipsis" Margin="8,0,4,0" VerticalAlignment="Center"
                                                                                           Visibility="{Binding ShowsCommandId, Converter={StaticResource BoolToVisible}}" />
                                                                                <!-- Tools: the Pick-icon button (thumbnail or "+", then the icon name or "Icon"). -->
                                                                                <Button DockPanel.Dock="Left" Command="{Binding PickIconCommand}" Padding="5,1" MinHeight="24"
                                                                                        Margin="0,0,8,0" ToolTip="{x:Static res:UiStrings.Builder_PickIconTip}"
                                                                                        Visibility="{Binding IsTool, Converter={StaticResource BoolToVisible}}"
                                                                                        AutomationProperties.AutomationId="Builder.PickIcon"
                                                                                        AutomationProperties.Name="{x:Static res:UiStrings.Builder_PickIconTip}">
                                                                                    <StackPanel Orientation="Horizontal">
                                                                                        <Image Source="{Binding IconThumbnail}" Width="14" Height="14" Margin="0,0,5,0"
                                                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                                                               Visibility="{Binding HasIconThumbnail, Converter={StaticResource BoolToVisible}}" />
                                                                                        <TextBlock Text="+" Width="14" TextAlignment="Center" Margin="0,0,5,0" Style="{StaticResource MutedText}"
                                                                                                   Visibility="{Binding HasIconThumbnail, Converter={StaticResource BoolToCollapsed}}" />
                                                                                        <TextBlock Text="{Binding IconLabel}" Foreground="{StaticResource AccentForegroundBrush}"
                                                                                                   MaxWidth="110" TextTrimming="CharacterEllipsis" />
                                                                                    </StackPanel>
                                                                                </Button>
                                                                                <!-- Other slot types: the type tag. -->
                                                                                <Border DockPanel.Dock="Left" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                                                        CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                                        Visibility="{Binding IsTool, Converter={StaticResource BoolToCollapsed}}">
                                                                                    <TextBlock Text="{Binding TypeTag}" Style="{StaticResource MutedText}" FontSize="10" />
                                                                                </Border>
                                                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                                         Style="{StaticResource SlotNameBox}" ToolTip="{Binding NameToolTip}"
                                                                                         PreviewDragEnter="OnNameBoxDragOver" PreviewDragOver="OnNameBoxDragOver" PreviewDrop="OnNameBoxDrop"
                                                                                         AutomationProperties.AutomationId="Builder.SlotName"
                                                                                         AutomationProperties.Name="{x:Static res:UiStrings.Builder_Name}" />
                                                                            </DockPanel>
                                                                        </Border>
                                                                        <Border Style="{StaticResource DropMarkerBorder}" CornerRadius="4"
                                                                                AutomationProperties.AutomationId="Builder.SlotDropMarker" />
                                                                        </Grid>
                                                                        <DataTemplate.Triggers>
                                                                            <DataTrigger Binding="{Binding IsDragSource}" Value="True">
                                                                                <Setter TargetName="SlotRow" Property="Opacity" Value="0.4" />
                                                                            </DataTrigger>
                                                                        </DataTemplate.Triggers>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <!-- The selected card's ring, over the border (no layout shift). -->
                                            <Border x:Name="Ring" BorderBrush="{StaticResource AccentForegroundBrush}" BorderThickness="2" CornerRadius="6"
                                                    IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.AutomationId="Builder.PanelRing" />
                                            <Border Style="{StaticResource DropMarkerBorder}" CornerRadius="6"
                                                    AutomationProperties.AutomationId="Builder.PanelDropMarker" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>

                <!-- Properties -->
                <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <TextBlock Text="{x:Static res:UiStrings.Builder_Properties}" Style="{StaticResource SectionText}" Margin="0"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel>
                                <!-- Profile -->
                                <Border Style="{StaticResource PropSection}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_ProfileSection}" Style="{StaticResource SectionText}" />
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_MinRevitVersion}" Style="{StaticResource PropLabel}" />
                                        <TextBox Text="{Binding MinVersion, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.AutomationId="Builder.MinVersion"
                                                 AutomationProperties.Name="{x:Static res:UiStrings.Builder_MinRevitVersion}" />
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_PanelOpacity}" Style="{StaticResource PropLabel}" Margin="0,10,0,4" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding PanelOpacity}" MinWidth="28" TextAlignment="Right"
                                                       VerticalAlignment="Center" AutomationProperties.AutomationId="Builder.OpacityValue" />
                                            <Slider Minimum="10" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5"
                                                    IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                    Value="{Binding PanelOpacity, Mode=TwoWay}"
                                                    AutomationProperties.AutomationId="Builder.Opacity"
                                                    AutomationProperties.Name="{x:Static res:UiStrings.Builder_PanelOpacity}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Selected Panel -->
                                <Border Style="{StaticResource PropSection}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_SelectedPanel}" Style="{StaticResource SectionText}" />
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_NoPanelSelected}" Style="{StaticResource MutedText}"
                                                   Visibility="{Binding HasSelectedPanel, Converter={StaticResource BoolToCollapsed}}"
                                                   AutomationProperties.AutomationId="Builder.NoPanelSelected" />
                                        <StackPanel Visibility="{Binding HasSelectedPanel, Converter={StaticResource BoolToVisible}}"
                                                    AutomationProperties.AutomationId="Builder.SelectedPanel">
                                            <TextBlock Text="{x:Static res:UiStrings.Builder_Name}" Style="{StaticResource PropLabel}" />
                                            <TextBox Text="{Binding SelectedPanel.Name, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.AutomationId="Builder.SelectedPanelName"
                                                     AutomationProperties.Name="{x:Static res:UiStrings.Builder_Name}" />
                                            <TextBlock Text="{x:Static res:UiStrings.Builder_Color}" Style="{StaticResource PropLabel}" Margin="0,10,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="ColorSwatch" Style="{StaticResource SwatchButton}" Background="{Binding SelectedPanel.ColorBrush}"
                                                        Command="{Binding PickColorCommand}" ToolTip="{Binding SelectedPanel.ColorHex}"
                                                        AutomationProperties.AutomationId="Builder.ColorSwatch"
                                                        AutomationProperties.Name="{x:Static res:UiStrings.Builder_Color}" />
                                                <TextBox Width="96" Margin="8,0,0,0" mvvm:Behaviors.CommitOnEnter="True"
                                                         Text="{Binding SelectedPanel.ColorHex, UpdateSourceTrigger=LostFocus}"
                                                         AutomationProperties.AutomationId="Builder.ColorHex"
                                                         AutomationProperties.Name="{x:Static res:UiStrings.Color_Hex}" />
                                            </StackPanel>
                                            <TextBlock Text="{x:Static res:UiStrings.Builder_UrlButtons}" Style="{StaticResource PropLabel}" Margin="0,10,0,4" />
                                            <Button Content="{x:Static res:UiStrings.Builder_AddUrlButton}" Command="{Binding OpenUrlEditorCommand}"
                                                    HorizontalAlignment="Left" AutomationProperties.AutomationId="Builder.AddUrlButton" />
                                            <!-- The inline URL button editor. -->
                                            <Border x:Name="UrlEditor" Style="{StaticResource Panel}" Padding="10" Margin="0,8,0,0"
                                                    Visibility="{Binding IsUrlEditorOpen, Converter={StaticResource BoolToVisible}}"
                                                    AutomationProperties.AutomationId="Builder.UrlEditor">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBox x:Name="UrlLabelBox" Text="{Binding UrlLabel, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="Builder.UrlLabel"
                                                                 AutomationProperties.Name="{x:Static res:UiStrings.Builder_UrlLabelPlaceholder}" />
                                                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UiStrings.Builder_UrlLabelPlaceholder}"
                                                                   Tag="{Binding Text, ElementName=UrlLabelBox}" />
                                                    </Grid>
                                                    <Grid Margin="0,6,0,0">
                                                        <TextBox x:Name="UrlAddressBox" Text="{Binding UrlAddress, UpdateSourceTrigger=PropertyChanged}"
                                                                 AutomationProperties.AutomationId="Builder.UrlAddress"
                                                                 AutomationProperties.Name="{x:Static res:UiStrings.Builder_Url}" />
                                                        <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UiStrings.Builder_UrlPlaceholder}"
                                                                   Tag="{Binding Text, ElementName=UrlAddressBox}" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                        <Button Content="{x:Static res:UiStrings.Builder_UrlAdd}" Command="{Binding AddUrlCommand}"
                                                                Style="{StaticResource PrimaryButton}" MinWidth="64"
                                                                AutomationProperties.AutomationId="Builder.UrlAdd" />
                                                        <Button Content="{x:Static res:UiStrings.Common_Cancel}" Command="{Binding CancelUrlEditorCommand}"
                                                                Margin="8,0,0,0" MinWidth="64" AutomationProperties.AutomationId="Builder.UrlCancel" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- RST Presets -->
                                <Border Style="{StaticResource PropSection}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_Presets}" Style="{StaticResource SectionText}" />
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsHelp}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PresetsSummary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="Builder.PresetsSummary" />
                                        <Button x:Name="ConfigurePresets" Content="{x:Static res:UiStrings.Builder_Configure}" Command="{Binding ConfigurePresetsCommand}"
                                                HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.AutomationId="Builder.ConfigurePresets" />
                                    </StackPanel>
                                </Border>

                                <!-- Junk Cleanup -->
                                <Border Style="{StaticResource PropSection}" BorderThickness="0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_Cleanup}" Style="{StaticResource SectionText}" />
                                        <TextBlock Text="{x:Static res:UiStrings.Builder_CleanupHelp}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CleanupSummary}" Margin="0,6,0,0" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="Builder.CleanupSummary" />
                                        <Button Content="{x:Static res:UiStrings.Builder_Configure}" Command="{Binding ConfigureCleanupCommand}"
                                                HorizontalAlignment="Left" Margin="0,10,0,0" AutomationProperties.AutomationId="Builder.ConfigureCleanup" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Live Preview -->
            <Border Grid.Row="2" Style="{StaticResource LoaderStrip}" BorderThickness="0,1,0,0" Padding="16,8,16,12" MaxHeight="220">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{x:Static res:UiStrings.Builder_LivePreview}" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                    <controls:RibbonPreview x:Name="Preview" Mode="Builder" Profile="{Binding PreviewProfile}" Revision="{Binding PreviewRevision}"
                                            AutomationProperties.AutomationId="Builder.Preview">
                        <controls:RibbonPreview.TopBarContent>
                            <ContentControl Style="{StaticResource Pill}" Content="{x:Static res:UiStrings.Builder_ReadOnly}" />
                        </controls:RibbonPreview.TopBarContent>
                    </controls:RibbonPreview>
                </DockPanel>
            </Border>
        </Grid>

        <controls:IconPicker x:Name="IconPickerOverlay" DataContext="{Binding IconPicker}"
                             Visibility="{Binding DataContext.IsIconPickerOpen, ElementName=Root, Converter={StaticResource BoolToVisible}}" />
        <ContentControl Style="{StaticResource TransientBanner}" Content="{Binding Toast}" />
    </Grid>
</Window>
