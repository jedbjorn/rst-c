<!--
    rst-c's own (not vendored); laid out after the kit's MessageDialog (splash-it
    src/SplashIt.UI/Dialogs/MessageDialog.xaml, splash-it commit ba86a71, MIT, same owner) and the
    approved spike's Create new tool dialog (decision #25).
    The Builder's Custom Tool dialog (feature #18, spec #19, WU4; decision #20): + Create new, and ✎ on a
    Custom Tools row or a placed custom tool (edit everywhere). The heading, the URL / Email switch, the
    label, the address with its live "Opens: …" line, the icon (a click opens the icon picker), then
    Create's note (the panel it goes to) or Edit's warning (every profile that will change, and the ones
    that will not), then Create / Update in N profiles with Cancel.
-->
<Window x:Class="RST.UI.Builder.CustomToolDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        xmlns:mvvm="clr-namespace:RST.UI.Mvvm"
        Title="{Binding Title}"
        SizeToContent="Height" Width="440" MinHeight="200"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="CustomToolDialog">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A text box's placeholder: shown while the box (its Tag binding) is empty. -->
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Margin" Value="7,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                <Setter Property="Margin" Value="0,10,0,4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        IsEnabled="{Binding CanConfirm}" Click="OnConfirm" MinWidth="88"
                        AutomationProperties.AutomationId="CustomToolDialog.Confirm" />
                <Button Content="{x:Static res:UiStrings.Common_Cancel}" IsCancel="True" Margin="8,0,0,0" MinWidth="88"
                        AutomationProperties.AutomationId="CustomToolDialog.Cancel" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionText}" FontSize="14"
                           AutomationProperties.AutomationId="CustomToolDialog.Heading" />

                <Border Style="{StaticResource RangePillGroup}" Margin="0,4,0,0" AutomationProperties.AutomationId="CustomToolDialog.Kind">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource RangePill}" GroupName="CustomToolKind" IsChecked="{Binding IsUrl}"
                                     Content="{x:Static res:UiStrings.Builder_ToolKindUrlOption}"
                                     AutomationProperties.AutomationId="CustomToolDialog.Url" />
                        <RadioButton Style="{StaticResource RangePill}" GroupName="CustomToolKind" IsChecked="{Binding IsEmail}"
                                     Content="{x:Static res:UiStrings.Builder_ToolKindEmailOption}" Margin="0"
                                     AutomationProperties.AutomationId="CustomToolDialog.Email" />
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Static res:UiStrings.Builder_ToolLabel}" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                <Grid>
                    <TextBox x:Name="LabelBox" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="CustomToolDialog.Label"
                             AutomationProperties.Name="{x:Static res:UiStrings.Builder_ToolLabel}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UiStrings.Builder_ToolLabelPlaceholder}"
                               Tag="{Binding Text, ElementName=LabelBox}" />
                </Grid>

                <TextBlock Text="{Binding AddressLabel}" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <TextBox x:Name="AddressBox" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.AutomationId="CustomToolDialog.Address"
                             AutomationProperties.Name="{Binding AddressLabel}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding AddressPlaceholder}"
                               Tag="{Binding Text, ElementName=AddressBox}" />
                </Grid>
                <TextBlock x:Name="OpensLine" Text="{Binding Opens}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Opens}"
                           Visibility="{Binding HasOpens, Converter={StaticResource BoolToVisible}}"
                           AutomationProperties.AutomationId="CustomToolDialog.Opens" />

                <TextBlock Text="{x:Static res:UiStrings.Builder_ToolIcon}" Style="{StaticResource FieldLabel}" />
                <Button x:Name="IconButton" HorizontalAlignment="Left" Padding="8,3" Click="OnPickIcon"
                        ToolTip="{x:Static res:UiStrings.Builder_PickIconTip}"
                        AutomationProperties.AutomationId="CustomToolDialog.Icon"
                        AutomationProperties.Name="{x:Static res:UiStrings.Builder_PickIconTip}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}}" />
                        <TextBlock Text="{Binding IconName}" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="CustomToolDialog.IconName" />
                    </StackPanel>
                </Button>

                <TextBlock x:Name="ErrorLine" Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}"
                           AutomationProperties.AutomationId="CustomToolDialog.Error" />

                <!-- Create: where the tool goes. -->
                <Border Style="{StaticResource InfoBanner}" Margin="0,14,0,0" Padding="10,8"
                        Visibility="{Binding HasNote, Converter={StaticResource BoolToVisible}}"
                        AutomationProperties.AutomationId="CustomToolDialog.Note">
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" />
                </Border>

                <!-- Edit: every profile that will change, then the ones that will not and why. -->
                <Border Style="{StaticResource WarningBanner}" Margin="0,14,0,0" Padding="10,8"
                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisible}}"
                        AutomationProperties.AutomationId="CustomToolDialog.Warning">
                    <StackPanel>
                        <TextBlock x:Name="WarningText" Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{StaticResource WarningTextBrush}" />
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding HasRefusals, Converter={StaticResource BoolToVisible}}"
                                    AutomationProperties.AutomationId="CustomToolDialog.Refusals">
                            <TextBlock Text="{x:Static res:UiStrings.Builder_ToolNotChanged}" FontWeight="SemiBold"
                                       Foreground="{StaticResource WarningTextBrush}" />
                            <ItemsControl ItemsSource="{Binding Refusals}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{StaticResource WarningTextBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
