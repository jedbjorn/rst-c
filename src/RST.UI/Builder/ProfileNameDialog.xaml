<!--
    rst-c's own (not vendored); laid out after the kit's MessageDialog (splash-it
    src/SplashIt.UI/Dialogs/MessageDialog.xaml, splash-it commit ba86a71, MIT, same owner).
    The Builder's Rename… and Duplicate… dialog (feature #18, spec #19, WU2): the heading, the help
    line, the name box, the refusal under it (a name is required and must be unique among the saved
    profiles), and Rename / Duplicate with Cancel.
-->
<Window x:Class="RST.UI.Builder.ProfileNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        xmlns:mvvm="clr-namespace:RST.UI.Mvvm"
        Title="{Binding Title}"
        SizeToContent="Height" Width="440" MinHeight="160"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="ProfileNameDialog">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        Click="OnConfirm" MinWidth="88" AutomationProperties.AutomationId="NameDialog.Confirm" />
                <Button Content="{x:Static res:UiStrings.Common_Cancel}" IsCancel="True" Margin="8,0,0,0" MinWidth="88"
                        AutomationProperties.AutomationId="NameDialog.Cancel" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionText}" FontSize="14"
                           AutomationProperties.AutomationId="NameDialog.Heading" />
                <TextBlock Text="{Binding Help}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="NameDialog.Help" />
                <TextBlock Text="{x:Static res:UiStrings.Builder_ProfileName}" Style="{StaticResource LabelText}" Margin="0,14,0,4"
                           HorizontalAlignment="Left" />
                <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         mvvm:Behaviors.HasError="{Binding HasError}"
                         AutomationProperties.AutomationId="NameDialog.Name"
                         AutomationProperties.Name="{x:Static res:UiStrings.Builder_ProfileName}" />
                <TextBlock x:Name="ErrorLine" Text="{Binding Error}" Style="{StaticResource ErrorText}" Margin="0,6,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisible}}"
                           AutomationProperties.AutomationId="NameDialog.Error" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
