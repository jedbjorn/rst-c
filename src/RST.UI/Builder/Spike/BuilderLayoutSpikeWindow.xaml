<!--
    F18 Builder UX Redesign, Phase 1 fidelity spike (spec #19). THROWAWAY: layout only, static sample
    data, no behaviour; never merged. Draws the approved mockup (builder.html v2.2: Profile pane B·Tabs,
    Tiles, rename/duplicate in the profile menu, header Tint = AccentSoft with an InfoBorder line,
    decisions #22-#24) with the house styles of Theme.xaml. Overlays (menus, dialogs) are drawn in the
    window's root grid so the off-screen capture renders them in place.
-->
<Window x:Class="RST.UI.Builder.Spike.BuilderLayoutSpikeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RST.UI.Controls"
        xmlns:spike="clr-namespace:RST.UI.Builder.Spike"
        Title="RST — Profile Builder (F18 spike)"
        Width="1450" Height="900" MinWidth="1100" MinHeight="600"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Margin" Value="7,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PaneHeader" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="Height" Value="42" />
            </Style>

            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LabelText}">
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <Style x:Key="Help" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,3,0,0" />
            </Style>

            <!-- ✎ × ▲ ▼ on cards, tiles, stacks and list rows. -->
            <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="MinWidth" Value="20" />
                <Setter Property="MinHeight" Value="20" />
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style x:Key="GhostDanger" TargetType="Button" BasedOn="{StaticResource Ghost}">
                <Setter Property="Foreground" Value="{StaticResource DangerForegroundBrush}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!-- A name edited in place: borderless until hovered or focused. -->
            <Style x:Key="InlineName" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="IsReadOnly" Value="True" />
            </Style>

            <Style x:Key="KindTag" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="Handle" TargetType="TextBlock">
                <Setter Property="Text" Value="⠿" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Menus (⚙ and the profile dropdown). -->
            <Style x:Key="MenuBox" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MenuHeading" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Margin" Value="10,6,10,3" />
            </Style>
            <Style x:Key="MenuRow" TargetType="Border">
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style x:Key="MenuNote" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Margin" Value="16,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="DockPanel.Dock" Value="Right" />
            </Style>

            <!-- Dialog content over the scrim. -->
            <Style x:Key="Modal" TargetType="Border">
                <Setter Property="Width" Value="440" />
                <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" />
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ModalTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="16,14,16,6" />
                <Setter Property="DockPanel.Dock" Value="Top" />
            </Style>
            <Style x:Key="ModalFooter" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="DockPanel.Dock" Value="Bottom" />
            </Style>

            <!-- A catalogue node, as today's CatalogNodeTemplate. -->
            <HierarchicalDataTemplate x:Key="SpikeNodeTemplate" DataType="{x:Type spike:SpikeNode}" ItemsSource="{Binding Children}">
                <Grid Background="Transparent">
                    <DockPanel x:Name="GroupRow" Background="Transparent">
                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="{Binding Count}" Margin="6,0,0,0" />
                        <TextBlock x:Name="GroupLabel" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <DockPanel x:Name="CommandRow" Background="Transparent" Visibility="Collapsed">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ShortId}" Style="{StaticResource MutedText}" FontSize="10"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Grid>
                <HierarchicalDataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsCommand}" Value="True">
                        <Setter TargetName="GroupRow" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="CommandRow" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsPanel}" Value="True">
                        <Setter TargetName="GroupLabel" Property="FontWeight" Value="Normal" />
                    </DataTrigger>
                </HierarchicalDataTemplate.Triggers>
            </HierarchicalDataTemplate>

            <!-- A tool tile: 32 px icon, the name box, the muted source line; ✎ × on hover. -->
            <DataTemplate DataType="{x:Type spike:SpikeTool}">
                <Grid Width="100" Margin="0,0,10,10" VerticalAlignment="Top">
                    <Border x:Name="Tile" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="4,9,4,5" SnapsToDevicePixels="True">
                        <StackPanel>
                            <Grid Width="32" Height="32" HorizontalAlignment="Center">
                                <Image Source="{Binding Image}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Rectangle x:Name="NoIcon" Stroke="{StaticResource BorderBrush}" StrokeDashArray="3 2" RadiusX="3" RadiusY="3"
                                           Visibility="Collapsed" />
                            </Grid>
                            <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource InlineName}" TextAlignment="Center"
                                     FontSize="11" Padding="2,0" MinHeight="20" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" FontSize="9" HorizontalAlignment="Center"
                                       MaxWidth="90" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="Corner" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,1,1,0" Visibility="Collapsed">
                        <Button x:Name="EditButton" Content="✎" Style="{StaticResource Ghost}" ToolTip="Edit this custom tool (everywhere it is used)"
                                Visibility="Collapsed" />
                        <Button Content="×" Style="{StaticResource GhostDanger}" ToolTip="Remove from this panel" />
                    </StackPanel>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                        <Setter TargetName="NoIcon" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding ShowHover}" Value="True">
                        <Setter TargetName="Corner" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource StrongBorderBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCustom}" Value="True">
                        <Setter TargetName="EditButton" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- A stack group: "STACK · n/3" with ✎ ×, then a row per tool (16 px icon, name box). -->
            <DataTemplate DataType="{x:Type spike:SpikeStack}">
                <Border Width="200" Margin="0,0,10,10" VerticalAlignment="Top" Background="{StaticResource SurfaceAltBrush}"
                        BorderBrush="{StaticResource StrongBorderBrush}" BorderThickness="1,3,1,1" CornerRadius="4" Padding="6,3,6,3"
                        SnapsToDevicePixels="True">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,2">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="✎" Style="{StaticResource Ghost}" ToolTip="Edit stack" />
                                <Button Content="×" Style="{StaticResource GhostDanger}" ToolTip="Remove stack (its tools stay on the panel)" />
                            </StackPanel>
                            <TextBlock Text="{Binding Header}" Style="{StaticResource MutedText}" FontSize="9" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Tools}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="3" Padding="4,1" Margin="0,0,0,3" ToolTip="{Binding Source}">
                                        <DockPanel>
                                            <Image Source="{Binding Image}" Width="16" Height="16" Margin="0,0,4,0"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource InlineName}" FontSize="11"
                                                     Padding="2,0" MinHeight="20" />
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- A labelled switch row (Loader defaults' RSTify tabs). -->
            <DataTemplate x:Key="SwitchRow" DataType="{x:Type spike:SpikeSwitch}">
                <DockPanel Margin="0,4">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=OneWay}" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </DockPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Tint (AccentSoft) with an InfoBorder bottom line (decision #24). -->
            <Border x:Name="Header" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource InfoBorderBrush}"
                    BorderThickness="0,0,0,1" Height="54" Padding="16,0">
                <DockPanel VerticalAlignment="Center" LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="GearButton" Width="30" MinWidth="30" Padding="0" ToolTip="Settings for this machine">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                        <Button x:Name="ProfileButton" Width="250" Margin="10,0,0,0" HorizontalContentAlignment="Stretch" ToolTip="Switch profile">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="▾" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="Structure" FontWeight="SemiBold" /><Run Text="  (loaded)" Foreground="{StaticResource MutedTextBrush}" />
                                </TextBlock>
                            </DockPanel>
                        </Button>
                        <Button Content="Export ZIP" Margin="10,0,0,0" />
                        <Rectangle Width="1" Height="20" Fill="{StaticResource DividerBrush}" Margin="16,0" />
                        <TextBlock Text="Profile Builder" Style="{StaticResource SectionText}" FontSize="14" Margin="0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource WarningTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Unsaved changes" Foreground="{StaticResource WarningTextBrush}" FontSize="11" VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="72" />
                        <Button Content="Exit" MinWidth="72" Margin="8,0,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Body: Commands | Panels | Profile -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>

                <!-- Commands -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceAltBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <DockPanel VerticalAlignment="Center">
                                <ContentControl DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="28" />
                                <TextBlock Text="Commands" Style="{StaticResource SectionText}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <DockPanel DockPanel.Dock="Top" Margin="12,10,12,8">
                            <Button DockPanel.Dock="Right" Content="+ Create new" Margin="6,0,0,0" ToolTip="Create a URL or email tool" />
                            <Grid>
                                <TextBox />
                                <TextBlock Style="{StaticResource Hint}" Text="Filter…" />
                            </Grid>
                        </DockPanel>

                        <!-- Custom Tools: pinned first, expanded, set apart (InfoSoft / InfoBorder). -->
                        <Border DockPanel.Dock="Top" Margin="8,0,8,8" Background="{StaticResource InfoSoftBrush}"
                                BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="2,3,2,4">
                            <StackPanel>
                                <DockPanel Margin="0,0,4,2" MinHeight="22">
                                    <ContentControl DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="4" />
                                    <Path DockPanel.Dock="Left" Data="M 0,0 L 4,4 L 0,8" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="8" Height="8"
                                          Margin="5,0,7,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="90" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock Text="Custom Tools" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <TextBlock Text="URL and email tools found in your profiles. Drag onto a panel." Style="{StaticResource Help}"
                                           FontSize="10" Margin="22,0,8,4" />
                                <ItemsControl ItemsSource="{Binding CustomTools}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type spike:SpikeCustomTool}">
                                            <Border x:Name="Row" Padding="20,2,4,2" CornerRadius="3" Background="Transparent" MinHeight="24">
                                                <DockPanel>
                                                    <StackPanel x:Name="Acts" DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0"
                                                                Visibility="Collapsed">
                                                        <Button Content="✎" Style="{StaticResource Ghost}" ToolTip="Edit this tool everywhere it is used" />
                                                        <Button Content="×" Style="{StaticResource GhostDanger}" ToolTip="Remove from every profile" />
                                                    </StackPanel>
                                                    <Border DockPanel.Dock="Right" Style="{StaticResource KindTag}">
                                                        <TextBlock Text="{Binding Kind}" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
                                                    </Border>
                                                    <Image DockPanel.Dock="Left" Source="{Binding Image}" Width="16" Height="16" Margin="0,0,6,0"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding ShowHover}" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                                                    <Setter TargetName="Acts" Property="Visibility" Value="Visible" />
                                                    <Setter TargetName="Row" Property="ToolTip" Value="mailto:bim@studio.example&#x0a;Used in: Architecture, Structure" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TreeView x:Name="CatalogTreeView" ItemsSource="{Binding Catalog}" ItemTemplate="{StaticResource SpikeNodeTemplate}"
                                  Padding="6,0,6,8" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=OneTime}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </DockPanel>
                </Border>

                <!-- Panels on tab: cards in Tiles -->
                <DockPanel Grid.Column="1">
                    <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                        <DockPanel VerticalAlignment="Center">
                            <Button DockPanel.Dock="Right" Content="+ Add Panel" />
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Panels" Style="{StaticResource SectionText}" Margin="0" VerticalAlignment="Center" />
                                <TextBlock Text="on tab" Style="{StaticResource MutedText}" FontSize="11" Margin="8,0,8,0" VerticalAlignment="Center" />
                                <Border Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                                        CornerRadius="3" Padding="10,2" VerticalAlignment="Center" Cursor="Hand"
                                        ToolTip="Edit the tab name on the Profile pane's General tab">
                                    <TextBlock Text="Studio Struct" Foreground="{StaticResource AccentForegroundBrush}" />
                                </Border>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="CanvasScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Panels}" Margin="20,16,20,24" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type spike:SpikePanel}">
                                    <Grid Margin="0,0,0,14">
                                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="6" SnapsToDevicePixels="True">
                                            <StackPanel>
                                                <Border Height="4" Background="{Binding ColorBrush}" CornerRadius="5,5,0,0" />
                                                <Border Background="{StaticResource SurfaceAltBrush}" BorderBrush="{StaticResource DividerBrush}"
                                                        BorderThickness="0,0,0,1" Padding="10,6">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="+ New Stack" ToolTip="Group 2–3 of this panel’s tools into a stack" />
                                                            <StackPanel x:Name="HoverActs" Orientation="Horizontal" Margin="8,0,0,0" Opacity="0">
                                                                <Button Content="▲" Style="{StaticResource Ghost}" ToolTip="Move left on the ribbon" IsEnabled="False" />
                                                                <Button Content="▼" Style="{StaticResource Ghost}" ToolTip="Move right on the ribbon" />
                                                                <Button Content="×" Style="{StaticResource GhostDanger}" ToolTip="Delete panel" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Style="{StaticResource Handle}" Margin="0,0,8,0" ToolTip="Drag to reorder panels" />
                                                        <Border Width="22" Height="22" CornerRadius="4" Background="{Binding ColorBrush}"
                                                                BorderBrush="{StaticResource ChipBorderBrush}" BorderThickness="1" Margin="0,0,6,0"
                                                                VerticalAlignment="Center" ToolTip="Panel colour" />
                                                        <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource InlineName}" Width="220"
                                                                 FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ToolCount}" Style="{StaticResource MutedText}" FontSize="11"
                                                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </Border>
                                                <ItemsControl ItemsSource="{Binding Items}" Margin="12,10,2,0" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="Ring" BorderBrush="{StaticResource AccentForegroundBrush}" BorderThickness="2" CornerRadius="6"
                                                IsHitTestVisible="False" Visibility="Collapsed" />
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="HoverActs" Property="Opacity" Value="1" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <!-- Profile pane: General | Loader defaults | Junk cleanup -->
                <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Background="{StaticResource SurfaceBrush}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeader}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Profile" Style="{StaticResource SectionText}" Margin="0" VerticalAlignment="Center" />
                                <TextBlock Text="· editing Structure" Style="{StaticResource MutedText}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TabControl x:Name="ProfileTabs" Padding="0" Margin="0,4,0,0">
                            <TabItem Header="General" Margin="10,0,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel Margin="16,14,16,14">
                                        <TextBlock Text="Profile name" Style="{StaticResource FieldLabel}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Rename…" Margin="6,0,0,0" />
                                            <TextBox Text="Structure" IsReadOnly="True" />
                                        </DockPanel>
                                        <TextBlock Text="Shown in the Loader’s list." Style="{StaticResource Help}" />

                                        <TextBlock Text="Ribbon tab name" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <TextBox Text="Studio Struct" />

                                        <TextBlock Text="Panel colour strength" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="60%" MinWidth="36" TextAlignment="Right" VerticalAlignment="Center" />
                                            <Slider Minimum="10" Maximum="100" SmallChange="5" LargeChange="10" TickFrequency="5"
                                                    IsSnapToTickEnabled="True" Value="60" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="One value for every panel. Users can override it in the Loader." Style="{StaticResource Help}" />

                                        <TextBlock Text="Min Revit version" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                        <TextBox Text="2.1.0" />
                                        <TextBlock Text="Informational — the Loader shows it; nothing enforces it." Style="{StaticResource Help}" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Loader defaults">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel Margin="16,12,16,14">
                                        <TextBlock Text="What the Loader offers the first time a user picks this profile." Style="{StaticResource Help}"
                                                   Margin="0,0,0,10" />
                                        <DockPanel Margin="0,0,0,4">
                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="True" VerticalAlignment="Center" />
                                            <StackPanel>
                                                <TextBlock Text="Disable unused add-ins" FontWeight="SemiBold" />
                                                <TextBlock Text="Starting position of the Loader’s switch" Style="{StaticResource Help}" Margin="0,1,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Text="Hide these tabs (RSTify)" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                                        <ItemsControl ItemsSource="{Binding HiddenTabs}" ItemTemplate="{StaticResource SwitchRow}" Focusable="False" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Junk cleanup">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                    <StackPanel Margin="16,12,16,14">
                                        <TextBlock Text="Targets for the Health tool’s Clean Junk Files." Style="{StaticResource Help}" Margin="0,0,0,10" />
                                        <ItemsControl ItemsSource="{Binding Cleanup}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type spike:SpikeSwitch}">
                                                    <DockPanel Margin="0,0,0,6">
                                                        <CheckBox DockPanel.Dock="Left" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsOn, Mode=OneWay}"
                                                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                                                        <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GhostDanger}" Margin="4,0,0,0"
                                                                ToolTip="Remove target" />
                                                        <TextBox Text="{Binding Label, Mode=OneWay}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Restore defaults" HorizontalAlignment="Left" Margin="0,4,0,0" />
                                        <TextBlock Text="Fixed preset paths. The Health tool’s Clean Junk Files offers the ones switched on."
                                                   Style="{StaticResource Help}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Live Preview (unchanged) -->
            <Border Grid.Row="2" Style="{StaticResource LoaderStrip}" BorderThickness="0,1,0,0" Padding="16,8,16,12" MaxHeight="220">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Live Preview" Style="{StaticResource SectionText}" Margin="0,0,0,6" />
                    <controls:RibbonPreview x:Name="Preview" Mode="Builder">
                        <controls:RibbonPreview.TopBarContent>
                            <ContentControl Style="{StaticResource Pill}" Content="Read only" />
                        </controls:RibbonPreview.TopBarContent>
                    </controls:RibbonPreview>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ⚙ menu: machine settings, not saved in profiles (decision #23). -->
        <Border x:Name="SettingsMenu" Style="{StaticResource MenuBox}" Margin="16,45,0,0" MinWidth="250" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="THIS MACHINE — NOT SAVED IN PROFILES" Style="{StaticResource MenuHeading}" />
                <Border Style="{StaticResource MenuRow}" Background="{StaticResource HoverBrush}">
                    <DockPanel>
                        <TextBlock Text="logo + link on every tab" Style="{StaticResource MenuNote}" />
                        <TextBlock Text="Branding…" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource MenuRow}">
                    <TextBlock Text="Builder preferences…" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Profile menu: switch, New, Rename, Duplicate. -->
        <Border x:Name="ProfileMenu" Style="{StaticResource MenuBox}" Margin="56,45,0,0" MinWidth="300" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="SWITCH PROFILE" Style="{StaticResource MenuHeading}" />
                <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type spike:SpikeProfileRow}">
                            <Border Style="{StaticResource MenuRow}">
                                <DockPanel>
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MenuNote}" />
                                    <TextBlock Text="{Binding Check}" Width="16" />
                                    <TextBlock x:Name="ProfileName" Text="{Binding Name}" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="ProfileName" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,4" />
                <Border Style="{StaticResource MenuRow}">
                    <TextBlock Text="+ New profile" />
                </Border>
                <Border Style="{StaticResource MenuRow}" Background="{StaticResource HoverBrush}">
                    <DockPanel>
                        <TextBlock Text="same profile, new name" Style="{StaticResource MenuNote}" />
                        <TextBlock Text="Rename…" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource MenuRow}">
                    <DockPanel>
                        <TextBlock Text="a copy; original kept" Style="{StaticResource MenuNote}" />
                        <TextBlock Text="Duplicate…" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Create new tool (URL / Email). -->
        <Grid x:Name="CreateToolDialog" Background="{StaticResource ScrimBrush}" Visibility="Collapsed">
            <Border Style="{StaticResource Modal}">
                <DockPanel>
                    <TextBlock Text="Create new tool" Style="{StaticResource ModalTitle}" />
                    <Border Style="{StaticResource ModalFooter}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" MinWidth="72" />
                            <Button Content="Create" Style="{StaticResource PrimaryButton}" MinWidth="72" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="16,6,16,12">
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="3,0,0,3" Padding="14,5">
                                    <TextBlock Text="URL" FontWeight="SemiBold" Foreground="{StaticResource AccentForegroundBrush}" />
                                </Border>
                                <Border Padding="14,5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                                    <TextBlock Text="Email" />
                                </Border>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Label" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                        <TextBox Text="Wiki" BorderBrush="{StaticResource AccentBrush}" />
                        <TextBlock Text="Address" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <TextBox Text="wiki.studio.example" />
                        <TextBlock Text="Opens: https://wiki.studio.example" Style="{StaticResource Help}" />
                        <TextBlock Text="Icon" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                        <Button HorizontalAlignment="Left" Padding="8,3">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding LinkIcon}" Width="16" Height="16" Margin="0,0,6,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Text="link external blue" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Style="{StaticResource InfoBanner}" Margin="0,12,0,0" Padding="10,8">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Added to the panel “Frame”. Tools live in profiles: a tool on no panel of any profile leaves Custom Tools." />
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- New stack: pick 2-3 of the panel's loose tools, in order. -->
        <Grid x:Name="NewStackDialog" Background="{StaticResource ScrimBrush}" Visibility="Collapsed">
            <Border Style="{StaticResource Modal}">
                <DockPanel>
                    <TextBlock Text="New stack on “Frame”" Style="{StaticResource ModalTitle}" />
                    <Border Style="{StaticResource ModalFooter}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" MinWidth="72" />
                            <Button Content="Create stack" Style="{StaticResource PrimaryButton}" MinWidth="72" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="16,4,16,12">
                        <TextBlock Text="Pick 2 or 3 of this panel’s tools. (Or drop one tool onto another on the panel.)" Style="{StaticResource Help}"
                                   Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding StackPicks}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type spike:SpikePick}">
                                    <Border Padding="6,5" CornerRadius="3">
                                        <DockPanel>
                                            <ContentControl x:Name="Order" DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="{Binding OrderText}"
                                                            Visibility="Collapsed" />
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Image Source="{Binding Image}" Width="16" Height="16" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                            <Setter TargetName="Order" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="2 selected · a stack holds 2–3 tools" Style="{StaticResource Help}" Margin="0,8,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
