<!--
    rst-c's own (not vendored); laid out after the kit's MessageDialog (splash-it
    src/SplashIt.UI/Dialogs/MessageDialog.xaml, splash-it commit ba86a71, MIT, same owner).
    The Builder's RST Presets modal (profile_builder.html 1261-1289) as a family dialog (spec #16,
    WU5): the body text, "RSTify — Hide These Tabs" with a switch per tab (or "No tabs available to
    hide on this machine."), "Disable Unused Add-ins" with its help line, and Apply / Cancel.
-->
<Window x:Class="RST.UI.Builder.PresetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        Title="{x:Static res:UiStrings.Builder_PresetsTitle}"
        SizeToContent="Height" Width="520" MinHeight="200"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="PresetsDialog">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="ApplyButton" Content="{x:Static res:UiStrings.Builder_Apply}" IsDefault="True" Style="{StaticResource PrimaryButton}"
                        Click="OnApply" MinWidth="88" AutomationProperties.AutomationId="Presets.Apply" />
                <Button Content="{x:Static res:UiStrings.Common_Cancel}" IsCancel="True" Margin="8,0,0,0" MinWidth="88"
                        AutomationProperties.AutomationId="Presets.Cancel" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsTitle}" Style="{StaticResource SectionText}" FontSize="14" />
                <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsBody}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />

                <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsHideTabs}" Style="{StaticResource LabelText}" Margin="0,14,0,6" />
                <Border Style="{StaticResource Panel}" Padding="0">
                    <Grid>
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Visibility="{Binding HasTabs, Converter={StaticResource BoolToVisible}}">
                            <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" AutomationProperties.AutomationId="Presets.Tabs">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LoaderRow}">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsHidden}"
                                                          AutomationProperties.Name="{Binding Tab}" />
                                                <TextBlock Text="{Binding Tab}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsNoTabs}" Style="{StaticResource MutedText}" Margin="10,10"
                                   Visibility="{Binding HasTabs, Converter={StaticResource BoolToCollapsed}}"
                                   AutomationProperties.AutomationId="Presets.NoTabs" />
                    </Grid>
                </Border>

                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,10,0,0">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DisableUnused}" VerticalAlignment="Center"
                                  AutomationProperties.AutomationId="Presets.DisableUnused"
                                  AutomationProperties.Name="{x:Static res:UiStrings.Builder_PresetsDisableUnused}" />
                        <StackPanel>
                            <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsDisableUnused}" />
                            <TextBlock Text="{x:Static res:UiStrings.Builder_PresetsDisableUnusedHelp}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
