<!--
    rst-c's own (not vendored); laid out after the kit's MessageDialog (splash-it
    src/SplashIt.UI/Dialogs/MessageDialog.xaml, splash-it commit ba86a71, MIT, same owner).
    The Builder's Junk Cleanup Targets modal (profile_builder.html 1294-1316, 2736-2827) as a family
    dialog (spec #16, WU5): the help text, one row per target (enable switch | editable name | path,
    read-only and dimmed | kind, read-only | ×), the empty state, and Restore Defaults on the left with
    Apply / Cancel on the right. Planner default 4: Cancel reverts.
-->
<Window x:Class="RST.UI.Builder.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        Title="{x:Static res:UiStrings.Builder_CleanupTitle}"
        SizeToContent="Height" Width="860" MinHeight="220"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="CleanupDialog">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A text box's placeholder: shown while the box (its Tag binding) is empty. -->
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Margin" Value="7,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <DockPanel Margin="16">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                <Button DockPanel.Dock="Left" Content="{x:Static res:UiStrings.Builder_RestoreDefaults}" Command="{Binding RestoreDefaultsCommand}"
                        ToolTip="{x:Static res:UiStrings.Builder_RestoreDefaultsTip}" AutomationProperties.AutomationId="Cleanup.RestoreDefaults" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ApplyButton" Content="{x:Static res:UiStrings.Builder_Apply}" IsDefault="True" Style="{StaticResource PrimaryButton}"
                            Click="OnApply" MinWidth="88" AutomationProperties.AutomationId="Cleanup.Apply" />
                    <Button Content="{x:Static res:UiStrings.Common_Cancel}" IsCancel="True" Margin="8,0,0,0" MinWidth="88"
                            AutomationProperties.AutomationId="Cleanup.Cancel" />
                </StackPanel>
            </DockPanel>

            <StackPanel>
                <TextBlock Text="{x:Static res:UiStrings.Builder_CleanupTitle}" Style="{StaticResource SectionText}" FontSize="14" />
                <TextBlock Text="{x:Static res:UiStrings.Builder_CleanupModalHelp}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                <Border Style="{StaticResource Panel}" Padding="0" Margin="0,12,0,0">
                    <Grid>
                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Focusable="False"
                                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToCollapsed}}">
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.AutomationId="Cleanup.Rows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource LoaderRow}" AutomationProperties.Name="{Binding Name}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="170" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                                          ToolTip="{x:Static res:UiStrings.Builder_CleanupEnableTip}"
                                                          AutomationProperties.Name="{x:Static res:UiStrings.Builder_CleanupEnableTip}" />
                                                <Grid Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                             AutomationProperties.Name="{x:Static res:UiStrings.Builder_CleanupNamePlaceholder}" />
                                                    <TextBlock Text="{x:Static res:UiStrings.Builder_CleanupNamePlaceholder}" Style="{StaticResource Hint}"
                                                               Tag="{Binding Text, ElementName=NameBox}" />
                                                </Grid>
                                                <TextBox Grid.Column="2" Margin="8,0,0,0" Text="{Binding Path, Mode=OneWay}" IsReadOnly="True" Opacity="0.6"
                                                         ToolTip="{x:Static res:UiStrings.Builder_CleanupPathTip}" />
                                                <TextBox Grid.Column="3" Margin="8,0,0,0" Text="{Binding Kind, Mode=OneWay}" IsReadOnly="True" Opacity="0.6" />
                                                <Button Grid.Column="4" Content="×" Command="{Binding RemoveCommand}" Style="{StaticResource IconButton}"
                                                        Foreground="{StaticResource DangerForegroundBrush}" Margin="6,0,0,0"
                                                        ToolTip="{x:Static res:UiStrings.Builder_CleanupRemoveTip}"
                                                        AutomationProperties.Name="{x:Static res:UiStrings.Builder_CleanupRemoveTip}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{x:Static res:UiStrings.Builder_CleanupEmpty}" Style="{StaticResource MutedText}" Margin="10,12"
                                   HorizontalAlignment="Center"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}"
                                   AutomationProperties.AutomationId="Cleanup.Empty" />
                    </Grid>
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
