<!--
    rst-c's own (not vendored); laid out after the kit's MessageDialog (splash-it
    src/SplashIt.UI/Dialogs/MessageDialog.xaml, splash-it commit ba86a71, MIT, same owner).
    ⚙ → Branding… (feature #18, spec #19, WU2): the machine-wide logo (Pick…, ×, the file name) and
    link that the Builder header's Branding ▾ popover held (spec #16, WU4-WU5). Each change is saved
    as it happens (the link when the box loses focus, on Enter, or when the dialog closes); Done
    and Escape close it. Its DataContext is the Builder's view-model.
-->
<Window x:Class="RST.UI.Builder.BrandingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        xmlns:mvvm="clr-namespace:RST.UI.Mvvm"
        Title="{x:Static res:UiStrings.Builder_BrandingHeading}"
        SizeToContent="Height" Width="440" MinHeight="160"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="BrandingDialog">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A text box's placeholder: shown while the box (its Tag binding) is empty. -->
            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="Margin" Value="7,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <Trigger Property="Tag" Value="">
                        <Setter Property="Visibility" Value="Visible" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="DoneButton" Content="{x:Static res:UiStrings.Builder_Done}" IsCancel="True" Style="{StaticResource PrimaryButton}"
                        MinWidth="88" AutomationProperties.AutomationId="Branding.Done" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{x:Static res:UiStrings.Builder_BrandingHeading}" Style="{StaticResource SectionText}" FontSize="14" />
                <TextBlock Text="{x:Static res:UiStrings.Builder_BrandingHelp}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />

                <TextBlock Text="{x:Static res:UiStrings.Builder_Logo}" Style="{StaticResource LabelText}" Margin="0,14,0,4" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PickLogoButton" Content="{x:Static res:UiStrings.Builder_PickLogo}" Command="{Binding PickLogoCommand}"
                            AutomationProperties.AutomationId="Builder.PickLogo" />
                    <Button Content="{x:Static res:UiStrings.Builder_ClearLogo}" Command="{Binding ClearLogoCommand}"
                            Style="{StaticResource IconButton}" Margin="4,0,0,0"
                            ToolTip="{x:Static res:UiStrings.Builder_ClearLogoTip}"
                            AutomationProperties.AutomationId="Builder.ClearLogo"
                            AutomationProperties.Name="{x:Static res:UiStrings.Builder_ClearLogoTip}" />
                    <TextBlock x:Name="LogoName" Text="{Binding LogoName}" Margin="8,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="260" AutomationProperties.AutomationId="Builder.LogoName">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasLogo}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="{x:Static res:UiStrings.Builder_Url}" Style="{StaticResource LabelText}" Margin="0,12,0,4" HorizontalAlignment="Left" />
                <Grid>
                    <TextBox x:Name="BrandingUrlBox" mvvm:Behaviors.CommitOnEnter="True"
                             Text="{Binding BrandingUrl, UpdateSourceTrigger=LostFocus}"
                             AutomationProperties.AutomationId="Builder.BrandingUrl"
                             AutomationProperties.Name="{x:Static res:UiStrings.Builder_Url}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{x:Static res:UiStrings.Builder_UrlPlaceholder}"
                               Tag="{Binding Text, ElementName=BrandingUrlBox}" />
                </Grid>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
