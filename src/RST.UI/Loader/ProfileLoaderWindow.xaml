<!--
    rst-c's own (not vendored); the window chrome follows splash-it
    src/SplashIt.UI/Settings/SettingsWindow.xaml (splash-it commit ba86a71, MIT, same owner).
    The Profile Loader (spec #16, WU3), laid out one-for-one with profile_loader.html (775-864):
    the header (title, Revit version, + Import from File), the 300 px profile list (cards, count,
    empty state), and the detail pane (name, Loaded badge, meta, Tab Preview with the opacity
    override and Read Only badge, RSTify "Hide These Tabs", Required Add-ins) over the footer bar
    (Unload / Delete on the left, Restore All Add-ins and "Disable unused add-ins" in the middle,
    Load Profile → and Close on the right). The toast and the busy overlay sit on top.
-->
<Window x:Class="RST.UI.Loader.ProfileLoaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        xmlns:controls="clr-namespace:RST.UI.Controls"
        xmlns:core="clr-namespace:RST.Core.Loader;assembly=RST.Core"
        Title="{x:Static res:UiStrings.Loader_WindowTitle}"
        Width="1450" Height="900" MinWidth="900" MinHeight="560"
        ResizeMode="CanResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="ProfileLoaderWindow">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- "Tab  Architecture": a muted label and its value (the cards' and the detail header's meta rows). -->
            <Style x:Key="MetaLabel" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="Margin" Value="0,0,5,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="MetaValue" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                <Setter Property="Margin" Value="0,0,16,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The root carries the window color itself: the screenshot tests render it unclipped by the window. -->
    <Grid x:Name="Root" Background="{StaticResource WindowBrush}">
        <!-- Disabled while busy: no command or input reaches the window under the overlay (Planner default 8). -->
        <Grid x:Name="Body" IsEnabled="{Binding IsIdle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Style="{StaticResource LoaderStrip}" BorderThickness="0,0,0,1" Height="54" Padding="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:UiStrings.Loader_Title}" Style="{StaticResource SectionText}" FontSize="14"
                               Margin="0" VerticalAlignment="Center" AutomationProperties.AutomationId="Loader.Title" />
                    <Rectangle Width="1" Height="20" Fill="{StaticResource DividerBrush}" Margin="20,0" />
                    <TextBlock Text="{x:Static res:UiStrings.Loader_RevitLabel}" Style="{StaticResource LabelText}" />
                    <TextBlock Text="{Binding RevitVersionDisplay}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                               AutomationProperties.AutomationId="Loader.RevitVersion" />
                    <Button Content="{x:Static res:UiStrings.Loader_ImportFromFile}" Command="{Binding ImportCommand}" Margin="20,0,0,0"
                            AutomationProperties.AutomationId="Loader.Import" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Profile list -->
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="{StaticResource SurfaceAltBrush}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,14,16,10">
                            <ContentControl DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="{Binding ProfileCount}"
                                            AutomationProperties.AutomationId="Loader.ProfileCount" />
                            <TextBlock Text="{x:Static res:UiStrings.Loader_Profiles}" Style="{StaticResource SectionText}" Margin="0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid>
                            <ListBox x:Name="Cards" Style="{StaticResource LoaderCardList}" ItemsSource="{Binding Profiles}"
                                     SelectedItem="{Binding SelectedCard, Mode=TwoWay}" Padding="12,0,12,12"
                                     Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisible}}"
                                     AutomationProperties.AutomationId="Loader.Profiles"
                                     AutomationProperties.Name="{x:Static res:UiStrings.Loader_Profiles}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource CardListBoxItem}">
                                        <Setter Property="controls:CardState.IsActive" Value="{Binding IsLoaded}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{x:Static res:UiStrings.Loader_LoadedBadge}"
                                                           Style="{StaticResource SuccessText}" FontSize="11" Margin="8,0,0,0"
                                                           Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisible}}" />
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <WrapPanel Margin="0,6,0,0">
                                                <TextBlock Text="{x:Static res:UiStrings.Loader_Tab}" Style="{StaticResource MetaLabel}" />
                                                <TextBlock Text="{Binding Tab}" Style="{StaticResource MetaValue}" Margin="0,0,10,0" />
                                                <TextBlock Text="{x:Static res:UiStrings.Loader_MinRevit}" Style="{StaticResource MetaLabel}" />
                                                <TextBlock Text="{Binding MinRevit}" Style="{StaticResource MetaValue}" Margin="0,0,10,0" />
                                                <TextBlock Text="{x:Static res:UiStrings.Loader_Panels}" Style="{StaticResource MetaLabel}" />
                                                <TextBlock Text="{Binding PanelCount}" Style="{StaticResource MetaValue}" Margin="0" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- No profiles -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,30"
                                        Visibility="{Binding HasProfiles, Converter={StaticResource BoolToCollapsed}}"
                                        AutomationProperties.AutomationId="Loader.EmptyState">
                                <TextBlock Text="{x:Static res:UiStrings.Loader_NoProfiles}" HorizontalAlignment="Center" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static res:UiStrings.Loader_NoProfilesHint}" Style="{StaticResource MutedText}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                                <Button Content="{x:Static res:UiStrings.Loader_ImportProfileFromFile}" Command="{Binding ImportCommand}"
                                        HorizontalAlignment="Center" Margin="0,14,0,0"
                                        AutomationProperties.AutomationId="Loader.EmptyImport" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Detail pane -->
                <DockPanel Grid.Column="1">
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,18,28,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DetailName}" Style="{StaticResource HeadingText}" FontSize="22"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="Loader.DetailName" />
                                <TextBlock Text="{x:Static res:UiStrings.Loader_LoadedBadge}" Style="{StaticResource SuccessText}" Margin="12,4,0,0"
                                           Visibility="{Binding IsSelectionLoaded, Converter={StaticResource BoolToVisible}}"
                                           AutomationProperties.AutomationId="Loader.DetailLoaded" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}"
                                        AutomationProperties.AutomationId="Loader.DetailMeta">
                                <TextBlock Text="{x:Static res:UiStrings.Loader_Tab}" Style="{StaticResource MetaLabel}" />
                                <TextBlock Text="{Binding DetailTab}" Style="{StaticResource MetaValue}" />
                                <TextBlock Text="{x:Static res:UiStrings.Loader_MinRevit}" Style="{StaticResource MetaLabel}" />
                                <TextBlock Text="{Binding DetailMinRevit}" Style="{StaticResource MetaValue}" />
                                <TextBlock Text="{x:Static res:UiStrings.Loader_Updated}" Style="{StaticResource MetaLabel}" />
                                <TextBlock Text="{Binding DetailUpdated}" Style="{StaticResource MetaValue}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Footer: the family button bar -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource LoaderStrip}" BorderThickness="0,1,0,0" Padding="28,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{x:Static res:UiStrings.Loader_UnloadProfile}" Command="{Binding UnloadCommand}"
                                        AutomationProperties.AutomationId="Loader.Unload" />
                                <Button Content="{x:Static res:UiStrings.Loader_DeleteProfile}" Command="{Binding DeleteCommand}"
                                        Style="{StaticResource DangerButton}" Margin="8,0,0,0" AutomationProperties.AutomationId="Loader.Delete" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="{x:Static res:UiStrings.Loader_RestoreAll}" Command="{Binding RestoreCommand}"
                                        AutomationProperties.AutomationId="Loader.Restore" />
                                <TextBlock Text="{x:Static res:UiStrings.Loader_DisableUnused}" Style="{StaticResource LabelText}" Margin="20,0,8,0" />
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding DisableUnused}" VerticalAlignment="Center"
                                          AutomationProperties.AutomationId="Loader.DisableUnused"
                                          AutomationProperties.Name="{x:Static res:UiStrings.Loader_DisableUnused}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="{x:Static res:UiStrings.Loader_LoadProfile}" Command="{Binding LoadCommand}"
                                        Style="{StaticResource PrimaryButton}" AutomationProperties.AutomationId="Loader.Load" />
                                <Button Content="{x:Static res:UiStrings.Loader_Close}" Command="{Binding CloseCommand}" Margin="8,0,0,0"
                                        MinWidth="88" AutomationProperties.AutomationId="Loader.Close" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="28,20,28,22">
                            <!-- Tab Preview -->
                            <TextBlock Text="{x:Static res:UiStrings.Loader_TabPreview}" Style="{StaticResource SectionText}" />
                            <controls:RibbonPreview x:Name="Preview" Mode="Loader" Profile="{Binding SelectedProfile}"
                                                    OverrideOpacity="{Binding PreviewOpacity}">
                                <controls:RibbonPreview.TopBarContent>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{x:Static res:UiStrings.Loader_OverrideOpacity}" Style="{StaticResource LabelText}" />
                                        <Slider Width="150" Thumb.DragCompleted="OnOpacityDragCompleted"
                                                PreviewMouseLeftButtonUp="OnOpacityMouseUp" KeyUp="OnOpacityKeyUp" Minimum="10" Maximum="100" SmallChange="1" LargeChange="10"
                                                IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                Value="{Binding OpacityOverride, Mode=TwoWay}"
                                                AutomationProperties.AutomationId="Loader.OpacityOverride"
                                                AutomationProperties.Name="{x:Static res:UiStrings.Loader_OverrideOpacity}" />
                                        <TextBlock Text="{Binding OpacityOverride}" MinWidth="26" TextAlignment="Right" Margin="6,0,0,0"
                                                   Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"
                                                   AutomationProperties.AutomationId="Loader.OpacityValue" />
                                        <ContentControl Style="{StaticResource Pill}" Content="{x:Static res:UiStrings.Loader_ReadOnly}" Margin="14,0,0,0" />
                                    </StackPanel>
                                </controls:RibbonPreview.TopBarContent>
                            </controls:RibbonPreview>

                            <!-- RSTify (1/3) and Required Add-ins (2/3), shown once a card is selected -->
                            <Grid Margin="0,22,0,0" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}"
                                  AutomationProperties.AutomationId="Loader.DetailColumns">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{x:Static res:UiStrings.Loader_RstifyHeading}" Style="{StaticResource SectionText}" />
                                    <Border Style="{StaticResource Panel}" Padding="0"
                                            Visibility="{Binding HasTabToggles, Converter={StaticResource BoolToVisible}}">
                                        <ItemsControl ItemsSource="{Binding TabToggles}" Focusable="False" AutomationProperties.AutomationId="Loader.TabToggles">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource LoaderRow}">
                                                        <DockPanel>
                                                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsHidden}"
                                                                      AutomationProperties.Name="{Binding Tab}" />
                                                            <TextBlock Text="{Binding Tab}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <TextBlock Text="{x:Static res:UiStrings.Loader_RstifyEmpty}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                               Visibility="{Binding TabTogglesEmpty, Converter={StaticResource BoolToVisible}}"
                                               AutomationProperties.AutomationId="Loader.TabTogglesEmpty" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{x:Static res:UiStrings.Loader_RequiredAddins}" Style="{StaticResource SectionText}" />
                                    <Border Style="{StaticResource Panel}" Padding="0"
                                            Visibility="{Binding RequiredAddinsEmpty, Converter={StaticResource BoolToCollapsed}}">
                                        <ItemsControl ItemsSource="{Binding RequiredAddins}" Focusable="False" AutomationProperties.AutomationId="Loader.RequiredAddins">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource LoaderRow}" AutomationProperties.Name="{Binding TabName}">
                                                        <DockPanel>
                                                            <ContentControl x:Name="StatusPill" DockPanel.Dock="Right" Style="{StaticResource WarningPill}"
                                                                            Content="{Binding StatusLabel}" ToolTip="{Binding StatusTooltip}"
                                                                            ToolTipService.ShowOnDisabled="True" Margin="10,0,0,0"
                                                                            AutomationProperties.AutomationId="Loader.AddinStatus" />
                                                            <ContentControl DockPanel.Dock="Right" Style="{StaticResource Pill}" Content="{Binding Origin}"
                                                                            Margin="10,0,0,0"
                                                                            Visibility="{Binding HasOrigin, Converter={StaticResource BoolToVisible}}" />
                                                            <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center"
                                                                       Visibility="{Binding HasInfoUrl, Converter={StaticResource BoolToVisible}}">
                                                                <Hyperlink Command="{Binding OpenUrlCommand}" CommandParameter="{Binding InfoUrl}"
                                                                           Style="{StaticResource LoaderLink}" ToolTip="{Binding InfoUrl}"
                                                                           AutomationProperties.Name="{x:Static res:UiStrings.Loader_InfoLink}">
                                                                    <Run Text="{x:Static res:UiStrings.Loader_InfoLink}" />
                                                                </Hyperlink>
                                                            </TextBlock>
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding FileColumn}" Style="{StaticResource MutedText}"
                                                                       Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="280" />
                                                            <TextBlock Text="{Binding TabName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        </DockPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <!-- The HTML's pill classes: Native and Loaded are "present" (green);
                                                             Disabled and Not Found are amber (the WarningPill default above);
                                                             Locked (by the administrator, spec #18) is red. -->
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static core:AddinRowStatus.Native}">
                                                            <Setter TargetName="StatusPill" Property="Style" Value="{StaticResource SuccessPill}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static core:AddinRowStatus.Loaded}">
                                                            <Setter TargetName="StatusPill" Property="Style" Value="{StaticResource SuccessPill}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static core:AddinRowStatus.Locked}">
                                                            <Setter TargetName="StatusPill" Property="Style" Value="{StaticResource ErrorPill}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <TextBlock Text="{x:Static res:UiStrings.Loader_None}" Style="{StaticResource MutedText}" Margin="0,4,0,0"
                                               Visibility="{Binding RequiredAddinsEmpty, Converter={StaticResource BoolToVisible}}"
                                               AutomationProperties.AutomationId="Loader.RequiredAddinsNone" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Grid>

        <ContentControl Style="{StaticResource BusyOverlay}" Content="{Binding Busy}" />
        <!-- Above the busy overlay, as in Health: the no-change Unload note shows during the 3 s "Unloading" close. -->
        <ContentControl Style="{StaticResource TransientBanner}" Content="{Binding Toast}" />
    </Grid>
</Window>
