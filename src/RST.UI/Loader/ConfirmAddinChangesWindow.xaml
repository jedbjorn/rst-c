<!--
    rst-c's own (not vendored); laid out after the kit's MessageDialog (splash-it
    src/SplashIt.UI/Dialogs/MessageDialog.xaml, splash-it commit ba86a71, MIT, same owner).
    The Loader's "Confirm Add-in Changes" overlay (profile_loader.html 884-908) as a family dialog
    (spec #16, WU3): the same title, subtitle, three columns, "None" placeholders, restart note and
    buttons. The Try Disable column shows only when it has entries. Confirm & Load renames add-in
    files, so Cancel is the default (Enter) and has the focus, as in the kit's destructive MessageDialog.
-->
<Window x:Class="RST.UI.Loader.ConfirmAddinChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        Title="{x:Static res:UiStrings.Loader_ConfirmTitle}"
        SizeToContent="Height" Width="640" MinHeight="200"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="ConfirmAddinChangesDialog">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One column's list: each display name, trimmed to the column (full name in the tooltip). -->
            <DataTemplate x:Key="ItemRow">
                <TextBlock Text="{Binding}" ToolTip="{Binding}" TextTrimming="CharacterEllipsis" Margin="0,2"
                           AutomationProperties.Name="{Binding}" />
            </DataTemplate>
            <Style x:Key="ColumnList" TargetType="ItemsControl">
                <Setter Property="ItemTemplate" Value="{StaticResource ItemRow}" />
                <Setter Property="Focusable" Value="False" />
            </Style>
            <Style x:Key="NoneText" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                <Setter Property="Text" Value="{x:Static res:UiStrings.Loader_None}" />
                <Setter Property="Margin" Value="0,2" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- The root carries the window color itself, so the screenshot tests can render it unclipped. -->
    <Grid Background="{StaticResource WindowBrush}">
        <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <!-- Destructive (it renames add-in files): Enter means Cancel, as the family's destructive confirms. -->
                <Button x:Name="ConfirmButton" Content="{x:Static res:UiStrings.Loader_ConfirmAndLoad}"
                        Style="{StaticResource DangerFilledButton}" Click="OnConfirm" MinWidth="88"
                        AutomationProperties.AutomationId="ConfirmAddinChanges.Confirm" />
                <Button x:Name="CancelButton" Content="{x:Static res:UiStrings.Common_Cancel}" IsCancel="True" IsDefault="True" Margin="8,0,0,0" MinWidth="88"
                        AutomationProperties.AutomationId="ConfirmAddinChanges.Cancel" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{x:Static res:UiStrings.Loader_ConfirmTitle}" Style="{StaticResource SectionText}" FontSize="14"
                           AutomationProperties.AutomationId="ConfirmAddinChanges.Heading" />
                <TextBlock Text="{x:Static res:UiStrings.Loader_ConfirmSubtitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap" />

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="TryGap" Width="10" />
                        <ColumnDefinition x:Name="TryColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Panel}" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:UiStrings.Loader_StayingActive}" Style="{StaticResource SuccessText}"
                                       FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Staying}" Style="{StaticResource ColumnList}"
                                                  AutomationProperties.AutomationId="ConfirmAddinChanges.Staying" />
                                    <TextBlock Style="{StaticResource NoneText}"
                                               Visibility="{Binding HasStaying, Converter={StaticResource BoolToCollapsed}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:UiStrings.Loader_WillBeDisabled}" Foreground="{StaticResource WarningTextBrush}"
                                       FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Disabling}" Style="{StaticResource ColumnList}"
                                                  AutomationProperties.AutomationId="ConfirmAddinChanges.Disabling" />
                                    <TextBlock Style="{StaticResource NoneText}"
                                               Visibility="{Binding HasDisabling, Converter={StaticResource BoolToCollapsed}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TryPanel" Grid.Column="4" Style="{StaticResource Panel}" Padding="10,8"
                            Visibility="{Binding HasTryDisable, Converter={StaticResource BoolToVisible}}">
                        <StackPanel>
                            <TextBlock Text="{x:Static res:UiStrings.Loader_TryDisable}" Style="{StaticResource ErrorText}"
                                       FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <ItemsControl ItemsSource="{Binding TryDisable}" Style="{StaticResource ColumnList}"
                                              AutomationProperties.AutomationId="ConfirmAddinChanges.TryDisable" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource WarningBanner}" Margin="0,12,0,0">
                    <TextBlock Text="{x:Static res:UiStrings.Loader_ConfirmRestart}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" />
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
