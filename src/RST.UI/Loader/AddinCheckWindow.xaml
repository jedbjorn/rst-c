<!--
    rst-c's own (not vendored); laid out after the kit's MessageDialog (splash-it
    src/SplashIt.UI/Dialogs/MessageDialog.xaml, splash-it commit ba86a71, MIT, same owner).
    The Loader's "Add-in Check" QA overlay (profile_loader.html 869-881, 1476-1543) as a family
    dialog (spec #16, WU3): the subtitle, "Auto-Restored (Was Disabled)", "Missing — Not
    Installed" with download links or "(no link)", the all-clear line, the restart note when
    something was restored, and a single Continue.
-->
<Window x:Class="RST.UI.Loader.AddinCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        Title="{x:Static res:UiStrings.Loader_QaTitle}"
        SizeToContent="Height" Width="520" MinHeight="160"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        AutomationProperties.AutomationId="AddinCheckDialog">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <DockPanel Margin="16">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="{x:Static res:UiStrings.Loader_QaContinue}" IsDefault="True" IsCancel="True"
                        Style="{StaticResource PrimaryButton}" Click="OnContinue" MinWidth="88"
                        AutomationProperties.AutomationId="AddinCheck.Continue" />
            </StackPanel>

            <StackPanel>
                <TextBlock Text="{x:Static res:UiStrings.Loader_QaTitle}" Style="{StaticResource SectionText}" FontSize="14"
                           AutomationProperties.AutomationId="AddinCheck.Heading" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" TextWrapping="Wrap" TextTrimming="None"
                           AutomationProperties.AutomationId="AddinCheck.Subtitle" />

                <Border Style="{StaticResource Panel}" Padding="10,8" Margin="0,12,0,0"
                        Visibility="{Binding HasRestored, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:UiStrings.Loader_QaRestored}" Style="{StaticResource SuccessText}"
                                   FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Restored}" Focusable="False" AutomationProperties.AutomationId="AddinCheck.Restored">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2" AutomationProperties.Name="{Binding Text}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Padding="10,8" Margin="0,12,0,0"
                        Visibility="{Binding HasMissing, Converter={StaticResource BoolToVisible}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:UiStrings.Loader_QaMissing}" Style="{StaticResource ErrorText}"
                                   FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding Missing}" Focusable="False" AutomationProperties.AutomationId="AddinCheck.Missing">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <WrapPanel Margin="0,2" AutomationProperties.Name="{Binding Text}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,6,0" />
                                        <TextBlock Visibility="{Binding HasUrl, Converter={StaticResource BoolToVisible}}">
                                            <Hyperlink Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       CommandParameter="{Binding Url}" Style="{StaticResource LoaderLink}" ToolTip="{Binding Url}"
                                                       AutomationProperties.Name="{x:Static res:UiStrings.Loader_QaDownload}">
                                                <Run Text="{x:Static res:UiStrings.Loader_QaDownload}" />
                                            </Hyperlink>
                                        </TextBlock>
                                        <TextBlock Text="{x:Static res:UiStrings.Loader_QaNoLink}" Style="{StaticResource MutedText}"
                                                   Visibility="{Binding HasUrl, Converter={StaticResource BoolToCollapsed}}" />
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="{x:Static res:UiStrings.Loader_QaNothing}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,14"
                           Visibility="{Binding AllClear, Converter={StaticResource BoolToVisible}}"
                           AutomationProperties.AutomationId="AddinCheck.AllClear" />

                <Border Style="{StaticResource WarningBanner}" Margin="0,12,0,0"
                        Visibility="{Binding ShowRestartNote, Converter={StaticResource BoolToVisible}}">
                    <TextBlock Text="{x:Static res:UiStrings.Loader_QaRestart}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                               AutomationProperties.AutomationId="AddinCheck.Restart" />
                </Border>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
