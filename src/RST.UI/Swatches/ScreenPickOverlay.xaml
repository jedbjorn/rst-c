<!--
    Copied from splash-it src/SplashIt.UI/Swatches/ScreenPickOverlay.xaml (splash-it commit ba86a71; originally gantt-it src/GanttIt.Revit/UI/Swatches/ScreenPickOverlay.xaml, gantt-it commit a96d0a1), MIT, same owner.
    Changes: namespaces (SplashIt.* to RST.*).
-->
<Window x:Class="RST.UI.Swatches.ScreenPickOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        Title="{x:Static res:UiStrings.Pick_WindowTitle}" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" WindowStartupLocation="Manual"
        Left="-32000" Top="-32000" Width="16" Height="16"
        Background="Black" Cursor="Cross" ForceCursor="True"
        FontFamily="Segoe UI" FontSize="12" TextOptions.TextFormattingMode="Display"
        AutomationProperties.AutomationId="ScreenPickOverlay">
    <!--
        One per monitor while "Pick from screen" runs: shows the frozen screenshot of its
        monitor full size, with the magnifier following the pointer. Positioned in physical
        pixels by ScreenColorPicker; the screenshot stretches to whatever WPF thinks the
        client size is, so it lines up with the monitor at any scale factor.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Image x:Name="Screenshot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <Canvas x:Name="LoupeLayer" IsHitTestVisible="False">
            <Border x:Name="Loupe" Visibility="Collapsed" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6"
                    AutomationProperties.AutomationId="ScreenPick.Loupe">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.35" />
                </Border.Effect>
                <StackPanel>
                    <Canvas x:Name="Zoom" Background="#808080" ClipToBounds="True">
                        <Image x:Name="Cells" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Rectangle x:Name="GridLines" IsHitTestVisible="False" />
                        <Rectangle x:Name="CentreOuter" Stroke="Black" StrokeThickness="1" SnapsToDevicePixels="True" />
                        <Rectangle x:Name="CentreInner" Stroke="White" StrokeThickness="1" SnapsToDevicePixels="True" />
                    </Canvas>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <Border x:Name="Swatch" Width="18" Height="18" CornerRadius="3" BorderBrush="{StaticResource ChipBorderBrush}"
                                BorderThickness="1" Margin="0,0,6,0" />
                        <TextBlock x:Name="HexText" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"
                                   AutomationProperties.AutomationId="ScreenPick.Hex" />
                    </StackPanel>
                    <TextBlock Text="{x:Static res:UiStrings.Pick_Hint}" Style="{StaticResource MutedText}"
                               FontSize="11" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
