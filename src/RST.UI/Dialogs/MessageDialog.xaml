<!--
    Copied from splash-it src/SplashIt.UI/Dialogs/MessageDialog.xaml (splash-it commit ba86a71; originally gantt-it src/GanttIt.Revit/UI/Dialogs/MessageDialog.xaml, gantt-it commit a96d0a1), MIT, same owner.
    Changes: namespaces (SplashIt.* to RST.*).
-->
<Window x:Class="RST.UI.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:RST.UI.Resources"
        Title="{Binding Title}"
        SizeToContent="Height" Width="460" MinHeight="140"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RST.UI;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ConfirmButton" Content="{Binding ConfirmText}" IsDefault="True" Click="OnConfirm"
                    AutomationProperties.AutomationId="Dialog.Confirm" MinWidth="88" />
            <Button x:Name="CancelButton" Content="{x:Static res:UiStrings.Common_Cancel}" IsCancel="True" Margin="8,0,0,0" MinWidth="88"
                    Visibility="{Binding HasCancel, Converter={StaticResource BoolToVisible}}"
                    AutomationProperties.AutomationId="Dialog.Cancel" />
        </StackPanel>

        <StackPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource SectionText}" FontSize="14" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="Dialog.Heading" />
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                       AutomationProperties.AutomationId="Dialog.Message" />
            <Border Style="{StaticResource Panel}" Padding="8" Margin="0,10,0,0"
                    Visibility="{Binding HasItems, Converter={StaticResource BoolToVisible}}">
                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.AutomationId="Dialog.Items"
                                  AutomationProperties.Name="{x:Static res:UiStrings.Dialog_Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='•  {0}'}" Margin="0,1" TextWrapping="Wrap"
                                           AutomationProperties.Name="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
