<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RST.UI — WPF host for the loader/profiler webview.

    The loader UI is the legacy HTML/CSS/JS from the pyRevit-era addin
    (vendored under Assets/) running inside a WebView2 control.
    LoaderBridge is exposed to JS as a host object replacing
    pywebview.api; a small bootstrap script creates the window.pywebview
    shim and dispatches the pywebviewready event the legacy JS waits on.

    TFM tracks the same RevitVersion grid as RST.Engine so we get a
    consistent build matrix; this project depends on RST.Core but NOT on
    Revit API packages — Revit-bound concerns stay in RST.Engine.
  -->

  <PropertyGroup>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RST.UI</RootNamespace>
    <AssemblyName>RST.UI</AssemblyName>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputType>Library</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RST.Core\RST.Core.csproj" />
  </ItemGroup>

  <!--
    Vendored web assets — copied next to the assembly so SetVirtualHost
    can serve them as https://rst.ui/<file>. Layout flat under Assets/
    matches /home/jedi/RST/ui/.
  -->
  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Import Project="..\..\build\sign.targets" />

</Project>
