<Project Sdk="Microsoft.NET.Sdk">

  <!--
    RST.UI — rst-c's native WPF windows (spec #16): the Profile Loader, the
    Profile Builder and Health, on the family kit vendored from splash-it
    (Theme.xaml, Theming, Mvvm, Dialogs, Swatches). The WebView2 pages and
    their bridges are gone (WU5 retired the last one, the Builder).

    TFM tracks the same RevitVersion grid as RST.Engine so we get a
    consistent build matrix; this project depends on RST.Core but NOT on
    Revit API packages — Revit-bound concerns stay in RST.Engine.
  -->

  <PropertyGroup>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RST.UI</RootNamespace>
    <AssemblyName>RST.UI</AssemblyName>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputType>Library</OutputType>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="System.Management" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RST.Core\RST.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RuntimeTests reads the windows' named parts and internal seams. -->
    <InternalsVisibleTo Include="RST.RuntimeTests" />
  </ItemGroup>

  <!--
    Shipped assets, copied next to the assembly: Assets/lookup/addin_lookup.json
    (the curated add-in registry). The icon pack comes from RST.Engine's Assets.
  -->
  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Import Project="..\..\build\sign.targets" />

</Project>
