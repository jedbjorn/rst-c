<Project>

  <!--
    RST-C — root build properties.

    Picks a Revit major version per MSBuild Configuration following the
    Nice3point convention: Configuration="Debug R25" → RevitVersion=2025.
    Each project then conditionally selects TargetFramework + Revit API
    package versions from $(RevitVersion).
  -->

  <PropertyGroup>
    <Configurations>Debug R25;Debug R26;Debug R27;Release R25;Release R26;Release R27</Configurations>
    <Configuration Condition="'$(Configuration)' == ''">Debug R25</Configuration>
  </PropertyGroup>

  <!-- Revit version derived from Configuration name (R25/R26/R27). -->
  <PropertyGroup>
    <RevitVersion Condition="$(Configuration.Contains('R25'))">2025</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R26'))">2026</RevitVersion>
    <RevitVersion Condition="$(Configuration.Contains('R27'))">2027</RevitVersion>
  </PropertyGroup>

  <!-- Target framework selected from Revit version:
         2025, 2026   → net8.0-windows
         2027         → net10.0-windows (requires .NET 10 SDK installed) -->
  <PropertyGroup>
    <RevitTargetFramework Condition="'$(RevitVersion)' == '2025'">net8.0-windows</RevitTargetFramework>
    <RevitTargetFramework Condition="'$(RevitVersion)' == '2026'">net8.0-windows</RevitTargetFramework>
    <RevitTargetFramework Condition="'$(RevitVersion)' == '2027'">net10.0-windows</RevitTargetFramework>
  </PropertyGroup>

  <!-- Configuration name without the "R##" suffix (Debug/Release). -->
  <PropertyGroup>
    <PlainConfiguration Condition="$(Configuration.StartsWith('Debug'))">Debug</PlainConfiguration>
    <PlainConfiguration Condition="$(Configuration.StartsWith('Release'))">Release</PlainConfiguration>
  </PropertyGroup>

  <PropertyGroup>
    <Product>RST-C</Product>
    <Company>Designs/OS</Company>
    <Authors>jedbjorn</Authors>
    <Copyright>© 2026 Designs/OS</Copyright>
    <!-- The release version (SC-054, SC-015): one source for every RST assembly. CI passes the
         release's a.b.c as -p:Version (build/stage.sh, from RST_VERSION); an untagged (dev or
         PR) build is $(RstDevVersion)-dev. The SDK derives FileVersion (a.b.c.0) and
         InformationalVersion (a.b.c+<short commit>, see RstShortSourceRevision below) from it,
         and the session log header, the boot log and the tray log print them (docs/logging.md). -->
    <!-- RstDevVersion: the version of every untagged build, ONE value for the binaries (here),
         build/stage.sh (which reads it from this line), RST.msi and RST-Setup.exe (their
         .wixproj fallbacks read this property). It must sort above the latest release and below
         the next: Windows Installer does not install a file older than the one on disk (and the
         MajorUpgrade then removes the old one, leaving none: the tray lost on a dev build over
         v3.1.1, whose tray files are 3.1.1.0), and an MSI refuses to install over a newer
         ProductVersion. Bump it after each release (installer/README.md, "Untagged builds"). -->
    <RstDevVersion>3.1.99</RstDevVersion>
    <Version Condition="'$(Version)' == ''">$(RstDevVersion)-dev</Version>
    <!-- AssemblyVersion stays fixed at the value every release has shipped (0.1.0.0), whatever
         the release: the bootstrap's assembly resolver (docs/DEVELOPING.md, "The bootstrap's
         assembly resolver", decision #32) compares RST's own assemblies by version and declines a
         different major, so a per-release AssemblyVersion would let one RST copy in a Revit
         process refuse another. Change it only with the resolver in mind. -->
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <!-- The SDK would copy AssemblyVersion into FileVersion: derive it from Version instead
         (3.2.0 and 3.2.0-rc.1 give 3.2.0.0; 3.1.99-dev gives 3.1.99.0). -->
    <RstNumericVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value)</RstNumericVersion>
    <FileVersion Condition="'$(FileVersion)' == '' and '$(RstNumericVersion)' != ''">$(RstNumericVersion).0</FileVersion>
    <RepositoryUrl>https://github.com/jedbjorn/RST-C</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1701</WarningsNotAsErrors>
    <NoWarn>1591</NoWarn>
    <!-- WiX (.wixproj) only accepts 'full' or 'none' for -pdbType.
         Restrict the portable PDB to managed projects so the WiX SDK
         doesn't inherit an invalid value (RST-012). -->
    <DebugType Condition="'$(MSBuildProjectExtension)' != '.wixproj'">portable</DebugType>
    <DebugSymbols Condition="'$(MSBuildProjectExtension)' != '.wixproj'">true</DebugSymbols>
  </PropertyGroup>

  <!-- Code-signing hooks (no-ops in dev — wired up in RST-013). -->
  <PropertyGroup>
    <SignAssemblies Condition="'$(SignAssemblies)' == ''">false</SignAssemblies>
    <SignTimestampUrl Condition="'$(SignTimestampUrl)' == ''">http://timestamp.digicert.com</SignTimestampUrl>
  </PropertyGroup>

  <!-- InformationalVersion carries the commit as a short (7-character) hash, 3.2.0+abc1234, not
       the SDK's full 40-character one. Runs once the SDK has read the commit from the repository
       and before it appends it to InformationalVersion. -->
  <Target Name="RstShortSourceRevision" BeforeTargets="AddSourceRevisionToInformationalVersion">
    <PropertyGroup Condition="$(SourceRevisionId.Length) &gt; 7">
      <SourceRevisionId>$(SourceRevisionId.Substring(0, 7))</SourceRevisionId>
    </PropertyGroup>
  </Target>

  <!-- Disable common Revit-side analyzers/warnings that conflict with the
       Revit API surface (e.g. CA1416 platform-compat, IDE0290 primary ctors). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);CA1416;IDE0290;IDE0028</NoWarn>
  </PropertyGroup>

</Project>
