<Project>

  <!--
    Centralised package versions. Keeps Revit-API package versions in
    lockstep with $(RevitVersion) selected by Configuration.

    Note: Nice3point.Revit.Api.* packages are versioned as <RevitMajor>.x.y.
    We use exact-major float so a `Debug R25` build resolves 2025.* etc.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Revit API references — version floats track $(RevitVersion). -->
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPI"   Version="$(RevitVersion).*" />
    <PackageVersion Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
    <PackageVersion Include="Nice3point.Revit.Api.AdWindows"  Version="$(RevitVersion).*" />
    <PackageVersion Include="Nice3point.Revit.Api.UIFramework" Version="$(RevitVersion).*" />

    <!-- net48 reference assemblies for cross-platform builds. -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />

    <!-- JSON / model. -->
    <PackageVersion Include="System.Text.Json" Version="8.0.4" />

    <!-- Logging. -->
    <PackageVersion Include="Serilog"               Version="4.0.1" />
    <PackageVersion Include="Serilog.Sinks.File"    Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />

    <!-- Diagnostics (RST-010 health panel). -->
    <PackageVersion Include="System.Management"     Version="8.0.0" />

    <!-- Test stack. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageVersion Include="xunit"                  Version="2.9.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="FluentAssertions"       Version="6.12.0" />
  </ItemGroup>

</Project>
