<Project>

  <!--
    Centralised package versions.

    Note: Revit API packages (Nice3point.Revit.Api.*) are NOT centrally
    managed here, because CPM (NU1011) forbids floating versions and we
    pick a different version per Revit major. They live inline in
    RST.Engine.csproj inside conditional ItemGroups keyed off
    $(RevitVersion).
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- net48 reference assemblies for cross-platform builds. -->
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" />

    <!-- Decision #33: no runtime packages. RST ships no third-party DLL into Revit's load
         context: logging is RST.Core.Logging, Health reads Win32 and the registry, and
         System.Text.Json is the shared framework's. The SerilogProbe test fixtures pin their
         own Serilog with VersionOverride. -->

    <!-- Installer UI — WixUI dialog set for the branded MSI setup. Tracks
         the WixToolset.Sdk version pinned in the installer .wixproj files. -->
    <PackageVersion Include="WixToolset.UI.wixext" Version="6.0.2" />

    <!-- RST.msi's tray (feature #17): util:CloseApplication and
         util:RemoveFolderEx. Same 6.0.2 line as the SDK. -->
    <PackageVersion Include="WixToolset.Util.wixext" Version="6.0.2" />

    <!-- Setup bundle — WixStandardBootstrapperApplication for RST-Setup.exe
         (installer-bundle/RST.Setup.wixproj). Same 6.0.2 line as the SDK. -->
    <PackageVersion Include="WixToolset.BootstrapperApplications.wixext" Version="6.0.2" />

    <!-- Test stack. -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk"     Version="17.10.0" />
    <PackageVersion Include="xunit"                      Version="2.9.0" />
    <PackageVersion Include="xunit.runner.visualstudio"  Version="2.8.2" />
    <PackageVersion Include="FluentAssertions"           Version="6.12.0" />
  </ItemGroup>

</Project>
