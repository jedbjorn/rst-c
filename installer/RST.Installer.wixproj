<Project Sdk="WixToolset.Sdk/6.0.2">

  <!--
    RST.Installer — produces RST.msi (Revit 2025, 2026 and 2027).

    Build: from this directory, `dotnet build` (or `wix build Product.wxs`
    directly). Output: bin/<Configuration>/RST.msi.

    The per-Revit-year components are generated from the staged trees
    ../build/R{25,26,27}/{addins,app}/ by gen-revit-years.ps1 (target
    RstGenerateRevitYears below), so `build/stage.sh R25|R26|R27` must be
    run first. Windows only, like every WiX build here.

    SDK is pinned to 6.x (RST-040: v4.0.5 lacked features this project
    used). v6.0.2 is the latest patch on the v6 line; bumping to v7 is a
    one-line change if/when needed.
  -->

  <!--
    MSI ProductVersion. Threaded from the release tag by the CI release
    workflow (-p:RstMsiVersion=1.3.0); falls back to the value below for local
    and push/PR builds. Keeping it a single property (not duplicated in the
    .wxs) means a release can't ship an MSI whose ProductVersion doesn't match
    the tag — the bug that silently broke in-place upgrades. Passed into the
    .wxs as the $(var.RstMsiVersion) preprocessor variable via DefineConstants.

    CI always passes -p:RstMsiVersion=<value> and that value is EMPTY on
    push/PR builds. A command-line property is a *global* MSBuild property, so
    it can't be reassigned by a PropertyGroup — `<RstMsiVersion Condition=…>`
    silently no-ops and the .wxs gets Version="" (WIX0006/WIX0010). Derive a
    *local* effective version instead (which the global can't shadow) and feed
    that to the preprocessor constant.

    The fallback must sort ABOVE the latest public release (v3.0.0) and below
    the next one (v3.1.0): a push/PR RST.msi then installs over a released
    RST.msi as an in-place MajorUpgrade (CI's msi-migrate job and the VM
    check depend on it), and the v3.1.0 release still upgrades a dev build.
    Move it after each release so it stays between the latest and the next.
  -->
  <PropertyGroup>
    <RstMsiVersionEffective>$(RstMsiVersion)</RstMsiVersionEffective>
    <RstMsiVersionEffective Condition="'$(RstMsiVersionEffective)' == ''">3.0.99</RstMsiVersionEffective>
    <DefineConstants>$(DefineConstants);RstMsiVersion=$(RstMsiVersionEffective)</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <OutputName>RST</OutputName>
    <OutputType>Package</OutputType>
    <!-- WiX v4+ emits MSI by default; keep the project explicit. -->
    <Configurations>Debug;Release</Configurations>
    <!-- x64 package (as gantt-it and splash-it): Revit 2025-2027 is 64-bit
         only, and the Revit detection in Product.wxs reads the 64-bit
         registry and ProgramFiles64Folder, which ICE80 rejects in a 32-bit
         package. -->
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- The MSI ICE validation suite was authored for the per-machine
         install model. Three of its rules fire spuriously on every
         per-user (Scope="perUser") harvest and the WiX team has
         acknowledged the gap (wixtoolset/issues#8633):
           ICE91 — "directory doesn't vary based on ALLUSERS"; that's
                   the *intent* of perUser scope.
           ICE38 — components in user profile "should" have an HKCU
                   KeyPath instead of a file KeyPath; the generated
                   one-file-per-component layout keeps the file KeyPath.
           ICE64 — per-user directories must be in the RemoveFile
                   table; for files laid down by the MSI itself, normal
                   uninstall removes them — the RemoveFile table is for
                   files the *app* creates at runtime, which we don't.
           ICE61 — warns that MajorUpgrade/@AllowSameVersionUpgrades also
                   replaces an install of the same ProductVersion. That is
                   deliberate (Product.wxs): an rc and its final share the
                   numeric a.b.c, and must not end up side by side. Same
                   suppression as gantt-it and splash-it.
         Combined with the repo-wide TreatWarningsAsErrors=true these
         block the build despite being non-issues for a perUser MSI. -->
    <SuppressIces>ICE38;ICE64;ICE91;ICE61</SuppressIces>
  </PropertyGroup>

  <!-- WixUI dialog set for the branded setup UI (WixUI_Minimal in
       Product.wxs). The SDK auto-registers referenced wixext packages as
       build extensions. Version is pinned centrally in
       Directory.Packages.props (this repo uses Central Package Management,
       so PackageReference must not carry a Version — NU1008). -->
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" />
  </ItemGroup>

  <!-- Per-Revit-year components (decision #10). <Files Include> cannot
       carry a Condition, so gen-revit-years.ps1 writes one conditional,
       Transitive component per staged file into obj\ (outside the default
       **\*.wxs glob) and it is compiled from there. Regenerated on every
       build so it always matches the staged trees. -->
  <PropertyGroup>
    <RstRevitYearsWxs>$(MSBuildProjectDirectory)\obj\RevitYears.g.wxs</RstRevitYearsWxs>
  </PropertyGroup>
  <Target Name="RstGenerateRevitYears" BeforeTargets="CoreCompile">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\gen-revit-years.ps1&quot; -BuildRoot &quot;$(MSBuildProjectDirectory)\..\build&quot; -Out &quot;$(RstRevitYearsWxs)&quot;" />
    <ItemGroup>
      <Compile Include="$(RstRevitYearsWxs)" />
    </ItemGroup>
  </Target>

</Project>
